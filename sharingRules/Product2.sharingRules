<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingGuestRules>
        <fullName>Guest_User_Sharing_for_Site</fullName>
        <accessLevel>Read</accessLevel>
        <description>Allows guest users to see shipping options at checkout.</description>
        <label>Guest User Sharing for Site</label>
        <sharedTo>
            <guestUser>D2C_Primary_Storefront</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>IsActive</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
</SharingRules>
