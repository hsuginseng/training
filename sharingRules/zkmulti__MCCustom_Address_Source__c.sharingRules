<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingGuestRules>
        <fullName>View_CAS</fullName>
        <accessLevel>Read</accessLevel>
        <label>View CAS</label>
        <sharedTo>
