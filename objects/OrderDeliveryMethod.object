    <fields>
        <fullName>Service_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(ClassOfService, &apos;UPS Ground&apos;), &apos;ups_ground&apos;, 
IF(ISPICKVAL(ClassOfService, &apos;ups_ground&apos;), &apos;ups_ground&apos;,
IF(ISPICKVAL(ClassOfService, &apos;UPS Standard®&apos;), &apos;ups_standard&apos;,
IF(ISPICKVAL(ClassOfService, &apos;ups_standard&apos;), &apos;ups_standard&apos;,
IF(ISPICKVAL(ClassOfService, &apos;UPS Second Day Air&apos;), &apos;ups_second_day_air&apos;, 
IF(ISPICKVAL(ClassOfService, &apos;ups_second_day_air&apos;), &apos;ups_second_day_air&apos;, null))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Service Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
