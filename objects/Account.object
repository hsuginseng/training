    <validationRules>
        <fullName>AVA_B2BLEX__Validate_AvaTax_Exemption_Customer_ID</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  NOT(ISNEW()),
  ISCHANGED(AVA_B2BLEX__AvaTaxExemptionCustomerId__c),
  NOT(ISBLANK(PRIORVALUE(AVA_B2BLEX__AvaTaxExemptionCustomerId__c))),
  PRIORVALUE(AVA_B2BLEX__AvaTaxExemptionCustomerId__c) &lt;&gt; CASESAFEID(Id)
)</errorConditionFormula>
        <errorDisplayField>AVA_B2BLEX__AvaTaxExemptionCustomerId__c</errorDisplayField>
        <errorMessage>Please do not edit this field value</errorMessage>
    </validationRules>
