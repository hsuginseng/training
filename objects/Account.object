    <fields>
        <fullName>AVA_B2BLEX__AvaTaxExemptionCustomerId__c</fullName>
        <deprecated>false</deprecated>
        <description>A unique code associated with the customer created in Avalara. As a best practice, do not edit the Avalara customer Code once it has been saved to Avalara a first time as this will create a new customer with the new code value</description>
        <externalId>false</externalId>
        <inlineHelpText>Use this field to pass unique value to Avatax for exemption. E.g- Account ID or update it as per the need using automation.</inlineHelpText>
        <label>B2B &amp; D2C Commerce Avalara Customer Code</label>
        <length>18</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
