    <sharingModel>Read</sharingModel>
    <validationRules>
        <fullName>celigo_sfnsio__Validate_Distributor</fullName>
        <active>true</active>
        <errorConditionFormula>AND((TEXT(celigo_sfnsio__Bill_To_Tier__c) == &apos;Distributor&apos;),  (celigo_sfnsio__Distributor__c == null))</errorConditionFormula>
        <errorDisplayField>celigo_sfnsio__Distributor__c</errorDisplayField>
        <errorMessage>Bill To Tier is selected as Distributor, please select a value for Distributor.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>celigo_sfnsio__Validate_Distributor_Ship</fullName>
        <active>true</active>
        <errorConditionFormula>AND((TEXT(celigo_sfnsio__Ship_To_Tier__c) == &apos;Distributor&apos;),  (celigo_sfnsio__Distributor__c == null))</errorConditionFormula>
        <errorDisplayField>celigo_sfnsio__Distributor__c</errorDisplayField>
        <errorMessage>Ship To Tier is selected as Distributor, please select a value for Distributor.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>celigo_sfnsio__Validate_End_Date</fullName>
        <active>true</active>
        <errorConditionFormula>celigo_sfnsio__Start_Date__c  &gt;  celigo_sfnsio__End_Date__c</errorConditionFormula>
        <errorDisplayField>celigo_sfnsio__End_Date__c</errorDisplayField>
        <errorMessage>End date should be greater than Start date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>celigo_sfnsio__Validate_Reseller</fullName>
        <active>true</active>
        <errorConditionFormula>AND((TEXT(celigo_sfnsio__Bill_To_Tier__c) == &apos;Reseller&apos;),  (celigo_sfnsio__Reseller__c == null))</errorConditionFormula>
        <errorDisplayField>celigo_sfnsio__Reseller__c</errorDisplayField>
        <errorMessage>Bill To Tier is selected as Reseller, please select a value for Reseller.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>celigo_sfnsio__Validate_Reseller_Ship</fullName>
        <active>true</active>
        <errorConditionFormula>AND((TEXT(celigo_sfnsio__Ship_To_Tier__c) == &apos;Reseller&apos;),  (celigo_sfnsio__Reseller__c == null))</errorConditionFormula>
        <errorDisplayField>celigo_sfnsio__Reseller__c</errorDisplayField>
        <errorMessage>Ship To Tier is selected as Reseller, please select a value for Reseller.</errorMessage>
    </validationRules>
</CustomObject>
