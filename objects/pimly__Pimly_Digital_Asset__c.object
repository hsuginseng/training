    <fields>
        <fullName>pimly__Admin_Name__c</fullName>
        <caseSensitive>false</caseSensitive>
        <deprecated>false</deprecated>
        <description>User Definable External Id reference used for Pimly.</description>
        <externalId>true</externalId>
        <inlineHelpText>User definable external Id reference used for Pimly. Auto generated if not set by user.</inlineHelpText>
        <label>Admin Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>pimly__Description__c</fullName>
        <deprecated>false</deprecated>
        <description>Simple description of the digital asset.</description>
        <externalId>false</externalId>
        <label>Description</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__Indexing_Status__c</fullName>
        <deprecated>false</deprecated>
        <description>Determines the indexing status for the digital asset.</description>
        <inlineHelpText>Pending, Completed, Failed</inlineHelpText>
        <label>Indexing Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>success</fullName>
                    <default>false</default>
                    <label>Success</label>
                </value>
                <value>
                    <fullName>parse error</fullName>
                    <default>false</default>
                    <label>Parse Error</label>
                </value>
                <value>
                    <fullName>pending</fullName>
                    <default>false</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>out of tokens</fullName>
                    <default>false</default>
                    <label>Out of Tokens</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>pimly__Indexing_Strategy__c</fullName>
        <deprecated>false</deprecated>
        <description>Determines the indexing strategy for the digital asset. Leave empty for default indexing.</description>
        <inlineHelpText>LLM - Basic: Fastest. Best for simple digital PDFs. (3 tokens/page)

LVM (Vision) - Basic: Best for simple scanned documents. (25 tokens/page)

LVM (Vision) - Advanced: Best for complex layouts, handwriting, low-quality scans. (60 tokens/page)

Agent - Basic: Fast and effective. A step above LLM - Basic. Best for semi-complex documents. (30 tokens/page)

Agent - Advanced: Best for documents requiring reasoning or multi-step analysis. Complex tables, diagrams. (90 tokens/page)</inlineHelpText>
        <label>Indexing Strategy</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>llmBasic</fullName>
                    <default>false</default>
                    <label>LLM - Basic</label>
                </value>
                <value>
                    <fullName>lvmBasic</fullName>
                    <default>false</default>
                    <label>LVM - Basic</label>
                </value>
                <value>
                    <fullName>lvmAdvanced</fullName>
                    <default>false</default>
                    <label>LVM - Advanced</label>
                </value>
                <value>
                    <fullName>agentBasic</fullName>
                    <default>false</default>
                    <label>Agent - Basic</label>
                </value>
                <value>
                    <fullName>agentAdvanced</fullName>
                    <default>false</default>
                    <label>Agent - Advanced</label>
                </value>
                <value>
                    <fullName>embedding</fullName>
                    <default>false</default>
                    <label>embedding</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
