    <fields>
        <fullName>Shipping_Weight_LBs__c</fullName>
        <externalId>false</externalId>
        <formula>(VALUE(TRIM(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(TEXT(Product2.Weight_Oz__c), &quot;oz&quot;, &quot;&quot;), &quot;OZ&quot;,&quot;&quot;), &quot;Oz&quot;,&quot;&quot;), &quot;Ounces&quot;, &quot;&quot;), &quot;ounces&quot;, &quot;&quot;), &quot;Ounce&quot;, &quot;&quot;), &quot;ounce&quot;, &quot;&quot;)))* QuantityExpected) / 16</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Shipping Weight LBs</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
