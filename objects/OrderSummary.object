    <fields>
        <fullName>Fresh_Ginseng_Product_Count__c</fullName>
        <description>This field counts all order product summaries that have fresh products. This field is used for reporting.</description>
        <label>Fresh Ginseng Product Count</label>
        <summaryFilterItems>
            <field>OrderItemSummary.Fresh_Ginseng_Product__c</field>
            <operation>equals</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>OrderItemSummary.OrderSummaryId</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Fulfilled_Product_Count__c</fullName>
        <description>This counts the number of fulfillment orders related to an order summary. This field is for reporting purposes.</description>
        <label>Fulfilled Product Count</label>
        <summaryFilterItems>
            <field>OrderItemSummary.Status</field>
            <operation>equals</operation>
            <value>FULFILLED</value>
        </summaryFilterItems>
        <summaryFilterItems>
            <field>OrderItemSummary.Type</field>
            <operation>equals</operation>
            <value>Order Product</value>
        </summaryFilterItems>
        <summaryForeignKey>OrderItemSummary.OrderSummaryId</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <type>Summary</type>
    </fields>
