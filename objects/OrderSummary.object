    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Prevent_Status_Change_When_Payment_Error</fullName>
        <active>true</active>
        <description>If there is an issue with a payment, the order summary is flagged as such under the Payment Error boolean field. If this field is true/checked, the status changes will be prevented.</description>
        <errorConditionFormula>AND(TEXT(PRIORVALUE(Status)) = &apos;Hold&apos;, ISCHANGED(Status), Payment_Error__c, TEXT($User.UserType) &lt;&gt; &apos;AutomatedProcess&apos;)</errorConditionFormula>
        <errorMessage>An active payment error is recorded on this order summary. Please resolve this error to advance the order summary from a &quot;Hold&quot; status.</errorMessage>
    </validationRules>
</CustomObject>
