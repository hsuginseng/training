    <fields>
        <fullName>Location__c</fullName>
        <description>This formula will return the shipping origin location, which is used by the Netsuite integration to identify the correct warehouse.</description>
        <externalId>false</externalId>
        <formula>IF(CASESAFEID(SalesStoreId) =  CASESAFEID($Label.D2C_StoreID) , &apos;Corporate Office Headquarters : Wausau Warehouse&apos;,
IF(LOWER(Sales_Representative__r.City) = &apos;richmond&apos;, &apos;Vancouver&apos;,
IF(LOWER(Sales_Representative__r.City) = &apos;toronto&apos;, &apos;Toronto&apos;,
IF(LOWER(Sales_Representative__r.City) = &apos;hayward&apos;, &apos;San Francisco Branch&apos;,
IF(LOWER(Sales_Representative__r.City) = &apos;brooklyn&apos;, &apos;New York Branch&apos;,
IF(LOWER(Sales_Representative__r.City) = &apos;el monte&apos;, &apos;Los Angeles Branch&apos;,
IF(LOWER(Sales_Representative__r.City) = &apos;houston&apos;, &apos;Houston&apos;,
IF(LOWER(Sales_Representative__r.City) = &apos;marathon&apos;, &apos;3G Green Gold Ginseng&apos;,
IF(LOWER(Sales_Representative__r.City) = &apos;wausau&apos;, &apos;Corporate Office Headquarters : Wausau Warehouse&apos;,
&apos;&apos;)))))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Location</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Netsuite_Id__c</fullName>
