        <fullName>B2B_OOBO_Approval_Needed__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Triggers B2B Discount Approval Process</description>
        <inlineHelpText>Triggers B2B Discount Approval Process</inlineHelpText>
        <label>B2B OOBO Approval Needed</label>
        <trackFeedHistory>true</trackFeedHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Balance_Due__c</fullName>
        <description>OLD FORMULA: 

IF(Total_Amount_from_Order_Payment_Summary__c = 0, 
(TotalAmount + TotalTaxAmount) - (Total_Amount_Authorized_from_OPS__c + Total_of_Payment_Entries__c),  
(TotalAmount + TotalTaxAmount) - (Total_Amount_from_Order_Payment_Summary__c + Total_of_Payment_Entries__c))</description>
        <formula>IF(Total_Amount_from_Order_Payment_Summary__c = 0, 
(TotalAmount + TotalTaxAmount) - (Total_Amount_Authorized_from_OPS__c),  
(TotalAmount + TotalTaxAmount) - (Total_Amount_from_Order_Payment_Summary__c) + (Total_Amount_Refunded_from_OPS__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Balance Due</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
