    <fields>
        <fullName>Total_Amount_Authorized_from_OPS__c</fullName>
        <description>This field will help drive the balance due field. If there are no captured payments for this order summary record, this will represent a paid order for B2B credit cards or any D2C order. This is used for the Salesforce to NetSuite integration.</description>
        <label>Total Amount Authorized from OPS</label>
        <summarizedField>OrderPaymentSummary.AuthorizationAmount</summarizedField>
        <summaryForeignKey>OrderPaymentSummary.OrderSummaryId</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Total_Amount_Refunded_from_OPS__c</fullName>
        <description>This drives the balance due field. This sums all the returned funds from order payment summaries related to one order summary.</description>
        <label>Total Amount Refunded from OPS</label>
        <summarizedField>OrderPaymentSummary.RefundedAmount</summarizedField>
        <summaryForeignKey>OrderPaymentSummary.OrderSummaryId</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Total_Amount_from_Order_Payment_Summary__c</fullName>
        <description>The total amount captured from the order payment summary.</description>
