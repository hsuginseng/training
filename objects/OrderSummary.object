    <fields>
        <fullName>Account_Name_Formula__c</fullName>
        <externalId>false</externalId>
        <formula>IF (ISBLANK(Account.Name), Account.FirstName&amp;&quot; &quot;&amp;Account.LastName, Account.Name)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Name Formula</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
