    <fields>
        <fullName>pimly__Readiness_Score__c</fullName>
        <deprecated>false</deprecated>
        <formula>IF(
    (pimly__Required_Fields_Total__c + pimly__Validations_Total__c + pimly__Enumerated_Fields_Total__c + pimly__Rel_Attr_Fields_Total__c) = 0,
    1,
    ((pimly__Required_Fields_Total__c + pimly__Validations_Total__c + pimly__Enumerated_Fields_Total__c + pimly__Rel_Attr_Fields_Total__c) - (pimly__Required_Fields_Missing__c + pimly__Validations_Failed__c + pimly__Enumerated_Fields_Invalid__c + pimly__Rel_Attr_Fields_Failing__c)) / 
    (pimly__Required_Fields_Total__c + pimly__Validations_Total__c + pimly__Enumerated_Fields_Total__c + pimly__Rel_Attr_Fields_Total__c)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Readiness Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
