        <fullName>pimly__Product_Migration_Allowed__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If true the user will have permission to use the product migration utilities in the Data Management app.</description>
        <label>Product Migration Allowed?</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>pimly__User_Id__c</fullName>
        <deprecated>false</deprecated>
        <description>Id of the User for these settings</description>
        <externalId>false</externalId>
        <inlineHelpText>Internal Salesforce Users can toggle between channels and locales they have access to. Experience Sites are fixed to a single channel and locale so external users are viewing data in the same context.</inlineHelpText>
        <label>User or Experience Site Id</label>
        <length>18</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__Users_Current_PDP_Context__c</fullName>
        <deprecated>false</deprecated>
        <description>For use on the PDP page. This tracks the users current pinned locale or channel context</description>
        <externalId>false</externalId>
        <label>Users Current PDP Context</label>
        <length>32</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__Users_Current_Pimly_Channel__c</fullName>
