        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__Pinned_Linked_Item_List_View__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Pinned Linked Item List View</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>The List View you are trying to pin is of the wrong type. Ensure it is a Linked Item List View.</errorMessage>
            <filterItems>
                <field>pimly__List_View__c.pimly__List_View_Object__c</field>
                <operation>equals</operation>
                <value>Linked Item</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>pimly__List_View__c</referenceTo>
        <relationshipLabel>Pimly User Settings (Pinned Linked Item List View)</relationshipLabel>
        <relationshipName>Pimly_User_Settings1</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
