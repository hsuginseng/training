    <fields>
        <fullName>pimly__For_Experience_Site__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Is this setting profile for an experience site?</description>
        <inlineHelpText>Is this setting record for an experience site? Experience sites are tied to a single channel and locale.</inlineHelpText>
        <label>For Experience Site?</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>pimly__OryAI_Tokens_Used__c</fullName>
        <defaultValue>0</defaultValue>
        <deprecated>false</deprecated>
