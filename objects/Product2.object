    <fields>
        <fullName>pimly__Product_Line_Id__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(
ISBLANK(pimly__Product_Parent__c),
pimly__Pimly_Id__c,
IF(
ISBLANK(pimly__Product_Parent__r.pimly__Product_Parent__c),
pimly__Product_Parent__r.pimly__Pimly_Id__c,
IF(
ISBLANK(pimly__Product_Parent__r.pimly__Product_Parent__r.pimly__Product_Parent__c),
pimly__Product_Parent__r.pimly__Product_Parent__r.pimly__Pimly_Id__c,
IF(
ISBLANK(pimly__Product_Parent__r.pimly__Product_Parent__r.pimly__Product_Parent__r.pimly__Product_Parent__c),
pimly__Product_Parent__r.pimly__Product_Parent__r.pimly__Product_Parent__r.pimly__Pimly_Id__c,
pimly__Product_Parent__r.pimly__Product_Parent__r.pimly__Product_Parent__r.pimly__Product_Parent__r.pimly__Pimly_Id__c
)
)
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Product Line Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
