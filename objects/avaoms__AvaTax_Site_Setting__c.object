    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Store Site Setting</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>avaoms__Address_Validation__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Enable Disable Address Validation</description>
        <label>Address Validation</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>avaoms__City__c</fullName>
        <deprecated>false</deprecated>
        <description>Enter the city for the origin address.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the city for the origin address.</inlineHelpText>
        <label>City</label>
        <length>50</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>avaoms__Company_Code__c</fullName>
        <deprecated>false</deprecated>
        <description>AvaTax company code configured on the admin console of the AvaTax account.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select which AvaTax company code should be used for this channel</inlineHelpText>
        <label>Company Code</label>
        <length>50</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>avaoms__ConfigId__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>Enter config id</inlineHelpText>
        <label>ConfigId</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>avaoms__Country__c</fullName>
        <deprecated>false</deprecated>
        <description>Select country for the origin address. Select 2 or 3 character ISO country code.</description>
        <externalId>false</externalId>
        <inlineHelpText>Select country for the origin address. Select 2 or 3 character ISO country code.</inlineHelpText>
        <label>Country</label>
        <length>50</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>avaoms__Customer_Code__c</fullName>
        <deprecated>false</deprecated>
        <description>Select what is sent as the customer code for authenticated customers. For guest customers, Email ID entered during checkout is used.</description>
        <inlineHelpText>Select what is sent as the customer code for authenticated customers. For guest customers, Email ID entered during checkout is used.</inlineHelpText>
        <label>Customer Code</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Customer Email</fullName>
                    <default>false</default>
                    <label>Customer Email</label>
                </value>
                <value>
                    <fullName>Customer ID</fullName>
                    <default>true</default>
                    <label>Customer ID</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>avaoms__Default_Shipping_Method_Tax_Code__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>If the delivery group (shipping method) line item doesn&apos;t have a tax class, this value takes effect for tax calculation.</inlineHelpText>
        <label>Default Shipping Method Tax Code</label>
        <length>25</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>avaoms__Enable_AvaTax_Logging__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If selected, application logs will be stored in the Salesforce AvaTax Log Custom Object.</description>
        <inlineHelpText>If selected, application logs will be stored in the Salesforce AvaTax Log Custom Object.</inlineHelpText>
        <label>Enable AvaTax Logging</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>avaoms__Line_1__c</fullName>
        <deprecated>false</deprecated>
        <description>Enter up to 3 Street Address lines for the Origin Address to be used in the Avalara AvaTax Tax Calculation.</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter up to 3 Street Address lines for the Origin Address to be used in the Avalara AvaTax Tax Calculation.</inlineHelpText>
        <label>Line 1</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>avaoms__Line_2__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>Enter line 2 Street Address for the Origin Address.</inlineHelpText>
        <label>Line 2</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>avaoms__Line_3__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>Enter line 3 Street Address for the Origin Address.</inlineHelpText>
        <label>Line 3</label>
        <length>100</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>avaoms__Postal_Code__c</fullName>
        <deprecated>false</deprecated>
        <description>Enter the postal or zip code for the origin address. For US Zip Codes can be Zip5 or Zip9 (Zip + 4).</description>
        <externalId>false</externalId>
        <inlineHelpText>Enter the postal or zip code for the origin address. For US Zip Codes can be Zip5 or Zip9 (Zip + 4).</inlineHelpText>
        <label>Postal Code</label>
        <length>20</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>avaoms__SalesChannelId__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Sales Channel Id</label>
        <length>18</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>avaoms__Sales_Channel__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Sales Channel</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>avaoms__State__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>Enter the state or province for the origin address.</inlineHelpText>
        <label>State</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>avaoms__Tax_Calculation__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>If enabled, AvaTax features including tax calculation, cancellation, returns will work.</description>
        <inlineHelpText>If enabled, AvaTax features including tax calculation, cancellation, returns will work.</inlineHelpText>
        <label>Tax Calculation</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>avaoms__Tax_Inclusive__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If enabled, then AvaTax records the total amount of the transaction including the tax amount.</description>
        <inlineHelpText>Enable this setting if the product prices are including taxes (Gross).</inlineHelpText>
        <label>Tax Inclusive</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
