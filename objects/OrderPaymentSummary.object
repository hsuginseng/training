    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableFeeds>true</enableFeeds>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>AuthorizationAmount</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <fields>
        <fullName>AuthorizationReversalAmount</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <fields>
        <fullName>AvailableToCaptureAmount</fullName>
    </fields>
    <fields>
        <fullName>AvailableToRefundAmount</fullName>
    </fields>
    <fields>
        <fullName>BalanceAmount</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <fields>
        <fullName>CapturedAmount</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <fields>
        <fullName>FullName</fullName>
        <trackFeedHistory>false</trackFeedHistory>
    </fields>
    <fields>
        <fullName>Is_Cash_Entry_Payment__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This flags an order payment summary as being a cash entry payment. This is used for the Celigo integration.</description>
        <label>Is Cash Entry Payment</label>
        <trackFeedHistory>true</trackFeedHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Is_Fully_Captured__c</fullName>
        <description>This field is used for reporting only. If the authorization amount doesn&apos;t match the captured amount, this field will be false. If the authorization and captured amounts match, this field will be true.</description>
        <formula>AuthorizationAmount = CapturedAmount</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Fully Captured</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>LastPaymentGatewayLogId</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>LastPaymentGatewayMessage</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <fields>
        <fullName>Method</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <fields>
        <fullName>OrderSummaryId</fullName>
        <trackFeedHistory>false</trackFeedHistory>
        <type>MasterDetail</type>
    </fields>
    <fields>
        <fullName>PaymentCreditedAmount</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <fields>
        <fullName>PaymentMethodId</fullName>
        <trackFeedHistory>true</trackFeedHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PendingAuthorizationAmount</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <fields>
        <fullName>PendingCaptureAmount</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <fields>
        <fullName>PendingRefundAmount</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <fields>
        <fullName>PendingReverseAuthAmount</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <fields>
        <fullName>Pushed_To_Netsuite__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Pushed To Netsuite</label>
        <trackFeedHistory>true</trackFeedHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>RefundedAmount</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <fields>
        <fullName>ReservedBalanceTotalAmount</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <fields>
        <fullName>Type</fullName>
        <trackFeedHistory>true</trackFeedHistory>
    </fields>
    <listViews>
        <fullName>all_order_payment_summaries</fullName>
        <columns>Name</columns>
        <columns>FullName</columns>
        <columns>OrderSummary</columns>
        <columns>BalanceAmount</columns>
        <columns>AuthorizationAmount</columns>
        <columns>CapturedAmount</columns>
        <columns>RefundedAmount</columns>
        <columns>CreatedDate</columns>
        <filterScope>Everything</filterScope>
        <label>All Order Payment Summaries</label>
    </listViews>
