    <validationRules>
        <fullName>celigo_sfnsio__Validate_End_Date</fullName>
        <active>true</active>
        <errorConditionFormula>Opportunity.celigo_sfnsio__End_Date__c &lt;  celigo_sfnsio__End_Date__c</errorConditionFormula>
        <errorDisplayField>celigo_sfnsio__End_Date__c</errorDisplayField>
        <errorMessage>End date on line item should not be greater than end date on opportunity.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>celigo_sfnsio__Validate_Start_Date</fullName>
        <active>true</active>
        <errorConditionFormula>Opportunity.celigo_sfnsio__Start_Date__c &gt; celigo_sfnsio__Start_Date__c</errorConditionFormula>
