    </validationRules>
    <validationRules>
        <fullName>celigo_sfnsio__Validate_Start_End_Date</fullName>
        <active>true</active>
        <errorConditionFormula>celigo_sfnsio__Start_Date__c &gt;  celigo_sfnsio__End_Date__c</errorConditionFormula>
