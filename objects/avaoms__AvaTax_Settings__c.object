    <fields>
        <fullName>avaoms__Account_Number__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>Enter your Avalara AvaTax Account Number.</inlineHelpText>
        <label>Account Number</label>
        <length>10</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>avaoms__Environment__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>If selected, then Sandbox / Production service will be used for Avatax Services.</inlineHelpText>
        <label>Environment</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Sandbox</fullName>
                    <default>true</default>
                    <label>Sandbox</label>
                </value>
                <value>
                    <fullName>Production</fullName>
                    <default>false</default>
                    <label>Production</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>avaoms__License_Key__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>Enter your Avalara AvaTax License Key.</inlineHelpText>
        <label>License Key</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>AvaTax Settings</label>
    <nameField>
        <label>AvaTax Settings Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>AvaTax Settings</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
