    <fields>
        <fullName>pimly__License_Type__c</fullName>
        <deprecated>false</deprecated>
        <label>License Type</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>data_manager</fullName>
                    <default>true</default>
                    <label>Data Manager</label>
                </value>
                <value>
                    <fullName>crm_user</fullName>
                    <default>false</default>
                    <label>CRM User</label>
                </value>
                <value>
                    <fullName>public_external_user</fullName>
                    <default>false</default>
                    <label>Public External User</label>
                </value>
                <value>
                    <fullName>data_manager_external</fullName>
                    <default>false</default>
                    <label>Data Manager External</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>pimly__Licensed_User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The User that is provided access to this license record</description>
        <label>Licensed User</label>
        <referenceTo>User</referenceTo>
        <relationshipName>User_Licenses</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>User License</label>
    <nameField>
        <displayFormat>UL-{0000000000}</displayFormat>
        <label>User License</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>User Licenses</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <startsWith>Vowel</startsWith>
    <visibility>Public</visibility>
