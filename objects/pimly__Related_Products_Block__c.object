    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Records of this custom object define how Pimly related product blocks render.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>pimly__Admin_Name__c</fullName>
        <caseSensitive>false</caseSensitive>
        <deprecated>false</deprecated>
        <externalId>true</externalId>
        <inlineHelpText>User definable external Id reference used for Pimly. Auto generated if not set by user.</inlineHelpText>
        <label>Admin Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>pimly__Block_Title__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>This is the title of the block when it renders in the UI</inlineHelpText>
        <label>Block Title</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__Block_Type__c</fullName>
        <deprecated>false</deprecated>
        <label>Block Type</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Gallery</fullName>
                    <default>true</default>
                    <label>Gallery</label>
                </value>
                <value>
                    <fullName>Interactive List</fullName>
                    <default>false</default>
                    <label>Interactive List</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>pimly__Pimly_Id__c</fullName>
        <caseSensitive>true</caseSensitive>
        <deprecated>false</deprecated>
        <externalId>true</externalId>
        <label>Pimly Id</label>
        <length>50</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>pimly__Show_Quantity_Input__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>For the interactive related list, show the quantity input field</inlineHelpText>
        <label>Show Quantity Input?</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>pimly__Show_Selection_Checkboxes__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <label>Show Selection Checkboxes?</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Related Products Block</label>
    <listViews>
        <fullName>pimly__All</fullName>
        <columns>NAME</columns>
        <columns>pimly__Block_Type__c</columns>
        <columns>pimly__Show_Quantity_Input__c</columns>
        <columns>pimly__Show_Selection_Checkboxes__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>LAST_UPDATE</columns>
        <columns>UPDATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>RPB-{00000}</displayFormat>
        <label>Related Products Block Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Related Products Blocks</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
