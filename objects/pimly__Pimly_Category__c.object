    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>This object represents a category. Products can be linked to categories via Pimly Product Category junction objects</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>pimly__Admin_Name__c</fullName>
        <caseSensitive>false</caseSensitive>
        <deprecated>false</deprecated>
        <externalId>true</externalId>
        <inlineHelpText>User definable external Id reference used for Pimly. Auto generated if not set by user.</inlineHelpText>
        <label>Admin Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>pimly__Catalog_Id__c</fullName>
        <deprecated>false</deprecated>
        <description>Salesforce Id of the top most category in the tree (the catalog)</description>
        <externalId>false</externalId>
        <label>Catalog Id</label>
        <length>50</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__Enforce_Strict_Product_Placement__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>When enabled, products can only be associated to the last category within a branch of the catalog. This can not be changed once set.</inlineHelpText>
        <label>Enforce Strict Product Placement</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>pimly__Full_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>Longer name that allows matching the name length for ProductCategory record (useful when &quot;linking&quot; a Pimly Category to a commerce ProductCategory via Pimly Flash).</description>
        <externalId>false</externalId>
        <label>Full Name</label>
        <length>200</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__Is_Parent_Assignable__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>When enabled, Parent products can be assigned to categories within this catalog.</description>
        <inlineHelpText>When enabled, Parent products can be assigned to categories in this catalog. If a Parent is assigned, its child products cannot be individually assigned in the same catalog.</inlineHelpText>
        <label>Is Parent Assignable</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>pimly__Parent_Pimly_Category__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Parent Pimly Category</label>
        <referenceTo>pimly__Pimly_Category__c</referenceTo>
        <relationshipLabel>Pimly Categories</relationshipLabel>
        <relationshipName>Pimly_Categories</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>pimly__Pimly_Id__c</fullName>
        <caseSensitive>false</caseSensitive>
        <deprecated>false</deprecated>
        <externalId>true</externalId>
        <inlineHelpText>The unique identifier used for Pimly. This is system generated and is not modifiable.</inlineHelpText>
        <label>Pimly Id</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <label>Pimly Category</label>
    <nameField>
        <label>Pimly Category Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Pimly Categories</pluralLabel>
