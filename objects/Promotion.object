    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableDataTranslation>true</enableDataTranslation>
    <enableFeeds>false</enableFeeds>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>AreQualItemsExclFromDiscounts</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>CampaignId</fullName>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CumulativeUsageTarget</fullName>
        <inlineHelpText>Enter the number of times a member must participate or the amount of money spent to qualify for a reward.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>CurrencyIsoCode</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>CurrentLiabilityAmount</fullName>
        <inlineHelpText>The total liability incurred by the loyalty program for the promotion.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>CurrentPointCount</fullName>
        <inlineHelpText>Specify the number of points credited to members for the promotion until now.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>DefaultVoucherDefinitionId</fullName>
        <inlineHelpText>Select the default voucher definition. This field is required when Fulfillment Action is set to Issue Voucher.</inlineHelpText>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Description</fullName>
        <trackHistory>false</trackHistory>
        <translateData>true</translateData>
    </fields>
    <fields>
        <fullName>DiscountOrder</fullName>
        <inlineHelpText>Select whether to apply discounts to the most expensive or least expensive products first.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>DiscountRestriction</fullName>
        <inlineHelpText>Restrict which products can be discounted.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>DisplayName</fullName>
        <trackHistory>false</trackHistory>
        <translateData>true</translateData>
    </fields>
    <fields>
        <fullName>EndDate</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>EndDateTime</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>EnrollmentEndDate</fullName>
        <inlineHelpText>Enter the last date when members can enroll in the promotion. This field is optional and is used only if you select Enrollment Required.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>EnrollmentStartDate</fullName>
        <inlineHelpText>Enter the date when members can start enrolling in the promotion. This field is required if you select Enrollment Required.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>ExclusivityType</fullName>
        <inlineHelpText>To combine the promotion with other promotions, select No. To prevent combining the promotion with promotions of the same class, select Class. To let it be the only promotion used for an entire order, select Global.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>FulfillmentAction</fullName>
        <inlineHelpText>Select the way in which a loyalty member is rewarded for fulfilling promotion requirements. If you select a fulfillment action, select a value for Loyalty Program.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>GameDefinitionId</fullName>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ImageUrl</fullName>
        <inlineHelpText>Enter the image URL or select and upload the image. The image file format can be JPG, PNG, or BMP that’s less than 5 MB and 128x128 pixels in resolution.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>IsActive</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>IsApproachingDiscountApplicable</fullName>
        <inlineHelpText>Notifies customers if their cart total is approaching a discount. To add an approaching discount alert, set a threshold value on the promotion qualifier.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>IsAutomatic</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>IsCloned</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>IsCommercePromotion</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>IsEnrollmentRequired</fullName>
        <inlineHelpText>Require members to enroll to participate in the promotion. If you select this option, enter the Enrollment Start Date.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>IsPointsWithFactor</fullName>
        <inlineHelpText>Select the checkbox to calculate the points to be credited by multiplying the transaction amount with a multiplier. For example, to credit points worth twice the transaction amount, select the checkbox and enter 2 in the Points Factor field.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>IsQualCriteriaNotRequiredPerApplication</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>IsQuickPromotion</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>IsTiered</fullName>
        <inlineHelpText>This setting is permanent and can&apos;t be changed after the promotion is saved. Create a new promotion instead.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>IssuedVoucherCount</fullName>
        <inlineHelpText>Specify the number of vouchers that have been issued for the promotion until now.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>LoyaltyProgramCurrencyId</fullName>
        <inlineHelpText>Select the loyalty program currency. This field is required when Fulfillment Action is set to Credit Points.</inlineHelpText>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>LoyaltyProgramId</fullName>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>LoyaltyPromotionType</fullName>
        <inlineHelpText>Select Standard if the promotion rewards members immediately after they perform an activity. Select Cumulative if the promotion rewards members after they achieve a defined target value. Select Joint if the promotion is run in collaboration with one or more partners.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>MaximumLiabilityAmount</fullName>
        <inlineHelpText>Enter the maximum liability that the loyalty program can incur for this promotion.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>MaximumUsageCount</fullName>
        <inlineHelpText>Enter the maximum number of times this promotion can apply to a cart. The default value is 1.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>MaximumVoucherCount</fullName>
        <inlineHelpText>Enter the maximum number of vouchers that can be issued by the promotion.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Name</fullName>
        <trackHistory>false</trackHistory>
        <translateData>true</translateData>
    </fields>
    <fields>
        <fullName>Objective</fullName>
        <trackHistory>false</trackHistory>
        <translateData>true</translateData>
    </fields>
    <fields>
        <fullName>OwnerId</fullName>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PersonalizationType</fullName>
        <inlineHelpText>Select the personalization engine for the promotion. Choose Individual Personalization to source per-member target values from Salesforce, or Bring Your Own Model to receive targets from an external system.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>PointFactor</fullName>
        <inlineHelpText>Enter the multiplier that’s used to multiply the transaction amount and determine the number of points to be credited for the promotion. For example, to credit points worth twice the transaction amount, enter 2.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>PriorityNumber</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>PromotionCode</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>PromotionConfiguration</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>PromotionPageUrl</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>QualifierCriteria</fullName>
        <inlineHelpText>Define whether a cart must meet the criteria for any qualifier or all qualifiers</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>RelatedPromotionId</fullName>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>StartDate</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>StartDateTime</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>Status</fullName>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>TargetCriteria</fullName>
        <inlineHelpText>Define whether a cart must meet the criteria for any target or all targets.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>TermsAndConditions</fullName>
        <trackHistory>false</trackHistory>
        <translateData>true</translateData>
    </fields>
    <fields>
        <fullName>TotalRewardPoints</fullName>
        <inlineHelpText>Enter the total reward points. This field is required when Fulfillment Action is set to Credit Points.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <fields>
        <fullName>TransactionJournalType</fullName>
        <inlineHelpText>Select the type of transactions for which the promotion is applicable.</inlineHelpText>
        <trackHistory>false</trackHistory>
    </fields>
    <listViews>
        <fullName>All_Promotions</fullName>
        <columns>Name</columns>
        <columns>Campaign</columns>
        <columns>StartDate</columns>
        <columns>EndDate</columns>
        <columns>CreatedBy</columns>
        <columns>LoyaltyPromotionType</columns>
        <columns>FulfillmentAction</columns>
        <filterScope>Everything</filterScope>
        <label>All Promotions</label>
    </listViews>
