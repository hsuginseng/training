    <validationRules>
        <fullName>Validate_Tour_Scheduled_DateTime</fullName>
        <active>true</active>
        <errorConditionFormula>RecordType.DeveloperName = &apos;Tours&apos; &amp;&amp;
!ISNULL( Scheduled_Tour_Date_Time__c ) &amp;&amp;
!(MONTH(DATEVALUE( Scheduled_Tour_Date_Time__c )) &gt; 4 &amp;&amp; MONTH(DATEVALUE( Scheduled_Tour_Date_Time__c )) &lt; 10 &amp;&amp;
WEEKDAY(DATEVALUE( Scheduled_Tour_Date_Time__c )) != 1 &amp;&amp; 
WEEKDAY(DATEVALUE( Scheduled_Tour_Date_Time__c )) != 7 &amp;&amp; 
(
HOUR(TIMEVALUE( Scheduled_Tour_Date_Time__c )) &gt; 14
||
(HOUR(TIMEVALUE( Scheduled_Tour_Date_Time__c )) = 14 &amp;&amp; MINUTE(TIMEVALUE( Scheduled_Tour_Date_Time__c )) &gt; 29)
)
&amp;&amp;
(
HOUR(TIMEVALUE( Scheduled_Tour_Date_Time__c )) &lt; 20
||
(HOUR(TIMEVALUE( Scheduled_Tour_Date_Time__c )) = 20 &amp;&amp; MINUTE(TIMEVALUE( Scheduled_Tour_Date_Time__c )) = 0)
)
)</errorConditionFormula>
        <errorDisplayField>Scheduled_Tour_Date_Time__c</errorDisplayField>
        <errorMessage>Please select a weekday (Monday - Friday) between May - September and a time between 9:30am - 3:00pm Central Time.</errorMessage>
    </validationRules>
</CustomObject>
