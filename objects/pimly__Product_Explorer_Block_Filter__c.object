    <fields>
        <fullName>pimly__Available_Values__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>The available values separated by new lines. If left empty, all values set on the pimly property will be shown.</inlineHelpText>
        <label>Available Values</label>
        <length>50000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>pimly__Default_Number_of_Rows__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>The default number of rows to show within the filter. If the number of filter options is greater than this number, the user will have to click show more.</inlineHelpText>
        <label>Default Number of Rows</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__Expanded_by_Default__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>When the catalog loads, any filters with this field set to true will be expanded automatically.</inlineHelpText>
        <label>Expanded by Default</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>pimly__Filter_Type__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>The type of filter controls how the filter is used in the catalog UI</inlineHelpText>
        <label>Filter Type</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Multi-Select Checkboxes</fullName>
                    <default>true</default>
                    <label>Multi-Select Checkboxes</label>
                </value>
                <value>
                    <fullName>Single-Select Radio Buttons</fullName>
                    <default>false</default>
                    <label>Single-Select Radio Buttons</label>
                </value>
                <value>
                    <fullName>Number In Between Slider</fullName>
                    <default>false</default>
                    <label>Number In Between Slider</label>
                </value>
                <value>
                    <fullName>Free Text</fullName>
                    <default>false</default>
                    <label>Free Text</label>
                </value>
                <value>
                    <fullName>Color Swatches</fullName>
                    <default>false</default>
                    <label>Color Swatches</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
