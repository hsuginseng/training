    <fields>
        <fullName>Shipping_Category__c</fullName>
        <externalId>false</externalId>
        <formula>IF(Product2.Name=&apos;Shipping Charge for this delivery method&apos;,-1,
IF(TEXT(Product2.Shipping_Category__c)=&apos;Fresh&apos;,1,
IF(TEXT(Product2.Shipping_Category__c)=&apos;Standard&apos;,0, NULL)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Shipping Category</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Shipping_Weight_LBs__c</fullName>
        <externalId>false</externalId>
        <formula>IF(AND(Product2.Shipping_Weight_Oz_Populated__c, Product2.Shipping_Weight_Oz__c &gt; 0), (Product2.Shipping_Weight_Oz__c * Quantity) / 16, Quantity)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Shipping Weight LBs</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
