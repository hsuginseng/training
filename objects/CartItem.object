    <fields>
        <fullName>AVA_B2BLEX__AvaTaxLineItemUUID__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>AvaTax Line Item UUID</label>
        <length>36</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
