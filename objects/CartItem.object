    </fields>
    <fields>
        <fullName>Applied_Loyalty_Discount_Amount__c</fullName>
        <description>Rolls up all loyalty Cart Item Price Adjustments and makes them visible at a cart item level.</description>
        <label>Applied Loyalty Discount Amount</label>
        <summarizedField>CartItemPriceAdjustment.AdjustmentValue</summarizedField>
        <summaryFilterItems>
            <field>CartItemPriceAdjustment.Name</field>
            <operation>equals</operation>
            <value>SystemGeneratedLoyaltyDiscount</value>
        </summaryFilterItems>
        <summaryForeignKey>CartItemPriceAdjustment.CartItemId</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>BillingFrequency</fullName>
    </fields>
    <fields>
        <fullName>CartDeliveryGroupId</fullName>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CartId</fullName>
        <type>MasterDetail</type>
    </fields>
    <fields>
        <fullName>Cart_Item_Discount_Percentage_Formula__c</fullName>
        <formula>(SalesPrice - Cart_Unit_Discounted_Price_Formula__c) / SalesPrice</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Cart Item Discount Percentage after OOBO line item discounts are applied; Gets copied to Cart_Item_Discount_Percentage</inlineHelpText>
        <label>Cart Item Discount Percentage Formula</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Cart_Item_Discount_Percentage__c</fullName>
        <inlineHelpText>Cart Item Discount Percentage after OOBO line item discounts are applied</inlineHelpText>
        <label>Cart Item Discount (%)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Cart_Unit_Discount_Amount__c</fullName>
        <inlineHelpText>Unit Discount Dollar Amount entered by Sales Rep on OOBO</inlineHelpText>
        <label>Cart Unit Discount ($)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Cart_Unit_Discount_Percentage__c</fullName>
        <inlineHelpText>Unit Discount Percentage entered by Sales Rep on OOBO</inlineHelpText>
        <label>Cart Unit Discount (%)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Cart_Unit_Discounted_Price_Formula__c</fullName>
        <formula>IF( Cart_Unit_Discount_Percentage__c&gt;0 , SalesPrice*(1-Cart_Unit_Discount_Percentage__c), IF( Cart_Unit_Discount_Amount__c&gt;0, SalesPrice - Cart_Unit_Discount_Amount__c, SalesPrice))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Cart Unit Price after OOBO line item discounts are applied; Gets copied to Cart_Unit_Discounted_Price</inlineHelpText>
        <label>Cart Unit Discounted Price Formula</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Cart_Unit_Discounted_Price__c</fullName>
        <inlineHelpText>Cart Unit Price after OOBO line item discounts are applied</inlineHelpText>
        <label>Cart Unit Discounted Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Currency</type>
    </fields>
