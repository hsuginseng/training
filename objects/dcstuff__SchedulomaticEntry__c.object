    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>dcstuff__Batch_size_valid</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(ISBLANK(dcstuff__BatchSize__c)) &amp;&amp;
(
  dcstuff__BatchSize__c &lt; 1 ||
  dcstuff__BatchSize__c != FLOOR(dcstuff__BatchSize__c)
)</errorConditionFormula>
        <errorDisplayField>dcstuff__BatchSize__c</errorDisplayField>
        <errorMessage>Batch size must be blank (to use the Salesforce default) or a positive whole number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>dcstuff__Daily_end_date_valid</fullName>
        <active>true</active>
        <errorConditionFormula>dcstuff__Start__c &gt;= DATETIMEVALUE(dcstuff__DailyEnd__c)</errorConditionFormula>
        <errorDisplayField>dcstuff__Start__c</errorDisplayField>
        <errorMessage>The start date &amp; time must be before the final end date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>dcstuff__End_date_time_valid</fullName>
        <active>true</active>
        <errorConditionFormula>dcstuff__Start__c &gt;= dcstuff__End__c</errorConditionFormula>
        <errorDisplayField>dcstuff__Start__c</errorDisplayField>
        <errorMessage>The start date &amp; time must be before the end date &amp; time.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>dcstuff__Is_Class_Flow_or_Code</fullName>
        <active>true</active>
        <errorConditionFormula>IF(ISBLANK(dcstuff__Class__c), 0, 1) +
IF(ISBLANK(dcstuff__Flow__c), 0, 1) +
IF(ISBLANK(dcstuff__AnonymousCode__c), 0, 1)
!= 1</errorConditionFormula>
        <errorMessage>An entry must include either a class, a flow, or an anonymous code block.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>dcstuff__Is_Class_and_Batchable_or_Schedulable</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(ISBLANK(dcstuff__Class__c )) &amp;&amp;
(
  dcstuff__IsBatchable__c &amp;&amp; dcstuff__IsSchedulable__c ||
  !dcstuff__IsBatchable__c &amp;&amp; !dcstuff__IsSchedulable__c
)</errorConditionFormula>
        <errorMessage>A class must be either batchable or schedulable.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>dcstuff__Repeat_interval_valid</fullName>
        <active>true</active>
        <errorConditionFormula>dcstuff__RepeatInterval__c &lt; 0 || FLOOR(dcstuff__RepeatInterval__c) != dcstuff__RepeatInterval__c</errorConditionFormula>
        <errorDisplayField>dcstuff__RepeatInterval__c</errorDisplayField>
        <errorMessage>Repeat interval must either be left empty (to run once) or a positive whole number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>dcstuff__Reschedule_interval_valid</fullName>
        <active>true</active>
        <errorConditionFormula>dcstuff__IsBatchable__c &amp;&amp;
(
  ISBLANK(dcstuff__RescheduleInterval__c) ||
  dcstuff__RescheduleInterval__c &lt; 1 ||
  FLOOR(dcstuff__RescheduleInterval__c) !=
  dcstuff__RescheduleInterval__c
)</errorConditionFormula>
        <errorDisplayField>dcstuff__RescheduleInterval__c</errorDisplayField>
        <errorMessage>Reschedule interval must be a positive whole number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>dcstuff__Start_date_time_valid</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK(dcstuff__Start__c)</errorConditionFormula>
        <errorDisplayField>dcstuff__Start__c</errorDisplayField>
        <errorMessage>An entry must have a start date and time.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
