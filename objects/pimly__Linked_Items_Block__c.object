    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>pimly__Admin_Name__c</fullName>
        <caseSensitive>false</caseSensitive>
        <deprecated>false</deprecated>
        <description>User-definable external ID reference used for Pimly. Auto-generated if not set by user.</description>
        <externalId>true</externalId>
        <label>Admin Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>pimly__Block_Title__c</fullName>
        <deprecated>false</deprecated>
        <description>The title of the block when it renders in the UI.</description>
        <externalId>false</externalId>
        <label>Block Title</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__Block_Type__c</fullName>
        <deprecated>false</deprecated>
        <label>Block Type</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Gallery</fullName>
                    <default>true</default>
                    <label>Gallery</label>
                </value>
                <value>
                    <fullName>Interactive List</fullName>
                    <default>false</default>
                    <label>Interactive List</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>pimly__Pimly_Id__c</fullName>
        <caseSensitive>true</caseSensitive>
        <deprecated>false</deprecated>
        <externalId>true</externalId>
        <label>Pimly Id</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>pimly__Pimly_Property__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Pimly Property</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>Value does not exist or does not match filter criteria (must be a Pimly Property with Type = Linked Item).</errorMessage>
            <filterItems>
                <field>pimly__Pimly_Property__c.pimly__Property_Type__c</field>
                <operation>equals</operation>
                <value>Linked Item</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>pimly__Pimly_Property__c</referenceTo>
        <relationshipLabel>Linked Items Blocks</relationshipLabel>
        <relationshipName>Linked_Items_Blocks</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>pimly__Show_Quantity_Input__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>For the interactive related list, show the quantity input field.</description>
        <label>Show Quantity Input?</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>pimly__Show_Selection_Checkboxes__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <label>Show Selection Checkboxes?</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Linked Items Block</label>
    <listViews>
        <fullName>pimly__All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>LIB-{00000}</displayFormat>
        <label>Linked Items Block Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Linked Items Blocks</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
