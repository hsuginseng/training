    <validationRules>
        <fullName>AVA_B2BLEX__Disable_Edit_Option</fullName>
        <active>true</active>
        <description>Prevents editing certificates that have been invalidated in AvaTax</description>
        <errorConditionFormula>OR(
    PRIORVALUE(AVA_B2BLEX__CertificateStatus__c) = &apos;Invalid&apos;,
    PRIORVALUE(AVA_B2BLEX__CertificateStatus__c) = &apos;Certificate record in AvaTax is now invalid.&apos;,
    CONTAINS(UPPER(PRIORVALUE(AVA_B2BLEX__CertificateStatus__c)), &apos;INVALID&apos;)
)</errorConditionFormula>
        <errorMessage>This certificate is invalid. Please create a new certificate.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>AVA_B2BLEX__Lock_AvaTax_Certificate_Mapping_Field</fullName>
        <active>true</active>
        <description>User should not be able to delete AvaTax Certificate Mapping</description>
        <errorConditionFormula>PRIORVALUE(AVA_B2BLEX__AvaTaxCertificateMapping__c) != NULL &amp;&amp; AVA_B2BLEX__AvaTaxCertificateMapping__c = NULL</errorConditionFormula>
        <errorDisplayField>AVA_B2BLEX__AvaTaxCertificateMapping__c</errorDisplayField>
        <errorMessage>Please do not edit/delete this value</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>AVA_B2BLEX__Lock_Avalara_Certificate_Id_field</fullName>
        <active>true</active>
        <description>Prevents editing the Avalara Certificate ID field once it has been set</description>
        <errorConditionFormula>PRIORVALUE(AVA_B2BLEX__Avalara_Certificate_Id__c) &gt; 0 &amp;&amp; ISCHANGED(AVA_B2BLEX__Avalara_Certificate_Id__c)</errorConditionFormula>
        <errorDisplayField>AVA_B2BLEX__Avalara_Certificate_Id__c</errorDisplayField>
        <errorMessage>Please do not edit this value</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
