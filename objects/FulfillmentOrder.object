        <fullName>Shipping_Error_Message__c</fullName>
        <externalId>false</externalId>
        <label>Shipping Error Message</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Shipping_Origin_City__c</fullName>
        <externalId>false</externalId>
        <formula>IF(OR(CASESAFEID(OrderSummary.SalesStoreId) =  CASESAFEID( $Label.B2B_Canada) , CASESAFEID(OrderSummary.SalesStoreId) =  CASESAFEID( $Label.B2B_Primary)) , OrderSummary.Sales_Representative__r.City , $Organization.City)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Shipping Origin City</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Shipping_Origin_Country__c</fullName>
        <externalId>false</externalId>
        <formula>IF(OR(CASESAFEID(OrderSummary.SalesStoreId) =  CASESAFEID( $Label.B2B_Canada) , CASESAFEID(OrderSummary.SalesStoreId) =  CASESAFEID( $Label.B2B_Primary)), OrderSummary.Sales_Representative__r.Country , $Organization.Country)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Shipping Origin Country</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Shipping_Origin_Postal_Code__c</fullName>
        <externalId>false</externalId>
        <formula>IF( OR(CASESAFEID(OrderSummary.SalesStoreId) =  CASESAFEID( $Label.B2B_Canada) , CASESAFEID(OrderSummary.SalesStoreId) =  CASESAFEID( $Label.B2B_Primary)), OrderSummary.Sales_Representative__r.PostalCode , $Organization.PostalCode)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Shipping Origin Postal Code</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Shipping_Origin_State_Province__c</fullName>
        <externalId>false</externalId>
        <formula>IF(OR(CASESAFEID(OrderSummary.SalesStoreId) =  CASESAFEID( $Label.B2B_Canada) , CASESAFEID(OrderSummary.SalesStoreId) =  CASESAFEID( $Label.B2B_Primary)), OrderSummary.Sales_Representative__r.State , $Organization.State)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Shipping Origin State/Province</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Shipping_Origin_Street__c</fullName>
        <externalId>false</externalId>
        <formula>IF( OR(CASESAFEID(OrderSummary.SalesStoreId) =  CASESAFEID( $Label.B2B_Canada) , CASESAFEID(OrderSummary.SalesStoreId) =  CASESAFEID( $Label.B2B_Primary)),  OrderSummary.Sales_Representative__r.Street ,  $Organization.Street)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Shipping Origin Street</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Source__c</fullName>
        <deprecated>false</deprecated>
        <label>Source</label>
        <required>true</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>NO_ROUTING</fullName>
                    <default>true</default>
                    <label>NO_ROUTING</label>
                </value>
                <value>
                    <fullName>ROUTING</fullName>
                    <default>false</default>
                    <label>ROUTING</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
