        <fullName>avaoms__AvaTax_Customer_Status__c</fullName>
        <deprecated>false</deprecated>
        <description>Displays the AvaTax Exemption customer status.</description>
        <externalId>false</externalId>
        <formula>IMAGE(CASE(avaoms__AvaTax_Message__c,
&quot;Success&quot;, &quot;/img/msg_icons/confirm16.png&quot;,
&quot;Success: Email address is recommended&quot;, &quot;/img/msg_icons/confirm16.png&quot;,
&quot;Update customer to AvaTax Exemption&quot;, &quot;/img/msg_icons/warning16.png&quot;,
&quot;&quot;,&quot;/resource/not_available&quot;,
&quot;Error&quot;,&quot;/img/msg_icons/error16.png&quot;,
&quot;/img/msg_icons/error16.png&quot;), &quot;&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Displays the AvaTax Exemption customer status.</inlineHelpText>
        <label>OMS-AvaTax Customer Status</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
