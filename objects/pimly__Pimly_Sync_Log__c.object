        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>pimly__Progress_Details__c</fullName>
        <deprecated>false</deprecated>
        <description>Meant to be populated with a JSON string containing detailed information about job progress to be surfaced in SmartSync LWCs.</description>
        <label>Progress Details</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>pimly__Resolution_Suggestion__c</fullName>
        <deprecated>false</deprecated>
        <description>Optional resolution suggestion when a SmartSync job fails.</description>
        <label>Resolution Suggestion</label>
        <length>5000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <label>Pimly SmartSync Log</label>
    <nameField>
        <displayFormat>FL-{00000000}</displayFormat>
        <label>SmartSync Log Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Pimly SmartSync Logs</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
