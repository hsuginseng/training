    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Logs for individual runs of Pimly SmartSync jobs, tracking execution details and status.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>pimly__Detailed_Log_Link__c</fullName>
        <deprecated>false</deprecated>
        <description>URL link to detailed log information for this SmartSync job run.</description>
        <label>Detailed Log Link</label>
        <length>5000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>pimly__Error_Message__c</fullName>
        <deprecated>false</deprecated>
        <description>User-facing error message when a SmartSync job fails.</description>
        <label>Error Message</label>
        <length>5000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>pimly__Job_End_Time__c</fullName>
        <deprecated>false</deprecated>
        <label>Job End Time</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>pimly__Job_Start_Time__c</fullName>
        <deprecated>false</deprecated>
        <label>Job Start Time</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>pimly__Job_Status__c</fullName>
        <deprecated>false</deprecated>
        <label>Job Status</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>true</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>In Progress</fullName>
                    <default>false</default>
                    <label>In Progress</label>
                </value>
                <value>
                    <fullName>Complete</fullName>
                    <default>false</default>
                    <label>Complete</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>pimly__Job_Triggered_By__c</fullName>
        <deprecated>false</deprecated>
        <label>Job Triggered By</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>User</fullName>
                    <default>false</default>
                    <label>User</label>
                </value>
                <value>
                    <fullName>Schedule</fullName>
                    <default>false</default>
                    <label>Schedule</label>
                </value>
                <value>
                    <fullName>API</fullName>
                    <default>false</default>
                    <label>API</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>pimly__Last_Successful_Run__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>Reference to the last successful run, used for delta processing.</description>
        <label>Last Successful Run</label>
        <referenceTo>pimly__Pimly_Sync_Log__c</referenceTo>
        <relationshipLabel>Subsequent Runs</relationshipLabel>
        <relationshipName>Subsequent_Runs</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>pimly__Log_Summary_Message__c</fullName>
        <deprecated>false</deprecated>
        <description>Summary message for this SmartSync job run.</description>
        <label>Log Summary Message</label>
        <length>131072</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>pimly__Pimly_Sync_Configuration__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The SmartSync Configuration this log entry is associated with.</description>
