    <fields>
        <fullName>celigo_sfnsio__Sync_Status__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the status of the flow run. If the flow run is successful, the status is Success. If there is an error in the flow run, status is Error. If the flow run is in progress, the status is In Progress. If a created record is not picked by the flow, the status is blank. If an updated record is not picked by the flow, the status will be the same as the value prior to sync.</description>
        <externalId>false</externalId>
        <inlineHelpText>Stores the status of the flow run. If the flow run is successful, the status is Success. If there is an error in the flow run, status is Error. If the flow run is in progress, the status is In Progress.</inlineHelpText>
        <label>Sync Status</label>
        <length>30</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
