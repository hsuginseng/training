    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>pimly__CSV_List_Value_Separator__c</fullName>
        <deprecated>false</deprecated>
        <description>Character/string to use as the separator for values that are lists when exporting to a CSV.</description>
        <externalId>false</externalId>
        <label>CSV List Value Separator</label>
        <length>20</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__CSV_Use_Asset_URLs__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>When checked, use Digital Asset URLs (instead of identifiers) when exporting to CSV.</description>
        <label>CSV Use Asset URLs</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>pimly__Expired__c</fullName>
        <deprecated>false</deprecated>
        <formula>NOW() &gt;=  pimly__Output_Expiration__c</formula>
        <label>Expired</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>pimly__Identifier__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>The key to use in identifying Pimly objects during the export</inlineHelpText>
        <label>Identifier</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__Job_End_Time__c</fullName>
        <deprecated>false</deprecated>
        <label>Job End Time</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>pimly__Job_Progress__c</fullName>
        <deprecated>false</deprecated>
        <formula>pimly__Processed_Records__c /  pimly__Total_Records__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Job Progress</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>pimly__Job_Start_Time__c</fullName>
        <deprecated>false</deprecated>
        <label>Job Start Time</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>pimly__Job_Status__c</fullName>
        <deprecated>false</deprecated>
        <label>Job Status</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>In Progress</fullName>
                    <default>false</default>
                    <label>In Progress</label>
                </value>
                <value>
                    <fullName>Complete</fullName>
                    <default>false</default>
                    <label>Complete</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
                <value>
                    <fullName>Pending</fullName>
                    <default>true</default>
                    <label>Pending</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>pimly__Job_Type__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Job Type</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__Message__c</fullName>
        <deprecated>false</deprecated>
        <description>Messages logged during the export job.</description>
        <label>Message</label>
        <length>131072</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>pimly__Output_Expiration__c</fullName>
        <deprecated>false</deprecated>
        <label>Output Expiration</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>pimly__Output_Filetype__c</fullName>
        <deprecated>false</deprecated>
        <label>Output Filetype</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>CSV</fullName>
                    <default>true</default>
                    <label>CSV</label>
                </value>
                <value>
                    <fullName>JSON</fullName>
                    <default>false</default>
                    <label>JSON</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>pimly__Output_URL__c</fullName>
        <deprecated>false</deprecated>
        <description>URL to access the final export file. May expire.</description>
        <label>Output URL</label>
        <length>5000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>pimly__Pimly_Channel__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Pimly Channel</label>
        <referenceTo>pimly__Pimly_Channel__c</referenceTo>
        <relationshipLabel>Export Logs</relationshipLabel>
        <relationshipName>Export_Logs</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>pimly__Pimly_Locale__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Pimly Locale</label>
        <referenceTo>pimly__Pimly_Locale__c</referenceTo>
        <relationshipLabel>Export Logs</relationshipLabel>
        <relationshipName>Export_Logs</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>pimly__Pimly_ParsedQuery__c</fullName>
        <deprecated>false</deprecated>
        <description>JSON representation of the Pimly Records.ParsedQuery object. This will be used to filter exported records by Pimly data. Refer to documentation for more information.</description>
        <label>Pimly ParsedQuery</label>
        <length>20000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>pimly__Pimly_Record_Type__c</fullName>
        <deprecated>false</deprecated>
        <description>Determines the data that will be exported for a record with regards to property inheritance (parent property values passed down) and property contextualization (channel/locale specific values). See Pimly documentation on Pimly Records vs Pimly Config Records.</description>
        <externalId>false</externalId>
        <label>Pimly Record Type</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__Processed_Records__c</fullName>
        <defaultValue>0</defaultValue>
        <deprecated>false</deprecated>
        <description>Number of records the job has processed. If a job fails this number will likely be lower than the Total Records.</description>
        <externalId>false</externalId>
        <label>Processed Records</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>pimly__SOQL_Where_Clause__c</fullName>
        <deprecated>false</deprecated>
        <description>User-defined WHERE clause for the SOQL query that will be used to filter exported records in Salesforce.</description>
        <label>SOQL Where Clause</label>
        <length>20000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>pimly__Total_Records__c</fullName>
        <deprecated>false</deprecated>
        <description>Total number of product or parent records that the job processes. While a job is running this number may appear higher than its final value due to some records being filtered out by user conditions during the job.</description>
        <externalId>false</externalId>
        <label>Total Records</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Export Log</label>
    <nameField>
        <displayFormat>EL-{00000000}</displayFormat>
        <label>Export Log Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Export Logs</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <startsWith>Vowel</startsWith>
    <visibility>Public</visibility>
</CustomObject>
