        <columns>CREATED_DATE</columns>
        <columns>UPDATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <label>All Linked Item Types</label>
    </listViews>
    <nameField>
        <label>Pimly Linked Item Type Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Linked Item Types</pluralLabel>
