    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Record PO Order Payments and Split Payment Order payment entries using this object. This will tie in closely to the order summary object to show the balance of an order summary.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Amount_Paid__c</fullName>
        <description>This field holds the amount paid by the customer for an order summary.</description>
        <inlineHelpText>The amount the customer paid.</inlineHelpText>
        <label>Amount Paid</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Check_Number__c</fullName>
        <description>For check payments, enter the Check Number information here.</description>
        <externalId>false</externalId>
        <inlineHelpText>Only record the Check Number here. Warning - recording the Account Number or Routing Number is not PCI Compliant!</inlineHelpText>
        <label>Check Number</label>
        <length>30</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Date_Paid__c</fullName>
        <defaultValue>TODAY()</defaultValue>
        <description>The date the customer paid.</description>
        <label>Date Paid</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Order_Summary__c</fullName>
        <description>Relates an Order Summary to the Payment Entry record. An order summary record is required to save.</description>
        <label>Order Summary</label>
        <referenceTo>OrderSummary</referenceTo>
        <relationshipName>Payment_Entries</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Payment_Intent__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The related payment intent for payments that run through Salesforce Payments.</description>
        <label>Payment Intent</label>
        <referenceTo>PaymentIntent</referenceTo>
        <relationshipName>Payment_Entries</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Payment_Type__c</fullName>
        <description>Records the method of payment used by the customer to pay.</description>
        <label>Payment Type</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Cash</fullName>
                    <default>false</default>
                    <label>Cash</label>
                </value>
                <value>
                    <fullName>Check</fullName>
                    <default>false</default>
                    <label>Check</label>
                </value>
                <value>
                    <fullName>Venmo</fullName>
                    <default>false</default>
                    <label>Venmo</label>
                </value>
                <value>
                    <fullName>Zelle</fullName>
                    <default>false</default>
                    <label>Zelle</label>
                </value>
                <value>
                    <fullName>Credit Card</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Credit Card</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Sent_to_Netsuite__c</fullName>
        <defaultValue>true</defaultValue>
        <label>Sent to Netsuite</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Cash Entry</label>
    <nameField>
        <displayFormat>CE-{00000000}</displayFormat>
        <label>Cash Entry Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Cash Entries</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Sent_to_NetSuite_Unchecked</fullName>
        <active>true</active>
        <description>If the &quot;Sent to Netsuite&quot; field is unchecked, throw an error.</description>
        <errorConditionFormula>NOT(Sent_to_Netsuite__c)</errorConditionFormula>
        <errorMessage>The &quot;Sent to Netsuite&quot; field must remain checked to save this record.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
