    <fields>
        <fullName>Is_Destination_State_In_Two_Day_Zone__c</fullName>
        <formula>IF(AND(Shipping_Destination_Country__c = &apos;US&apos;, OR(Shipping_Destination_State__c = &apos;WI&apos;, Shipping_Destination_State__c = &apos;MN&apos;, Shipping_Destination_State__c = &apos;IA&apos;, Shipping_Destination_State__c = &apos;IL&apos;, Shipping_Destination_State__c = &apos;IN&apos;, Shipping_Destination_State__c = &apos;OH&apos;, Shipping_Destination_State__c = &apos;MI&apos;, Shipping_Destination_State__c = &apos;KY&apos;, Shipping_Destination_State__c = &apos;KS&apos;, Shipping_Destination_State__c = &apos;MO&apos;, Shipping_Destination_State__c = &apos;ND&apos;, Shipping_Destination_State__c = &apos;SD&apos;)), TRUE, FALSE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Destination State In Two Day Zone</label>
