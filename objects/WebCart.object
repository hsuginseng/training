    <fields>
        <fullName>Shipping_Category_Name__c</fullName>
        <description>If D2C, determines if order needs Expedited Shipping. If B2B, determines to offer free shipping or not.</description>
        <externalId>false</externalId>
        <formula>If(CASESAFEID(AccountId) = &apos;001V500000XaNmMIAV&apos;, &apos;InStoreAccount&apos;,
If(AND(OR(WebStore.Name = &apos;B2B Canada Storefront&apos;, WebStore.Name = &apos;B2B Primary Storefront&apos;), OR(Free_Shipping_Override__c = True,  Expedite_Shipping_Amount__c + Standard_Shipping_Amount__c &gt;= 500)), &apos;FreeB2B&apos;,
IF(Free_Shipping_Override__c = TRUE, &apos;FreeB2B&apos; ,
If(OR(WebStore.Name = &apos;B2B Canada Storefront&apos;, WebStore.Name = &apos;B2B Primary Storefront&apos;), &apos;StandardB2B&apos;,
If(AND(Shipping_Category__c &gt; 0,  Fresh_Ginseng_Weight__c &gt;= 2, Is_Destination_State_In_Lower_48__c,  Is_Destination_State_In_Two_Day_Zone__c = FALSE),&apos;ExpediteFree&apos;, 
If(AND(Shipping_Category__c &gt; 0,  Fresh_Ginseng_Weight__c &gt;= 2, Is_Destination_State_In_Lower_48__c,  Is_Destination_State_In_Two_Day_Zone__c = TRUE),&apos;StandardFree&apos;, 
If(AND(Shipping_Category__c &gt; 0, Is_Destination_State_In_Two_Day_Zone__c = FALSE), &apos;Expedite&apos;, 
If(AND(Shipping_Category__c &gt; 0, Is_Destination_State_In_Two_Day_Zone__c = TRUE), &apos;Standard&apos;, 
If(AND(OR(Shipping_Category__c = 0, ISBLANK(Shipping_Category__c)), Standard_Shipping_Amount_Remaining__c &lt;= 0, Is_Destination_State_In_Lower_48__c), &apos;StandardFree&apos;, &apos;Standard&apos;)))))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Shipping Category Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
