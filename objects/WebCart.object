        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Shipping_Origin_Street__c</fullName>
        <externalId>false</externalId>
        <formula>IF(OR(WebStore.Name = &apos;B2B Canada Storefront&apos;, WebStore.Name = &apos;B2B Primary Storefront&apos;),  CreatedBy.Street , $Organization.Street)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Shipping Origin Street</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Source_Process__c</fullName>
        <description>This formula determines the process created by the cart, necessary for shipping integrations.</description>
        <externalId>false</externalId>
        <formula>IF(Is_OOBO_Cart__c, &apos;OrderOnBehalfOf&apos;, &apos;Storefront&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Source Process</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Split_Payments__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Split Payments</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Standard_Shipping_Amount_Remaining__c</fullName>
        <formula>100 -  Standard_Shipping_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Standard Shipping Amount Remaining</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Standard_Shipping_Amount__c</fullName>
        <label>Standard Shipping Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
