    <fields>
        <fullName>B2B_OOBO_Approval_Needed_Formula__c</fullName>
        <formula>IF( WebStore.Name = &apos;D2C Primary Storefront&apos;, false,
IF( WebStore.Name = &apos;B2B Primary Storefront&apos;, false,
IF( WebStore.Name = &apos;B2B Canada Storefront&apos;, false,

Cart_Total_Discount_Percentage_Formula__c &gt; 0.10 ||  Cart_Item_Max_Discount_Percentage_Rollup__c &gt; 0.10


)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Triggers Approval Process; Gets copied to B2B_OOBO_Approval_Needed</inlineHelpText>
        <label>B2B OOBO Approval Needed Formula</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
