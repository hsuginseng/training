    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Voucher_Modify_Lock</fullName>
        <active>true</active>
        <description>This prevents the applied loyalty voucher from being modified after it is originally set, unless to clear the value.</description>
        <errorConditionFormula>AND(NOT(ISBLANK(PRIORVALUE(Applied_Loyalty_Voucher__c))),
 ISCHANGED(Applied_Loyalty_Voucher__c),
 NOT(ISBLANK(Applied_Loyalty_Voucher__c)))</errorConditionFormula>
        <errorDisplayField>Applied_Loyalty_Voucher__c</errorDisplayField>
        <errorMessage>The applied loyalty voucher cannot be modified once it has been set.</errorMessage>
    </validationRules>
</CustomObject>
