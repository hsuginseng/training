        <formula>IF(OR(Shipping_Destination_State__c = &apos;HI&apos;, Shipping_Destination_State__c = &apos;AK&apos;, Shipping_Destination_Country__c &lt;&gt; &apos;US&apos;), FALSE, TRUE)</formula>
