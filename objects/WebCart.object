    <fields>
        <fullName>Cart_Total_Discount_Percentage_Formula__c</fullName>
        <description>Total Discount Percentage of Cart; Gets copied to Cart_Total_Discount_Percentage</description>
        <formula>TotalAdjustmentAmount / (TotalProductAmount + TotalAdjustmentAmount)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Cart Total Discount Percentage Formula</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
