    <listViews>
        <fullName>All_Carts</fullName>
        <columns>Owner</columns>
        <columns>Name</columns>
        <columns>CreatedDate</columns>
        <columns>Account</columns>
        <columns>Status</columns>
        <columns>GrandTotalAmount</columns>
        <columns>Shipping_Destination_State__c</columns>
        <columns>TotalTaxAmount</columns>
        <columns>LastModifiedDate</columns>
        <filterScope>Everything</filterScope>
        <label>All Carts</label>
    </listViews>
    <listViews>
        <fullName>All_WebCarts</fullName>
        <columns>Name</columns>
        <columns>CreatedDate</columns>
        <columns>GrandTotalAmount</columns>
        <columns>Status</columns>
        <columns>Owner</columns>
        <columns>Account</columns>
        <columns>LastModifiedDate</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status</field>
            <operation>equals</operation>
            <value>A</value>
        </filters>
        <filters>
            <field>Type</field>
            <operation>equals</operation>
            <value>C</value>
        </filters>
        <label>All Active Carts</label>
    </listViews>
