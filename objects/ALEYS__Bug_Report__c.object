    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Used to report bugs during the UAT/Validation phase of a project.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>true</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>ALEYS__Bug_Type__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>Please indicate if this is a true bug that disrupts the execution of business task or if it is a nice-to-have (enchancement)</inlineHelpText>
        <label>Bug Type</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Bug</fullName>
                    <default>false</default>
                    <label>Bug</label>
                </value>
                <value>
                    <fullName>Enhancement Request</fullName>
                    <default>false</default>
                    <label>Enhancement Request</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>ALEYS__Category__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>Designates if this bug pertains to internal SFDC functionality or is due to integration issues.</inlineHelpText>
        <label>Category</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Functional</fullName>
                    <default>false</default>
                    <label>Functional</label>
                </value>
                <value>
                    <fullName>Technical/Integration</fullName>
                    <default>false</default>
                    <label>Technical/Integration</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>ALEYS__Date_Opened__c</fullName>
        <deprecated>false</deprecated>
        <formula>DATEVALUE(CreatedDate)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The date this bug was initially reported/opened</inlineHelpText>
        <label>Date Opened</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>ALEYS__Date_Resolved__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>The date a particular bug was marked as resolved by the user.</inlineHelpText>
        <label>Date Resolved</label>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>ALEYS__Description__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>Please give a thorough description of the bug you found.</inlineHelpText>
        <label>Description</label>
        <length>32768</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>ALEYS__Error_Message__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>If you received an error message from Salesforce please copy and paste it here.</inlineHelpText>
        <label>Error Message</label>
        <length>32768</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>ALEYS__Level_of_Effort__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>The estimated level of effort assigned to resolve this bug by the backend team.</inlineHelpText>
        <label>Level of Effort</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>High</fullName>
                    <default>false</default>
                    <label>High</label>
                </value>
                <value>
                    <fullName>Medium</fullName>
                    <default>false</default>
                    <label>Medium</label>
                </value>
                <value>
                    <fullName>Low</fullName>
                    <default>false</default>
                    <label>Low</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>ALEYS__Priority__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>The level of prioritization that should be assigned to this bug as it is evaluated by your Salesforce team. &quot;Critical&quot; meaning the bug is causing severe disruptions in completing business processes or the continuation of testing.</inlineHelpText>
        <label>Priority</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Critical</fullName>
                    <default>false</default>
                    <label>Critical</label>
                </value>
                <value>
                    <fullName>High</fullName>
                    <default>false</default>
                    <label>High</label>
                </value>
                <value>
                    <fullName>Medium</fullName>
                    <default>false</default>
                    <label>Medium</label>
                </value>
                <value>
                    <fullName>Low</fullName>
                    <default>false</default>
                    <label>Low</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>ALEYS__Project__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>The project this bug corresponds to.</inlineHelpText>
        <label>Project</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>International Foundations</fullName>
                    <default>false</default>
                    <label>International Foundations</label>
                </value>
                <value>
                    <fullName>International Sales POC</fullName>
                    <default>false</default>
                    <label>International Sales POC</label>
                </value>
                <value>
                    <fullName>Foundations</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Foundations</label>
                </value>
                <value>
                    <fullName>US Service Contracts</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>US Service Contracts</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>ALEYS__Record_URL__c</fullName>
        <deprecated>false</deprecated>
        <description>The record URL related the the encountered bug. This is captured automatically.</description>
        <label>Record URL</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>ALEYS__Status__c</fullName>
        <defaultValue>&quot;New&quot;</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>The status of the bug found. This is defaulted to &quot;New&quot; when found by a user and updated by an administrator as the bug is worked on/corrected.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackFeedHistory>true</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>New</fullName>
                    <default>false</default>
                    <label>New</label>
                </value>
                <value>
                    <fullName>Investigating</fullName>
                    <default>false</default>
                    <label>Investigating</label>
                </value>
                <value>
                    <fullName>In Progress</fullName>
                    <default>false</default>
                    <label>In Progress</label>
                </value>
                <value>
                    <fullName>Ready For Retest</fullName>
                    <default>false</default>
                    <label>Ready For Retest</label>
                </value>
                <value>
                    <fullName>Resolved</fullName>
                    <default>false</default>
                    <label>Resolved</label>
                </value>
                <value>
                    <fullName>Not Resolved</fullName>
                    <default>false</default>
                    <label>Not Resolved</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>ALEYS__Steps_to_Recreate__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>If necessary, list out the steps to recreate this bug</inlineHelpText>
        <label>Steps to Recreate</label>
        <length>32768</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>ALEYS__Submitted_By__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <inlineHelpText>The user who submitted this bug report.</inlineHelpText>
        <label>Submitted By</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Bug_Reports</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ALEYS__Test_Script__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>Please copy and paste the test script # of the script that you encountered this bug on.</inlineHelpText>
        <label>Test Script #</label>
        <length>50</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ALEYS__Testing_Period__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>Did this bug occur during UAT, functional testing, or integration testing?</inlineHelpText>
        <label>Testing Period</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>UAT</fullName>
                    <default>false</default>
                    <label>UAT</label>
                </value>
                <value>
                    <fullName>Functional</fullName>
                    <default>false</default>
                    <label>Functional</label>
                </value>
                <value>
                    <fullName>Integration</fullName>
                    <default>false</default>
                    <label>Integration</label>
                </value>
                <value>
                    <fullName>Regression Testing</fullName>
                    <default>false</default>
                    <label>Regression Testing</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>ALEYS__Title__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>Please enter a high level title to describe the bug you encountered.</inlineHelpText>
        <label>Title</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ALEYS__URL__c</fullName>
        <deprecated>false</deprecated>
        <description>URL of the record the user is currently viewing</description>
        <label>URL</label>
        <length>32768</length>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <label>Bug Report</label>
    <listViews>
        <fullName>ALEYS__All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>ALEYS__Bug_Reports_by_Status</fullName>
        <columns>NAME</columns>
        <columns>ALEYS__Priority__c</columns>
        <columns>ALEYS__Bug_Type__c</columns>
        <columns>ALEYS__Date_Opened__c</columns>
        <filterScope>Everything</filterScope>
        <label>Bug Reports by Status</label>
    </listViews>
    <listViews>
        <fullName>ALEYS__Copy_of_My_Bug_Reports</fullName>
        <columns>NAME</columns>
        <columns>ALEYS__Title__c</columns>
        <columns>ALEYS__Description__c</columns>
        <columns>ALEYS__Status__c</columns>
        <columns>ALEYS__Date_Opened__c</columns>
        <columns>ALEYS__Test_Script__c</columns>
        <columns>ALEYS__Record_URL__c</columns>
        <columns>ALEYS__Priority__c</columns>
        <columns>ALEYS__Level_of_Effort__c</columns>
        <columns>ALEYS__Category__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ALEYS__Status__c</field>
            <operation>notEqual</operation>
            <value>Resolved</value>
        </filters>
        <label>All Open Bug Reports</label>
    </listViews>
    <listViews>
        <fullName>ALEYS__Critical_Level_Bug_Reports</fullName>
        <columns>NAME</columns>
        <columns>ALEYS__Title__c</columns>
        <columns>ALEYS__Description__c</columns>
        <columns>ALEYS__Status__c</columns>
        <columns>ALEYS__Date_Opened__c</columns>
        <columns>ALEYS__Test_Script__c</columns>
        <columns>ALEYS__Record_URL__c</columns>
        <columns>ALEYS__Level_of_Effort__c</columns>
        <columns>ALEYS__Submitted_By__c</columns>
        <columns>ALEYS__Category__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ALEYS__Status__c</field>
            <operation>notEqual</operation>
            <value>Resolved</value>
        </filters>
        <filters>
            <field>ALEYS__Priority__c</field>
            <operation>equals</operation>
            <value>Critical</value>
        </filters>
        <label>Critical Level Bug Reports</label>
    </listViews>
    <listViews>
        <fullName>ALEYS__High_Effort_Open_Bug_Reports</fullName>
        <columns>NAME</columns>
        <columns>ALEYS__Title__c</columns>
        <columns>ALEYS__Description__c</columns>
        <columns>ALEYS__Status__c</columns>
        <columns>ALEYS__Date_Opened__c</columns>
        <columns>ALEYS__Test_Script__c</columns>
        <columns>ALEYS__Record_URL__c</columns>
        <columns>ALEYS__Priority__c</columns>
        <columns>ALEYS__Level_of_Effort__c</columns>
        <columns>ALEYS__Category__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ALEYS__Status__c</field>
            <operation>notEqual</operation>
            <value>Resolved</value>
        </filters>
        <filters>
            <field>ALEYS__Level_of_Effort__c</field>
            <operation>equals</operation>
            <value>High</value>
        </filters>
        <label>High Effort Open Bug Reports</label>
    </listViews>
    <listViews>
        <fullName>ALEYS__Open_Bug_Reports_by_Priority</fullName>
        <columns>NAME</columns>
        <columns>ALEYS__Title__c</columns>
        <columns>ALEYS__Status__c</columns>
        <columns>ALEYS__Date_Opened__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ALEYS__Status__c</field>
            <operation>equals</operation>
            <value>New,Investigating,Ready For Retest,Not Resolved</value>
        </filters>
        <label>Open Bug Reports by Priority</label>
    </listViews>
    <listViews>
        <fullName>ALEYS__Open_Functional_Bug_Reports</fullName>
