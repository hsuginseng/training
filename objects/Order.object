    <fields>
        <fullName>avaoms__DeliveryTerms__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>Utilize this field to specify whether the seller or buyer is responsible for any applicable duties, taxes and import fees. If DDP is selected then seller is responsible and if DAP is selected then buyer is responsible.</inlineHelpText>
        <label>Delivery Terms</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>DAP</fullName>
                    <default>false</default>
                    <label>Delivered At Place</label>
                </value>
                <value>
                    <fullName>DDP</fullName>
                    <default>false</default>
                    <label>Delivered Duty Paid</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
