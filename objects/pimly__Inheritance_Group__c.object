    <fields>
        <fullName>pimly__Inheritance_Model_Id__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(
    ISBLANK(pimly__Inheritance_Group__c),
    pimly__Pimly_Id__c,
    IF(
        ISBLANK(pimly__Inheritance_Group__r.pimly__Inheritance_Group__c),
        pimly__Inheritance_Group__r.pimly__Pimly_Id__c,
        IF(
            ISBLANK(pimly__Inheritance_Group__r.pimly__Inheritance_Group__r.pimly__Inheritance_Group__c),
            pimly__Inheritance_Group__r.pimly__Inheritance_Group__r.pimly__Pimly_Id__c,
            IF(
                ISBLANK(pimly__Inheritance_Group__r.pimly__Inheritance_Group__r.pimly__Inheritance_Group__r.pimly__Inheritance_Group__c),
                pimly__Inheritance_Group__r.pimly__Inheritance_Group__r.pimly__Inheritance_Group__r.pimly__Pimly_Id__c,
                pimly__Inheritance_Group__r.pimly__Inheritance_Group__r.pimly__Inheritance_Group__r.pimly__Inheritance_Group__r.pimly__Pimly_Id__c
            )
        )
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Inheritance Model Id</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
