<?xml version="1.0" encoding="UTF-8"?>
<MktCalcInsightObjectDef xmlns="http://soap.sforce.com/2006/04/metadata">
    <builderExpression>PZ1:</builderExpression>
    <creationType>Custom</creationType>
    <description>This score indicates how much the individuals in this org typically interact with your sales communications.</description>
    <expression>SELECT    FIRST(uiEngagementQuery.Engagement_Score__c) AS Engagement_Score__c,    FIRST(uiEngagementQuery.Unnorm_Engagement_Score__c) AS Raw_Engagement_Score__c,    FIRST(uiEngagementQuery.Rule1_Score__c) AS Rule1_Score__c,FIRST(uiEngagementQuery.Rule2_Score__c) AS Rule2_Score__c,SUM(0) AS Rule3_Score__c,SUM(0) AS Rule4_Score__c,SUM(0) AS Rule5_Score__c,SUM(0) AS Rule6_Score__c,SUM(0) AS Rule7_Score__c,SUM(0) AS Rule8_Score__c,SUM(0) AS Rule9_Score__c,SUM(0) AS Rule10_Score__c,SUM(0) AS Rule11_Score__c,SUM(0) AS Rule12_Score__c,SUM(0) AS Rule13_Score__c,SUM(0) AS Rule14_Score__c,SUM(0) AS Rule15_Score__c,SUM(0) AS Rule16_Score__c,SUM(0) AS Rule17_Score__c,SUM(0) AS Rule18_Score__c,SUM(0) AS Rule19_Score__c,SUM(0) AS Rule20_Score__c,SUM(0) AS Rule21_Score__c,SUM(0) AS Rule22_Score__c,SUM(0) AS Rule23_Score__c,SUM(0) AS Rule24_Score__c,SUM(0) AS Rule25_Score__c,SUM(0) AS Rule26_Score__c,SUM(0) AS Rule27_Score__c,SUM(0) AS Rule28_Score__c,SUM(0) AS Rule29_Score__c,SUM(0) AS Rule30_Score__c,    ssot__Individual__dlm.ssot__Id__c AS IndividualId__c FROM (    SELECT  nonnormalizedQuery.Unified_Individual__c as Unified_Individual__c,  FIRST(nonnormalizedQuery.Engagement_Score__c) as Unnorm_Engagement_Score__c,  FIRST(nonnormalizedQuery.Rule1_Score__c) AS Rule1_Score__c,FIRST(nonnormalizedQuery.Rule2_Score__c) AS Rule2_Score__c,  CASE    WHEN SUM(Totals.num__c) = 1 THEN SUM(100)    ELSE ROUND(      100 * ((dense_rank() OVER (        ORDER BY          SUM(            nonnormalizedQuery.Engagement_Score__c          )        )) - 1) / SUM(Totals.num__c - 1),      0    )  END AS Engagement_Score__c FROM  UnifiedIndividual__dlm  FULL JOIN (    SELECT    UnifiedIndividual__dlm.ssot__Id__c AS Unified_Individual__c,    FIRST(Subquery1Score.Rule1_Score__c) AS Rule1_Score__c,FIRST(Subquery1Score.Rule2_Score__c) AS Rule2_Score__c,
(FIRST(Subquery1Score.Rule1_Score__c)+FIRST(Subquery1Score.Rule2_Score__c)) as Engagement_Score__c FROM    UnifiedIndividual__dlm INNER JOIN    (        SELECT            SUM(    CASE        WHEN  (  ( ssot__EmailEngagement__dlm.ssot__EngagementChannelActionId__c = &apos;CLICK&apos;)) THEN 3        ELSE 0    END) as Rule1_Score__c,
SUM(    CASE        WHEN  (  ( ssot__EmailEngagement__dlm.ssot__EngagementChannelActionId__c = &apos;UNSUBSCRIBE&apos;)) THEN -5        ELSE 0    END) as Rule2_Score__c,            UnifiedIndividual__dlm.ssot__Id__c as Unified_Individual__c        FROM            UnifiedIndividual__dlm                    INNER JOIN            IndividualIdentityLink__dlm            ON UnifiedIndividual__dlm.ssot__Id__c = IndividualIdentityLink__dlm.UnifiedRecordId__c
        INNER JOIN            ssot__Individual__dlm            ON IndividualIdentityLink__dlm.SourceRecordId__c = ssot__Individual__dlm.ssot__Id__c
                FULL JOIN            ssot__EmailEngagement__dlm            ON ssot__Individual__dlm.ssot__Id__c = ssot__EmailEngagement__dlm.ssot__IndividualId__c
        GROUP BY            UnifiedIndividual__dlm.ssot__Id__c    )        AS Subquery1Score    ON Subquery1Score.Unified_Individual__c = UnifiedIndividual__dlm.ssot__Id__c
 GROUP BY     UnifiedIndividual__dlm.ssot__Id__c  ) AS nonnormalizedQuery ON UnifiedIndividual__dlm.ssot__Id__c = nonnormalizedQuery.Unified_Individual__c  FULL JOIN (    SELECT      COUNT(        Distinct_Subquery.Engagement_Score__c      ) as num__c    FROM      (        SELECT          nonnormalizedQuery.Engagement_Score__c as Engagement_Score__c        FROM          (SELECT    UnifiedIndividual__dlm.ssot__Id__c AS Unified_Individual__c,    FIRST(Subquery1Score.Rule1_Score__c) AS Rule1_Score__c,FIRST(Subquery1Score.Rule2_Score__c) AS Rule2_Score__c,
(FIRST(Subquery1Score.Rule1_Score__c)+FIRST(Subquery1Score.Rule2_Score__c)) as Engagement_Score__c FROM    UnifiedIndividual__dlm INNER JOIN    (        SELECT            SUM(    CASE        WHEN  (  ( ssot__EmailEngagement__dlm.ssot__EngagementChannelActionId__c = &apos;CLICK&apos;)) THEN 3        ELSE 0    END) as Rule1_Score__c,
SUM(    CASE        WHEN  (  ( ssot__EmailEngagement__dlm.ssot__EngagementChannelActionId__c = &apos;UNSUBSCRIBE&apos;)) THEN -5        ELSE 0    END) as Rule2_Score__c,            UnifiedIndividual__dlm.ssot__Id__c as Unified_Individual__c        FROM            UnifiedIndividual__dlm                    INNER JOIN            IndividualIdentityLink__dlm            ON UnifiedIndividual__dlm.ssot__Id__c = IndividualIdentityLink__dlm.UnifiedRecordId__c
        INNER JOIN            ssot__Individual__dlm            ON IndividualIdentityLink__dlm.SourceRecordId__c = ssot__Individual__dlm.ssot__Id__c
                FULL JOIN            ssot__EmailEngagement__dlm            ON ssot__Individual__dlm.ssot__Id__c = ssot__EmailEngagement__dlm.ssot__IndividualId__c
        GROUP BY            UnifiedIndividual__dlm.ssot__Id__c    )        AS Subquery1Score    ON Subquery1Score.Unified_Individual__c = UnifiedIndividual__dlm.ssot__Id__c
 GROUP BY     UnifiedIndividual__dlm.ssot__Id__c) AS nonnormalizedQuery        GROUP BY          nonnormalizedQuery.Engagement_Score__c      ) AS Distinct_Subquery  ) AS Totals ON nonnormalizedQuery.Unified_Individual__c &lt;&gt; &apos;&apos; and Totals.num__c &lt;&gt; -10000 GROUP BY  nonnormalizedQuery.Unified_Individual__c )as uiEngagementQuery    INNER JOIN IndividualIdentityLink__dlm ON (        uiEngagementQuery.Unified_Individual__c = IndividualIdentityLink__dlm.UnifiedRecordId__c    )    INNER JOIN  ssot__Individual__dlm ON (        IndividualIdentityLink__dlm.SourceRecordId__c = ssot__Individual__dlm.ssot__Id__c    ) GROUP BY    IndividualId__c</expression>
    <masterLabel>Individual Engagement Score</masterLabel>
</MktCalcInsightObjectDef>
