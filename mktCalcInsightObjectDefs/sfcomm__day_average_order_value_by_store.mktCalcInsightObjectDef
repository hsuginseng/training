<?xml version="1.0" encoding="UTF-8"?>
<MktCalcInsightObjectDef xmlns="http://soap.sforce.com/2006/04/metadata">
    <creationType>Custom</creationType>
    <description>Calculate the order value of a commerce store per day</description>
    <expression>SELECT ssot__SalesOrder__dlm.ssot__SalesStoreId__c as sfcomm__web_store_id__c, SUM(ssot__SalesOrder__dlm.ssot__GrandTotalAmount__c) / count (ssot__SalesOrder__dlm.ssot__Id__c) AS sfcomm__average_order_value__c, CdpDay(ssot__SalesOrder__dlm.ssot__FiledDate__c) as sfcomm__order_date__c FROM ssot__SalesOrder__dlm WHERE ssot__SalesOrder__dlm.ssot__SalesStoreId__c IS NOT NULL GROUP BY sfcomm__web_store_id__c, sfcomm__order_date__c</expression>
    <masterLabel>day_average_order_value_by_store</masterLabel>
</MktCalcInsightObjectDef>
