<?xml version="1.0" encoding="UTF-8"?>
<MktCalcInsightObjectDef xmlns="http://soap.sforce.com/2006/04/metadata">
    <creationType>Custom</creationType>
    <description>Average order value per account</description>
    <expression>SELECT ssot__SalesOrder__dlm.ssot__BillToAccountId__c as sfcomm__account__c, SUM(ssot__SalesOrder__dlm.ssot__GrandTotalAmount__c) / COUNT(ssot__SalesOrder__dlm.ssot__Id__c) AS sfcomm__average_order_value__c FROM ssot__SalesOrder__dlm GROUP BY sfcomm__account__c</expression>
    <masterLabel>average_order_value_by_account</masterLabel>
</MktCalcInsightObjectDef>
