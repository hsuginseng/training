<?xml version="1.0" encoding="UTF-8"?>
<MktCalcInsightObjectDef xmlns="http://soap.sforce.com/2006/04/metadata">
    <builderExpression>PZ1:</builderExpression>
    <creationType>Custom</creationType>
    <description>This score aggregates the Marketing Engagement Score and the Marketing Fit Score. The Overall Marketing Score helps you decide when to send a potential customer to your sales team.</description>
    <expression>SELECT    FIRST(Marketing_Engagement_Score__cio.Engagement_Score__c) as Engagement_Score__c,Marketing_Engagement_Score__cio.Unified_Individual__c as Unified_Individual0__c,
FIRST(Marketing_Fit_Score__cio.Fit_Score__c) as Fit_Score__c,Marketing_Fit_Score__cio.Unified_Individual__c as Unified_Individual1__c,
    ROUND(0.5*FIRST(Marketing_Engagement_Score__cio.Engagement_Score__c)+0.5*FIRST(Marketing_Fit_Score__cio.Fit_Score__c),0) as People_Score__c,    UnifiedIndividual__dlm.ssot__Id__c as Unified_Individual__c    FROM        UnifiedIndividual__dlm    LEFT JOIN Marketing_Engagement_Score__cio ON (Marketing_Engagement_Score__cio.Unified_Individual__c = UnifiedIndividual__dlm.ssot__Id__c)
LEFT JOIN Marketing_Fit_Score__cio ON (Marketing_Fit_Score__cio.Unified_Individual__c = UnifiedIndividual__dlm.ssot__Id__c)
 GROUP BY Unified_Individual0__c,Unified_Individual1__c, Unified_Individual__c</expression>
    <masterLabel>Overall Marketing Score</masterLabel>
</MktCalcInsightObjectDef>
