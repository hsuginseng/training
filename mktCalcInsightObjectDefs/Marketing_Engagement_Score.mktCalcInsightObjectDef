<?xml version="1.0" encoding="UTF-8"?>
<MktCalcInsightObjectDef xmlns="http://soap.sforce.com/2006/04/metadata">
    <builderExpression>PZ1:</builderExpression>
    <creationType>Custom</creationType>
    <description>This score indicates how much this individual typically interacts with your marketing communications.</description>
    <expression>SELECT rankQuery.Unified_Individual__c AS Unified_Individual__c, FIRST(rankQuery.Rule1_Score__c) AS Rule1_Score__c,FIRST(rankQuery.Rule2_Score__c) AS Rule2_Score__c,SUM(0) AS Rule3_Score__c,SUM(0) AS Rule4_Score__c,SUM(0) AS Rule5_Score__c,SUM(0) AS Rule6_Score__c,SUM(0) AS Rule7_Score__c,SUM(0) AS Rule8_Score__c,SUM(0) AS Rule9_Score__c,SUM(0) AS Rule10_Score__c,SUM(0) AS Rule11_Score__c,SUM(0) AS Rule12_Score__c,SUM(0) AS Rule13_Score__c,SUM(0) AS Rule14_Score__c,SUM(0) AS Rule15_Score__c,SUM(0) AS Rule16_Score__c,SUM(0) AS Rule17_Score__c,SUM(0) AS Rule18_Score__c,SUM(0) AS Rule19_Score__c,SUM(0) AS Rule20_Score__c,SUM(0) AS Rule21_Score__c,SUM(0) AS Rule22_Score__c,SUM(0) AS Rule23_Score__c,SUM(0) AS Rule24_Score__c,SUM(0) AS Rule25_Score__c,SUM(0) AS Rule26_Score__c,SUM(0) AS Rule27_Score__c,SUM(0) AS Rule28_Score__c,SUM(0) AS Rule29_Score__c,SUM(0) AS Rule30_Score__c, FIRST(rankQuery.Engagement_Score__c) AS Engagement_Score__c, FIRST(rankQuery.Raw_Engagement_Score__c) AS Raw_Engagement_Score__c  FROM (SELECT Individual_Engagement_Score__cio.IndividualId__c AS IndividualId__c, UnifiedIndividual__dlm.ssot__Id__c AS Unified_Individual__c, RANK() OVER (PARTITION BY UnifiedIndividual__dlm.ssot__Id__c ORDER BY MAX(Individual_Engagement_Score__cio.Engagement_Score__c) DESC) AS Rank__c, FIRST(Individual_Engagement_Score__cio.Rule1_Score__c) AS Rule1_Score__c,FIRST(Individual_Engagement_Score__cio.Rule2_Score__c) AS Rule2_Score__c,FIRST(Individual_Engagement_Score__cio.Engagement_Score__c) AS Engagement_Score__c,FIRST(Individual_Engagement_Score__cio.Raw_Engagement_Score__c) AS Raw_Engagement_Score__c FROM Individual_Engagement_Score__cio INNER JOIN ssot__Individual__dlm ON Individual_Engagement_Score__cio.IndividualId__c = ssot__Individual__dlm.ssot__Id__c INNER JOIN IndividualIdentityLink__dlm ON ssot__Individual__dlm.ssot__Id__c = IndividualIdentityLink__dlm.SourceRecordId__c INNER JOIN UnifiedIndividual__dlm ON IndividualIdentityLink__dlm.UnifiedRecordId__c = UnifiedIndividual__dlm.ssot__Id__c  GROUP BY Individual_Engagement_Score__cio.IndividualId__c, UnifiedIndividual__dlm.ssot__Id__c) AS rankQuery GROUP BY rankQuery.Unified_Individual__c</expression>
    <masterLabel>Marketing Engagement Score</masterLabel>
</MktCalcInsightObjectDef>
