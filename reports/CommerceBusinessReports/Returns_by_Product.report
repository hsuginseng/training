<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>OrderItemSummary.QuantityReturned:SUM / OrderItemSummary.QuantityOrdered:SUM</calculatedFormula>
        <datatype>percent</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>false</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Return Rate</masterLabel>
        <scale>2</scale>
    </aggregates>
    <columns>
        <field>OrderSummary$Name</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OrderSummary.OrderItemSummaries$QuantityOrdered</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OrderSummary.OrderItemSummaries$QuantityReturned</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OrderSummary.OrderItemSummaries$UnitPrice</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OrderSummary$TotalTaxAmount</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OrderSummary$TotalAdjustedDeliveryAmount</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OrderSummary.OrderItemSummaries$TotalLineAdjustmentAmount</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OrderSummary$TotalAdjDistAmount</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OrderSummary.OrderItemSummaries$AdjustedLineAmount</field>
    </columns>
    <currency>USD</currency>
    <description>Shows the ordered quantity, returned quantity, and return rate for each product, organized by product name and SKU.</description>
    <filter>
        <criteriaItems>
            <column>OrderSummary$SalesStore</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>D2C Primary Storefront</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <field>OrderSummary$CreatedDate</field>
        <sortOrder>Desc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>OrderSummary.OrderItemSummaries$Product2.StockKeepingUnit</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>OrderSummary.OrderItemSummaries$Product2</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Orders and Returns by Product</name>
    <params>
        <name>co</name>
        <value>0</value>
    </params>
    <reportType>Order_with_Product_Summary_and_Changes__c</reportType>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>false</showSubTotals>
    <timeFrameFilter>
        <dateColumn>OrderSummary$CreatedDate</dateColumn>
        <endDate>2026-07-31</endDate>
        <interval>INTERVAL_CUSTOM</interval>
        <startDate>2026-07-01</startDate>
    </timeFrameFilter>
</Report>
