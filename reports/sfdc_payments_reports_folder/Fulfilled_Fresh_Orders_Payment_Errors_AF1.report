    </crossFilters>
    <currency>USD</currency>
    <description>This report contains order summaries that have been fulfilled. These order summaries have multiple fulfillments, and the payment data indicates the orders were not completely paid.</description>
    <filter>
        <criteriaItems>
            <column>OrderSummary$Fulfilled_Product_Count__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <column>OrderSummary.FulfillmentOrders.FulfillmentOrderLineItems$Type</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>Delivery Charge,Fee</value>
        </criteriaItems>
        <criteriaItems>
            <column>OrderSummary$Balance_Due__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>notEqual</operator>
            <value>USD 0</value>
        </criteriaItems>
        <criteriaItems>
            <column>OrderSummary.FulfillmentOrders.FulfillmentOrderLineItems$OrderItemSummary.Status</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>RETURNED,CANCELED</value>
        </criteriaItems>
        <criteriaItems>
            <column>OrderSummary$SalesChannel</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>equals</operator>
            <value>D2C Sales Channel</value>
        </criteriaItems>
        <criteriaItems>
            <column>OrderSummary$Fresh_Ginseng_Product_Count__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>greaterThan</operator>
            <value>0</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
