<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <columns>
        <field>OrderSummary$Name</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OrderSummary$GrandTotalAmount</field>
    </columns>
    <columns>
        <field>OrderSummary.OrderPaymentSummaries.PaymentAuthorizations$CreatedDate</field>
    </columns>
    <columns>
        <field>OrderSummary.OrderPaymentSummaries.PaymentAuthorizations$PaymentIntent.Status</field>
    </columns>
    <columns>
        <field>OrderSummary.OrderPaymentSummaries$Name</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OrderSummary.OrderPaymentSummaries.PaymentAuthorizations$Amount</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>OrderSummary.OrderPaymentSummaries.PaymentAuthorizations$TotalPaymentCaptureAmount</field>
    </columns>
    <columns>
        <field>OrderSummary.OrderPaymentSummaries.PaymentAuthorizations$PaymentIntent.Name</field>
    </columns>
    <columns>
        <field>OrderSummary.OrderPaymentSummaries.PaymentAuthorizations$Name</field>
    </columns>
    <currency>USD</currency>
    <description>This report generates a list of payment authorizations greater than 5 days old. This is used to identify payment authorizations that are near expiration, so that swift action can be taken to capture the payment and apply it to an order summary&apos;s invoice.</description>
    <filter>
        <criteriaItems>
            <column>OrderSummary.OrderPaymentSummaries.PaymentAuthorizations$CreatedDate</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>lessOrEqual</operator>
            <value>N_DAYS_AGO:4</value>
        </criteriaItems>
        <criteriaItems>
            <column>OrderSummary.OrderPaymentSummaries$Is_Fully_Captured__c</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <column>OrderSummary.OrderPaymentSummaries.PaymentAuthorizations$PaymentIntent.IsCaptureComplete</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>equals</operator>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <column>OrderSummary.OrderPaymentSummaries.PaymentAuthorizations$PaymentGateway</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>notEqual</operator>
            <value>Stripe Wallet Gateway</value>
        </criteriaItems>
        <criteriaItems>
            <column>OrderSummary.OrderPaymentSummaries.PaymentAuthorizations$PaymentIntent.Status</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>false</isUnlocked>
            <operator>notEqual</operator>
            <value>6,8</value>
        </criteriaItems>
        <criteriaItems>
            <column>OrderSummary$GrandTotalAmount</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>notEqual</operator>
            <value>USD 0</value>
        </criteriaItems>
        <criteriaItems>
            <column>OrderSummary.OrderPaymentSummaries.PaymentAuthorizations$CreatedDate</column>
            <columnToColumn>false</columnToColumn>
            <isUnlocked>true</isUnlocked>
            <operator>greaterThan</operator>
            <value>N_DAYS_AGO:30</value>
        </criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Tabular</format>
    <name>Payment Authorizations Expiring Soon</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>Payment_Authorization_by_Store__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <sortColumn>OrderSummary.OrderPaymentSummaries.PaymentAuthorizations$CreatedDate</sortColumn>
    <sortOrder>Asc</sortOrder>
    <timeFrameFilter>
        <dateColumn>OrderSummary$CreatedDate</dateColumn>
        <interval>INTERVAL_CUSTOM</interval>
    </timeFrameFilter>
</Report>
