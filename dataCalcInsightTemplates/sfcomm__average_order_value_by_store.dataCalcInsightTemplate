<?xml version="1.0" encoding="UTF-8"?>
<DataCalcInsightTemplate xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <builderExpression xsi:nil="true"/>
    <creationType>Custom</creationType>
    <dataspaceName>default</dataspaceName>
    <dataspacePrefix xsi:nil="true"/>
    <definitionType>CALCULATED_METRIC</definitionType>
    <description>Calculate Average order value of a commerce store</description>
    <developerName>average_order_value_by_store</developerName>
    <expression>SELECT ssot__SalesOrder__dlm.ssot__SalesStoreId__c as sfcomm__web_store_id__c, SUM(ssot__SalesOrder__dlm.ssot__GrandTotalAmount__c) / count (ssot__SalesOrder__dlm.ssot__Id__c) AS sfcomm__average_order_value__c FROM ssot__SalesOrder__dlm WHERE ssot__SalesOrder__dlm.ssot__SalesStoreId__c IS NOT NULL GROUP BY sfcomm__web_store_id__c</expression>
    <masterLabel>average_order_value_by_store</masterLabel>
    <scheduleInterval>SYSTEM_MANAGED</scheduleInterval>
    <templateVersion>1</templateVersion>
</DataCalcInsightTemplate>
