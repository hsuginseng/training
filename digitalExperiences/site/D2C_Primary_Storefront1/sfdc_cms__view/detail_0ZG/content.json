            "sectionColumnGutterWidth" : "",
            "sectionConfig" : "{\"UUID\":\"3b772c49-0c88-497b-8598-f01aa54d814a\",\"columns\":[{\"UUID\":\"dfc026f5-cb52-4397-a887-b8433f52fbe6\",\"columnName\":\"Column 1\",\"columnKey\":\"col1\",\"columnWidth\":\"6\",\"seedComponents\":[]},{\"UUID\":\"9fdcdc14-6716-4ca1-9e6c-940792e1389b\",\"columnName\":\"Column 2\",\"columnKey\":\"13d74\",\"columnWidth\":\"6\",\"seedComponents\":[]}]}",
            "sectionMinHeight" : "",
