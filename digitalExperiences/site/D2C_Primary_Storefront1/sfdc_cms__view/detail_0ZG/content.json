            "sectionConfig" : "{\"UUID\":\"b361eb7a-da4c-4c34-aba9-c6b8e5961a96\",\"columns\":[{\"UUID\":\"ac5e956b-d2cb-4db0-b36f-0b476ac1cd9e\",\"columnName\":\"Column 1\",\"columnKey\":\"col1\",\"columnWidth\":\"6\",\"seedComponents\":[]},{\"UUID\":\"fb40c496-28ae-47e7-9e31-b5ca95b3539a\",\"columnName\":\"Column 2\",\"columnKey\":\"f3a52\",\"columnWidth\":\"6\",\"seedComponents\":[]}]}",
            "sectionMinHeight" : "",
