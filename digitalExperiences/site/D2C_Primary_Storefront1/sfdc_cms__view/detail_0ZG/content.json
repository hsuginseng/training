            "maxContentWidth" : "",
            "sectionColumnGutterWidth" : "",
            "sectionConfig" : "{\"UUID\":\"ed452639-e418-4b70-a7d5-1e1531bfceab\",\"columns\":[{\"UUID\":\"9c0ac620-1e15-414a-b530-c4b4a7401f75\",\"columnName\":\"Column 1\",\"columnKey\":\"col1\",\"columnWidth\":\"6\",\"seedComponents\":[]},{\"UUID\":\"ff8a32c2-6b93-4210-8d6a-42ecef635d1f\",\"columnName\":\"Column 2\",\"columnKey\":\"7649b\",\"columnWidth\":\"6\",\"seedComponents\":[]}]}",
