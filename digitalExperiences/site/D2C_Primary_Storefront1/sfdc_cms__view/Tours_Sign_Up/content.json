            "sectionColumnGutterWidth" : "",
            "sectionConfig" : "{\"UUID\":\"ce08da57-ce83-4d55-8e00-491ac4d59b73\",\"columns\":[{\"UUID\":\"d6b5257b-cca0-49f7-95e5-57ec337d00b5\",\"columnName\":\"Column 1\",\"columnKey\":\"col1\",\"columnWidth\":\"12\",\"seedComponents\":[]}]}",
