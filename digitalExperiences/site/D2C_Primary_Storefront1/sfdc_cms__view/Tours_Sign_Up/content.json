          "children" : [ {
            "children" : [ {
              "attributes" : {
                "dxpStyle" : { },
                "imageInfos" : "",
                "richTextValue" : "<p style=\"text-align: center;\"><span style=\"font-family: georgia;\">A few things to note before submitting your tour reservation request: </span></p><p style=\"text-align: center;\"><br></p><ul><li style=\"text-align: center;\"><span style=\"font-family: georgia;\">Reservations are required to ensure we can provide you with the best possible experience. </span></li><li style=\"text-align: center;\"><span style=\"font-family: georgia;\">Submitting the form indicates your interest but does not guarantee a reservation. </span></li><li style=\"text-align: center;\"><span style=\"font-family: georgia;\">Once submitted, we will contact you within 3-5 business days to confirm guide availability. </span></li><li style=\"text-align: center;\"><span style=\"font-family: georgia;\">Tours are scheduled on a first-come, first-served basis, so keep an eye on your inbox for confirmation.</span></li></ul><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><strong><u>* Tours offered May thru September, Mon-Fri. (except public holidays)9:30am - 3:00pm (CST).</u></strong></p><p style=\"text-align: center;\"><strong><u>Reservations made 1 week in advance is appreciated.</u></strong></p><p style=\"text-align: center;\"><strong style=\"font-family: georgia;\"><u>﻿</u></strong></p><p style=\"text-align: center;\"><span style=\"font-family: georgia;\">Please complete all required fields to help us prepare for your visit</span></p>"
              },
