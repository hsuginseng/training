            "sectionColumnGutterWidth" : "",
            "sectionConfig" : "{\"UUID\":\"7c2ef1d6-0420-4ca0-bd0e-42e89895bbc4\",\"columns\":[{\"UUID\":\"09c9165e-6c2e-49b9-8101-c1310d045090\",\"columnName\":\"Column 1\",\"columnKey\":\"col1\",\"columnWidth\":\"12\",\"seedComponents\":[]}]}",
