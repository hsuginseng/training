aLayer','GTM-NFT5LV3');</script>\n<!-- End Google Tag Manager -->\n\n<script>\n    window.addEventListener(\"load\", function() {\n\n        document.addEventListener(\"fullwidthpagerequest\", function () {\n            const pollData = async () => {\n                let section = document.querySelector(\"community_layout-section\");\n                if (section) {\n                    section.style.setProperty(\"padding\", \"unset\", \"important\");\n                } else {\n                    console.warn(\"Element not found!\");\n                    setTimeout(pollData, 50);\n                }\n            };\n            pollData();\n        });\n\n\n        \n        const pollData3 = async () => {\n            let localeButtons = document.querySelectorAll('commerce_builder-country-picker-v2 span.button-content');\n            try {\n                if(localeButtons){\n                localeButtons.forEach(localeButton => {\n                    try {\n                        if(localeButton.innerText == 'United States | EN'){ localeButton.innerText = 'US | EN'; }\n                        else if(localeButton.innerText == '中国 | ZH'){ localeButton.innerText = '简体中文'; }\n                        else if(localeButton.innerText == '台灣 | ZH'){ localeButton.innerText = '繁體中文'; }\n                    } catch(err){\n                        //Error occurred while overriding language display text\n                        setTimeout(pollData3, 50);\n                    }\n                });\n                } else {\n                    setTimeout(pollData3, 50);\n                }\n            } catch(err){\n\t\t\t\tsetTimeout(pollData3, 50);\n                //Error occurred while overriding language display text\n            }\n        };\n        pollData3();\n        \n\n        const pollData2 = async () => {\n            let localeOverrideMap = {\n                        'United States | EN - USD': 'English', //English\n                        'China | ZH - USD': '简体中文', //English\n                        'Chinese Taipei | ZH - USD': '繁體中文', //English\n                        '美国 | EN - USD': 'English', //Mandarin Traditional\n                        '中国 | ZH - USD': '简体中文', //Mandarin Traditional\n                        '台湾 | ZH - USD': '繁體中文', //Mandarin Traditional\n                        '美國 | EN - USD': 'English', //Mandarin Simplified\n                        '中國 | ZH - USD': '简体中文', //Mandarin Simplified\n                        '台灣 | ZH - USD': '繁體中文' //Mandarin Simplified\n            }\n            let locales = document.querySelectorAll('.locale-country');\n            try {\n                if(locales){\n                    locales.forEach(locale => {\n                        let currOverride = localeOverrideMap[locale.innerText];\n                        locale.innerText = currOverride;\n                    });\n                } else {\n                    setTimeout(pollData2, 50);\n                }\n            } catch(err){\n\t\t\t\tsetTimeout(pollData2, 50);\n                //Error occurred while overriding language display text\n            }\n        };\n        pollData2();\n    });\n</script>\n\n<style>\n    \n    .free-shipping-banner {\n        @media only screen and (max-width: 1024px) {\n        \tdiv, p {\n                justify-self: anchor-center;\n                position: fixed;\n                top: 130px;\n                z-index: 1;\n            }\n            \n            p {\n\t\t\t\tcolor: var(--dxp-s-button-color-contrast, #fff) !important;\n\t\t\t\tfont-size: .75rem;\n                max-width: 75%;\n            }\n        }\n        \n        @media only screen and (min-width: 1024px) {\n            div { margin-left: 2rem; }\n        }\n\n        p {\n            text-decoration:underline;\n            text-align: center;\n            color: rgb(75,75,75);\n            font-size: .875rem;\n            font-weight: 500;\n            letter-spacing: .0125em;\n            text-transform: uppercase;\n        }\n    }\n    \n    .country-picker-styling_header {\n        width: fit-content !important;\n        padding-left: 1rem;\n        \n        commerce-action-button button {\n            max-width: 5rem;\n        }\n        \n        commerce-country-picker-grid {\n            .locale-flag {\n                display: none;\n            }\n        }\n    }\n    \n\t.country-picker-styling_footer {\n        width: unset !important;\n        padding-left: 1rem;\n        \n        commerce-action-button button {\n            max-width: 5rem;\n        }\n        \n        commerce-country-picker-grid {\n            .locale-flag {\n                display: none;\n            }\n        }\n    }\n\n    \n    .mini-cart-styling {\n        commerce_cart-mini-cart-panel .items,\n        .slds-popover_prompt .items {\n            min-width: 520px !important;\n            transition: width 0.3s ease-out !important;\n        }\n\n        commerce_cart-mini-cart-panel {\n\t        z-index: 1 !important;\n        }\n        \n        h2 {\n            font-size: var(--dxp-s-body-font-size, 1.125rem) !important;\n        }\n        \n        button > lightning-icon { width: max-content; }\n    }\n    \n    .header-split-spacing-override {\n        .header-search-drawer { z-index: 1 !important; }\n        \n        div.header-search {\n\t        @media only screen and (max-width: 768px) {\n                padding-top: unset;\n            }\n        }\n    }\n\n    webruntime-component-container.component-wrapper-spacer {\n        &:has(.header-split-spacing-override) {\n        \tmargin-bottom: unset;\n        }\n    }\n\n    .mega-menu-navigation {\n        background: var(--dxp-g-brand) !important;\n\n        nav {\n\t\t\theight: 4rem;\n            \n            ul {\n                gap: 3rem;\n            }\n            \n            button.exp-mobile-mega-menu__hamburger-button {\n                height: 100%;\n\n                svg {\n                    margin-left: var(--dxp-g-spacing-medium, 1rem);\n                    fill: var(--slds-c-button-text-color, #fff) !important;\n                }\n            }\n        }\n        \n        nav.exp-mega-menu {\n            justify-content: center !important;\n        }\n        \n        nav > ul.exp-mega-menu__nav-bar {\n            background: unset !important;\n            \n            li.slds-grid > a, li.slds-grid > button {\n                font-family: \"Acumin VF\", sans-serif !important;\n                color: var(--slds-c-button-text-color, #fff) !important;\n                font-size: 1rem !important;\n                font-weight: 400 !important;\n                line-height: 1.5 !important;\n                text-transform: uppercase !important;\n            }\n            \n            li.slds-grid > div.exp-mega-menu__nav-content-container ul {\n                gap: 0rem !important;\n            }\n\n        }\n    }\n    \n    .footer-link-list-override {\n        commerce-link-list > ul > li.is-leaf {\n            padding-top: var(--slds-g-spacing-1, .25rem) !important;\n            padding-bottom: var(--slds-g-spacing-1, .25rem) !important;\n        }\n    }\n    \n    .header-badge-icons-flex { align-items: unset !important; }\n\n\n</style>\n\n<!-- Meta Pixel Code -->\n<script>\n  !(function (f, b, e, v, n, t, s) {\n    if (f.fbq) return;\n    n = f.fbq = function () {\n      n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);\n    };\n\n    if (!f._fbq) f._fbq = n;\n    n.push = n;\n    n.loaded = !0;\n    n.version = \"2.0\";\n\n    n.queue = [];\n    t = b.createElement(e);\n    t.async = !0;\n\n    t.src = v;\n    s = b.getElementsByTagName(e)[0];\n\n    s.parentNode.insertBefore(t, s);\n  })(\n    window,\n    document,\n    \"script\",\n\n    \"https://connect.facebook.net/en_US/fbevents.js\",\n  );\n\n  fbq(\"init\", \"539075106649592\");\n\n  fbq(\"track\", \"PageView\");\n</script>\n<noscript\n  ><img\n    height