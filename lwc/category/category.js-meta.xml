<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Category Page - Main</masterLabel>
    <description>...</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property label="Title" name="title" type="String" 
                description="" translatable="true"/>
            <property label="Display Text" name="text" type="String" 
                description="" translatable="true"/>
            <property label="Image Alternate Text" name="imageAlt" type="String" 
                description="" translatable="true"/>
            <property label="Image Link" name="imageUrl" type="String" 
                description="" translatable="false"/>

            <property label="Action Label - Filters" name="actionLabelFilters" type="String" 
                description="" translatable="true"/>
            <property label="Action Label - Sort By" name="actionLabelSortBy" type="String" 
                description="" translatable="true"/>
            <property label="Action Label - Next Page" name="actionLabelNextPage" type="String" 
                description="" translatable="true"/>
            <property label="Action Label - Previous Page" name="actionLabelPreviousPage" type="String"
                description="" translatable="true"/>
            
            <property label="Filter Modal Action Label - Apply Filters" name="filterModalActionLabelApplyFilters" type="String"
                description="" translatable="true"/>
            <property label="Filter Modal Action Label - Clear Filters" name="filterModalActionLabelClearFilters" type="String"
                description="" translatable="true"/>
            
            <property label="Card Label - Options Sub-label" name="cardSubLabelNumOptions" type="String" translatable="true"
                description="The text that will display within a product card beside the number of options for a parent product with variations."/>
            <property label="CTA Text - Add To Cart" name="ctaTextAddToCart" type="String" translatable="true"
                description="The text that will display within an 'Add to Cart' CTA Button."/>
            <property label="CTA Text - See Details" name="ctaTextSeeDetails" type="String" translatable="true"
                description="The text that will display within an 'See Details' CTA Button."/>
            <property label="CTA Text - Out Of Stock" name="ctaTextOutOfStock" type="String" translatable="true"
                description="The text that will display when a product is out of stock."/>
            <property label="CTA Text - No More Available" name="ctaTextNoMoreAvailable" type="String" translatable="true"
                    default="No More Available"
                    description="CTA label shown when the shopper has already added all available stock of this product to their cart."/>
            <property label="Category Id" name="selectedCategoryId" type="String" description="" translatable="false"/>
            <property label="Total Results" name="totalResults" type="String" translatable="false"
                description="Use the value provider '{!Search.Results.total}'."/>
            <property label="Results Per Page" name="resultsPerPage" type="String" translatable="false" 
                description="Use the value provider '{!Search.Results.pageSize}'."/>
            <property label="Current Page Number" name="currentPageNumber" type="String" translatable="false" 
                description="Use the value provider '{!Search.Pagination.currentPage}'."/>
            <property label="Is Loading" name="isLoading" type="String" translatable="false"
                description="Use the value provider '{!Search.ClientState.loading}'."/>
            <property label="Product Card Data" name="productCardCollection" translatable="false"
                description="Use the value provider '{!Search.Results.cardCollection}'." type="String"></property>
            <property label="Sort Rules" name="sortRules" translatable="false"
                description="Use the value provider '{!Search.SortRules}'." type="String"></property>
            <property label="Filter Results" name="filterResults" translatable="false"
                description="Use the value provider '{!Search.Results}'." type="String"></property>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>