<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">

            <property
                name="label"
                type="String"
                label="File Uploader Label"
                description="The label displayed above the file uploader."
                role="inputOnly"
                default="Upload Attachments"/>

            <property
                name="contentDocumentIds"
                type="String[]"
                label="Content Document IDs"
                description="A collection of ContentDocument IDs from the uploaded files."
                role="outputOnly"/>

        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>