<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This flow modifies the class of service field to match the name of the cart delivery group method. This flow also removes the minimum delivery estimate number. The goal of these two modifications is to ensure the best UI experience on the D2C order confirmation page.</description>
    <environments>Default</environments>
    <interviewLabel>Cart Delivery Group Method - Modify Name and Remove Minimum Delivery Estimate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Cart Delivery Group Method - Modify Class of Service Delivery Estimate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>This method replaces the class of service with the name of the cart delivery group method. This also removes the minimum transit time estimate. These two fields currently make the D2C order confirmation page&apos;s shipping estimates appear improperly.</description>
        <name>Update_Cart_Delivery_Group_Method</name>
        <label>Update Cart Delivery Group Method</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ClassOfService</field>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TransitTimeMin</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Cart_Delivery_Group_Method</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Name</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>TransitTimeMin</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>CartDeliveryGroupMethod</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
