        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LeadSource</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>D2C English</stringValue>
            </value>
        </filters>
        <object>Lead</object>
