        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <textTemplates>
        <name>TourFormSubmissionBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 8.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;The following form submission has been recorded from the D2C English Site:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 8.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Full Name: {!$Record.Name}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 8.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Email: {!$Record.Email}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 8.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Phone: {!$Record.Phone}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 8.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Preferred Tour Date: {!$Record.Preferred_Tour_Date__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 8.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Preferred Tour Time: {!$Record.Preferred_Tour_Time__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 8.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Number of Guests: {!$Record.Number_of_Guests__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 8.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Age Range of Guests: {!$Record.Age_Range_of_Guests__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 8.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Special Accommodations: {!$Record.Special_Accommodations__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 8.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;How did you hear about our tour?: {!$Record.How_did_you_hear_about_our_tour__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 8.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;If Other, Please Specify: {!$Record.If_Other_please_specify__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 8.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Email Opt In: {!$Record.Email_Opt_In__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 8.5pt; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Click on the link to access the Record directly: {!$Record.Id}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
