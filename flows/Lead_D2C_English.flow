    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Decision_Lead_Source</name>
        <label>Decision - Lead Source</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>D2C_English_Contact_Us</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>D2C English - Contact Us</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Contact_Us_Submission_Email</targetReference>
            </connector>
            <label>D2C English - Contact Us</label>
        </rules>
        <rules>
            <name>D2C_English_Tour_Form_Submission</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LeadSource</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>D2C English - Tour Form Submission</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_Action_1</targetReference>
            </connector>
            <label>D2C English - Tour Form Submission</label>
        </rules>
    </decisions>
    <environments>Default</environments>
