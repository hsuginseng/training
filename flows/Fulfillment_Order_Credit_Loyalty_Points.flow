            </connector>
            <label>Found Member</label>
        </rules>
    </decisions>
    <decisions>
        <name>Redeemed_Referral_Points</name>
        <label>Redeemed Referral Points?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Transaction_Journal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>N/A</defaultConnectorLabel>
        <rules>
            <name>Did_not_Redeem_Points_Yet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.Referred_By_Code_Loyalty_Member__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account.Redeemed_Referral_Points__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Transaction_Journal_Extra_100_points</targetReference>
            </connector>
            <label>Did not Redeem Points Yet</label>
        </rules>
    </decisions>
    <decisions>
        <name>Referred_By_Loyalty_Member</name>
        <label>Referred By Loyalty Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Referred</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Referred_By_Loyalty_Member</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Transaction_Journal_for_Referred_By_Member</targetReference>
            </connector>
            <label>Referred</label>
        </rules>
    </decisions>
    <description>AKW - Changed the points calculation to a multiplier of 100 instead of 1.
JN - Initial flow creation to credit loyalty points when the order has been fulfilled
JN - Changing the points calculation back to a multiplier of 1
JN - Changing the points multiplier back to 10</description>
    <environments>Default</environments>
    <formulas>
        <name>fxTotalPoints</name>
        <dataType>Number</dataType>
        <expression>{!varQualifyingTotal} * 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxTotalPointsAndReferral</name>
        <dataType>Number</dataType>
        <expression>{!fxTotalPoints} + 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxYearFromToday</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 365</expression>
    </formulas>
    <formulas>
        <name>fxYearFromTodayString</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR({!fxYearFromToday})) +
&apos;-&apos; +
IF(MONTH({!fxYearFromToday}) &lt; 10, &apos;0&apos; + TEXT(MONTH({!fxYearFromToday})), TEXT(MONTH({!fxYearFromToday}))) +
&apos;-&apos; +
IF(DAY({!fxYearFromToday}) &lt; 10, &apos;0&apos; + TEXT(DAY({!fxYearFromToday})), TEXT(DAY({!fxYearFromToday})))</expression>
    </formulas>
    <interviewLabel>Fulfillment Order - Credit Loyalty Points {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fulfillment Order - Credit Loyalty Points</label>
    <loops>
        <name>Loop_Thru_Order_Items</name>
        <label>Loop Thru Order Items</label>
        <locationX>0</locationX>
