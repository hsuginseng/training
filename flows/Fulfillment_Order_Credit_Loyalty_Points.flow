    <assignments>
        <name>Add_to_Qualifying_Total</name>
        <label>Add to Qualifying Total</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varQualifyingTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Thru_Order_Items.TotalPrice</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Thru_Order_Items</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Product_Eligibility</name>
        <label>Check Product Eligibility</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Thru_Order_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Product_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Thru_Order_Items.Product2.Loyalty_Eligible__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Product_Category_Product_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_to_Qualifying_Total</targetReference>
            </connector>
            <label>Product Eligible</label>
        </rules>
    </decisions>
