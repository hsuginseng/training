        <inputAssignments>
            <field>Voucher__c</field>
            <value>
                <elementReference>Issue_Voucher.VoucherId</elementReference>
            </value>
        </inputAssignments>
        <object>Coupon</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Transaction_Journal</name>
