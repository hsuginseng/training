<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <actionCalls>
        <name>Issue_Voucher</name>
        <label>Issue Voucher</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>issueVoucher</actionName>
        <actionType>issueVoucher</actionType>
        <connector>
            <targetReference>Create_Coupon</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>ProgramName</name>
            <value>
                <elementReference>Get_Loyalty_Program.Name</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>LoyaltyProgramMemberId</name>
            <value>
                <elementReference>Get_Loyalty_Program_Member.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>VoucherDefinitionName</name>
            <value>
                <stringValue>Custom Voucher</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>PromotionId</name>
            <value>
                <elementReference>Get_Promotion.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>EffectiveDate</name>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>FaceValue</name>
            <value>
                <elementReference>fxPositiveAdjustmentInput</elementReference>
            </value>
        </inputParameters>
        <nameSegment>issueVoucher</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_noPointsBalance_to_True</name>
        <label>Set noPointsBalance to True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>noPointsBalance</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>No_cart_Items_found</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Redeemable_Item</name>
        <label>Set Redeemable Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varRedeemableCartItems</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Thru_Cart_Items</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>redeemableProductTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Thru_Cart_Items.TotalPriceAfterAllAdjustments</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Thru_Cart_Items</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Has_Loyalty_Point_Balance</name>
        <label>Has Loyalty Point Balance</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_noPointsBalance_to_True</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Points</defaultConnectorLabel>
        <rules>
            <name>Has_Points</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxPointsBalance</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Points_Balance_Screen</targetReference>
            </connector>
            <label>Has Points</label>
        </rules>
    </decisions>
    <decisions>
        <name>Product_Redeemable</name>
        <label>Product Redeemable?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Thru_Cart_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Redeemable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Thru_Cart_Items.Product2.Loyalty_Redeemable__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Redeemable_Item</targetReference>
            </connector>
            <label>Is Redeemable</label>
        </rules>
    </decisions>
    <decisions>
        <name>Redeemable_Items_Found</name>
        <label>Redeemable Items Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_cart_Items_found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Found_Items</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>varRedeemableCartItems</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varRedeemableCartItem.TotalPromoAdjustmentAmount</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>varRedeemableCartItem.TotalPromoAdjustmentAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Has_Loyalty_Point_Balance</targetReference>
            </connector>
            <label>Found Items</label>
        </rules>
    </decisions>
    <decisions>
        <name>User_found</name>
        <label>User found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_cart_Items_found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Decision_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Loyalty_Program</targetReference>
            </connector>
            <label>User found?</label>
        </rules>
    </decisions>
    <description>This flow allows users of the D2C store to redeem loyalty points on the checkout page.</description>
    <dynamicChoiceSets>
        <name>pcsPointsRedeemed</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Points_Redeemed__c</picklistField>
        <picklistObject>Voucher</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fxAdjustmentInput</name>
        <dataType>Currency</dataType>
        <expression>{!How_many_points_would_you_like_to_redeem} / (-100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxCurrentRecordId</name>
        <dataType>String</dataType>
        <expression>{!$Flow.CurrentRecord}</expression>
    </formulas>
    <formulas>
        <name>fxMaxAdjustment</name>
        <dataType>Number</dataType>
        <expression>IF(({!redeemableProductTotal}) &gt; ({!fxPointsBalance} / 100), -1*({!fxPointsBalance} / 100), -1*({!redeemableProductTotal}) )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxMaxPoints</name>
        <dataType>Number</dataType>
        <expression>{!fxMaxAdjustment}*-100</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxNowText</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Flow.CurrentDateTime})</expression>
    </formulas>
    <formulas>
        <name>fxPointsBalance</name>
        <dataType>Number</dataType>
        <expression>{!Get_Loyalty_Member_Currency.PointsBalance}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxPositiveAdjustmentInput</name>
        <dataType>Currency</dataType>
        <expression>{!fxAdjustmentInput} * (-1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxPositiveMaxAdjustment</name>
        <dataType>Currency</dataType>
        <expression>{!fxMaxAdjustment}*(-1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxPromotionName</name>
        <dataType>String</dataType>
        <expression>&apos;Loyalty Points - &apos; + {!varVoucherDefinition.Name}</expression>
    </formulas>
    <formulas>
        <name>fxRemainingPoints</name>
        <dataType>Number</dataType>
        <expression>{!fxPointsBalance} - {!How_many_points_would_you_like_to_redeem}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxYearFromNow</name>
        <dataType>DateTime</dataType>
        <expression>ADDMONTHS({!$Flow.CurrentDateTime},12)</expression>
    </formulas>
    <interviewLabel>D2C Checkout: Redeem Loyalty Points {!$Flow.CurrentDateTime}</interviewLabel>
    <label>D2C Checkout: Redeem Loyalty Points</label>
    <loops>
        <name>Loop_Thru_Cart_Items</name>
        <label>Loop Thru Cart Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Cart_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Product_Redeemable</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Redeemable_Items_Found</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Coupon</name>
        <label>Create Coupon</label>
        <locationX>0</locationX>
