            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PromotionId</field>
            <value>
                <elementReference>Get_Promotion.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RedemptionLimitAllBuyers</field>
            <value>
