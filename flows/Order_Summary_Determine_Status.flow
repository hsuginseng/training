<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>hasFulfillments_True</name>
        <label>hasFulfillments = True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>hasFulfillments</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Over_Order_Product_Summaries</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>isPaid_True</name>
        <label>isPaid = True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>isPaid</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Determine_Order_Summary_Status</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Pass_orderSummaryInput_To_orderSummaryOutput</name>
        <label>Pass orderSummaryInput To orderSummaryOutput</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>orderSummaryOutput.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>orderSummaryInput.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>orderSummaryOutput.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>orderSummaryInput.Status</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_orderSummaryOutput_Completed</name>
        <label>Set orderSummaryOutput Completed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>orderSummaryOutput.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>orderSummaryInput.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>orderSummaryOutput.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_orderSummaryOutput_Fulfilled</name>
        <label>Set orderSummaryOutput Fulfilled</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>orderSummaryOutput.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>orderSummaryInput.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>orderSummaryOutput.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Fulfilled</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_orderSummaryOutput_Partial_Fulfillment</name>
        <label>Set orderSummaryOutput Partial Fulfillment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>orderSummaryOutput.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>orderSummaryInput.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>orderSummaryOutput.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Partially Fulfilled</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Status_Partial_Fulfillment</name>
        <label>Status = Partial Fulfillment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>isPartialFulfill</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Over_Order_Product_Summaries</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Check the Order Summary&apos;s Balance Due field. This will determine if the order is fully paid.</description>
        <name>Check_Balance_Due</name>
        <label>Check Balance Due</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Determine_Order_Summary_Status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Outstanding Balance</defaultConnectorLabel>
        <rules>
            <name>Fully_Paid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>orderSummaryInput.Balance_Due__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>isPaid_True</targetReference>
            </connector>
            <label>Fully Paid</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Order_Product_Summary_Status</name>
        <label>Check Order Product Summary Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Over_Order_Product_Summaries</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Fulfilled</defaultConnectorLabel>
        <rules>
            <name>Fulfilled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Order_Product_Summaries.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FULFILLED</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>hasFulfillments_True</targetReference>
            </connector>
            <label>Fulfilled</label>
        </rules>
        <rules>
            <name>Partial_Fulfillment</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Over_Order_Product_Summaries.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ORDERED</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Over_Order_Product_Summaries.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ALLOCATED</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Over_Order_Product_Summaries.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PARTIALLYALLOCATED</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Over_Order_Product_Summaries.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PARTIALLYFULFILLED</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Status_Partial_Fulfillment</targetReference>
            </connector>
            <label>Partial Fulfillment</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Order_Summary_Status</name>
        <label>Determine Order Summary Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Pass_orderSummaryInput_To_orderSummaryOutput</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Status</defaultConnectorLabel>
        <rules>
            <name>Completed_OS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>hasFulfillments</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isPartialFulfill</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isPaid</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_orderSummaryOutput_Completed</targetReference>
            </connector>
            <label>Completed OS</label>
        </rules>
        <rules>
            <name>Fulfilled_OS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>hasFulfillments</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isPartialFulfill</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_orderSummaryOutput_Fulfilled</targetReference>
            </connector>
            <label>Fulfilled OS</label>
        </rules>
        <rules>
            <name>Partially_Fulfilled_OS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>hasFulfillments</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isPartialFulfill</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_orderSummaryOutput_Partial_Fulfillment</targetReference>
            </connector>
            <label>Partially Fulfilled OS</label>
        </rules>
    </decisions>
    <description>Given an order summary object input, determine the status to set for the record.</description>
    <environments>Default</environments>
    <interviewLabel>Order Summary - Determine Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order Summary - Determine Status</label>
    <loops>
        <description>Determine if each line item is fulfilled. Use this information to drive status logic later in the flow.</description>
        <name>Loop_Over_Order_Product_Summaries</name>
        <label>Loop Over Order Product Summaries</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Order_Product_Summaries</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Order_Product_Summary_Status</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_Balance_Due</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get all order product summaries to check their statuses.</description>
        <name>Get_Order_Product_Summaries</name>
        <label>Get Order Product Summaries</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Over_Order_Product_Summaries</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderSummaryId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>orderSummaryInput.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OrderItemSummary</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Order_Product_Summaries</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>hasFulfillments</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>isPaid</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>A boolean that flags an order as partially fulfilled, shortcuts the automation.</description>
        <name>isPartialFulfill</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>orderSummaryInput</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>OrderSummary</objectType>
    </variables>
    <variables>
        <name>orderSummaryOutput</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>OrderSummary</objectType>
    </variables>
</Flow>
