    <customErrors>
        <name>Payment_Type_not_Supported</name>
        <label>Payment Type not Supported</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Error creating cash entry! The payment type: {!$Record.Payment_Type__c} is not supported.</errorMessage>
