    <decisions>
        <name>Determine_Payment_Method_Type</name>
        <label>Determine Payment Method Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Payment_Type_not_Supported</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unsupported Type</defaultConnectorLabel>
        <rules>
            <name>Cash</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Payment_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cash</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Rec_Type_as_Cash</targetReference>
            </connector>
            <label>Cash</label>
        </rules>
        <rules>
            <name>Check</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Payment_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Check</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Rec_Type_as_Check</targetReference>
            </connector>
            <label>Check</label>
        </rules>
        <rules>
            <name>Venmo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Payment_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Venmo</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Rec_Type_as_Venmo</targetReference>
            </connector>
            <label>Venmo</label>
        </rules>
        <rules>
            <name>Zelle</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Payment_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Zelle</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Rec_Type_as_Zelle</targetReference>
            </connector>
            <label>Zelle</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_OPS_Exist</name>
        <label>Does OPS Exist</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Payment_Group</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No OPS</defaultConnectorLabel>
        <rules>
            <name>OPS_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_OPS.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Payment</targetReference>
            </connector>
            <label>OPS Exist</label>
        </rules>
    </decisions>
    <description>Creates an Order Payment Summary whenever a Cash Entry record is created. This will allow Order Management to properly process RMA Returns.</description>
    <environments>Default</environments>
    <formulas>
        <description>This calculates the gatewayReferenceNumber for the payment gateway log.</description>
        <name>gatewayReferenceNumber</name>
        <dataType>String</dataType>
        <expression>&quot;OFFLINE-CAP-&quot; &amp; {!$Record.Id}</expression>
    </formulas>
    <formulas>
        <description>Calculated name for the Order Payment Summary</description>
        <name>OPSName</name>
        <dataType>String</dataType>
        <expression>&apos;OPS - &apos; + {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <description>Error message for creating a process exception.</description>
        <name>ProcessExceptionMessage</name>
        <dataType>String</dataType>
        <expression>&apos;ERROR! Cash Entry payment creation failed for: &apos; + {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>requestExistingOPS</name>
        <dataType>String</dataType>
        <expression>&quot;{\&quot;interactionType\&quot;:\&quot;OfflineCapture\&quot;,\&quot;amount\&quot;:&quot; &amp; TEXT({!Create_Payment_OPS.Amount}) &amp; &quot;,\&quot;paymentId\&quot;:\&quot;&quot; &amp; {!Create_Payment_OPS.Id} &amp; &quot;\&quot;,\&quot;paymentGroupId\&quot;:\&quot;&quot; &amp; BLANKVALUE({!Create_Payment_OPS.PaymentGroupId},&quot;&quot;) &amp; &quot;\&quot;,\&quot;paymentMethodId\&quot;:\&quot;&quot; &amp; BLANKVALUE({!Create_Payment_OPS.PaymentMethodId},&quot;&quot;) &amp; &quot;\&quot;,\&quot;accountId\&quot;:\&quot;&quot; &amp; BLANKVALUE({!Create_Payment_OPS.AccountId},&quot;&quot;) &amp; &quot;\&quot;,\&quot;effectiveDate\&quot;:\&quot;&quot; &amp; TEXT({!Create_Payment_OPS.EffectiveDate}) &amp; &quot;\&quot;,\&quot;recordedAt\&quot;:\&quot;&quot; &amp; TEXT(NOW()) &amp; &quot;\&quot;,\&quot;recordedBy\&quot;:\&quot;&quot; &amp; {!$User.Username} &amp; &quot;\&quot;,\&quot;source\&quot;:\&quot;CashEntry\&quot;,\&quot;note\&quot;:\&quot;Offline payment recorded; funds collected outside Salesforce.\&quot;}&quot;</expression>
    </formulas>
    <formulas>
        <name>requestNoOPS</name>
        <dataType>String</dataType>
        <expression>&quot;{\&quot;interactionType\&quot;:\&quot;OfflineCapture\&quot;,\&quot;amount\&quot;:&quot; &amp; TEXT({!Create_Payment_No_OPS.Amount}) &amp; &quot;,\&quot;paymentId\&quot;:\&quot;&quot; &amp; {!Create_Payment_No_OPS.Id} &amp; &quot;\&quot;,\&quot;paymentGroupId\&quot;:\&quot;&quot; &amp; BLANKVALUE({!Create_Payment_No_OPS.PaymentGroupId},&quot;&quot;) &amp; &quot;\&quot;,\&quot;paymentMethodId\&quot;:\&quot;&quot; &amp; BLANKVALUE({!Create_Payment_No_OPS.PaymentMethodId},&quot;&quot;) &amp; &quot;\&quot;,\&quot;accountId\&quot;:\&quot;&quot; &amp; BLANKVALUE({!Create_Payment_No_OPS.AccountId},&quot;&quot;) &amp; &quot;\&quot;,\&quot;effectiveDate\&quot;:\&quot;&quot; &amp; TEXT({!Create_Payment_No_OPS.EffectiveDate}) &amp; &quot;\&quot;,\&quot;recordedAt\&quot;:\&quot;&quot; &amp; TEXT(NOW()) &amp; &quot;\&quot;,\&quot;recordedBy\&quot;:\&quot;&quot; &amp; {!$User.Username} &amp; &quot;\&quot;,\&quot;source\&quot;:\&quot;CashEntry\&quot;,\&quot;note\&quot;:\&quot;Offline payment recorded; funds collected outside Salesforce.\&quot;}&quot;</expression>
    </formulas>
    <formulas>
        <name>responseExistingOPS</name>
        <dataType>String</dataType>
        <expression>&quot;{\&quot;salesforceResultCode\&quot;:\&quot;Success\&quot;,\&quot;gatewayResultCode\&quot;:\&quot;SUCCESS\&quot;,\&quot;gatewayResultCodeDescription\&quot;:\&quot;Offline payment recorded\&quot;,\&quot;gatewayReferenceNumber\&quot;:\&quot;&quot; &amp; {!gatewayReferenceNumber} &amp; &quot;\&quot;,\&quot;amount\&quot;:&quot; &amp; TEXT({!Create_Payment_OPS.Amount}) &amp; &quot;,\&quot;paymentId\&quot;:\&quot;&quot; &amp; {!Create_Payment_OPS.Id} &amp; &quot;\&quot;,\&quot;processedAt\&quot;:\&quot;&quot; &amp; TEXT(NOW()) &amp; &quot;\&quot;,\&quot;processedBy\&quot;:\&quot;&quot; &amp; {!$User.Username} &amp; &quot;\&quot;}&quot;</expression>
    </formulas>
    <formulas>
        <name>responseNoOPS</name>
        <dataType>String</dataType>
        <expression>&quot;{\&quot;salesforceResultCode\&quot;:\&quot;Success\&quot;,\&quot;gatewayResultCode\&quot;:\&quot;SUCCESS\&quot;,\&quot;gatewayResultCodeDescription\&quot;:\&quot;Offline payment recorded\&quot;,\&quot;gatewayReferenceNumber\&quot;:\&quot;&quot; &amp; {!gatewayReferenceNumber} &amp; &quot;\&quot;,\&quot;amount\&quot;:&quot; &amp; TEXT({!Create_Payment_No_OPS.Amount}) &amp; &quot;,\&quot;paymentId\&quot;:\&quot;&quot; &amp; {!Create_Payment_No_OPS.Id} &amp; &quot;\&quot;,\&quot;processedAt\&quot;:\&quot;&quot; &amp; TEXT(NOW()) &amp; &quot;\&quot;,\&quot;processedBy\&quot;:\&quot;&quot; &amp; {!$User.Username} &amp; &quot;\&quot;}&quot;</expression>
    </formulas>
