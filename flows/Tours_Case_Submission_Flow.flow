    <environments>Default</environments>
    <formulas>
        <name>fxValidDateTime</name>
        <dataType>Boolean</dataType>
        <expression>MONTH(DATEVALUE( {!Preferred_Tour_Date_Time} )) &gt; 4 &amp;&amp; MONTH(DATEVALUE( {!Preferred_Tour_Date_Time} )) &lt; 10 &amp;&amp;
WEEKDAY(DATEVALUE( {!Preferred_Tour_Date_Time} )) != 1 &amp;&amp; 
WEEKDAY(DATEVALUE( {!Preferred_Tour_Date_Time} )) != 7 &amp;&amp; 
(
HOUR(TIMEVALUE( {!Preferred_Tour_Date_Time} )) &gt; 14
||
(HOUR(TIMEVALUE( {!Preferred_Tour_Date_Time} )) = 14 &amp;&amp; MINUTE(TIMEVALUE( {!Preferred_Tour_Date_Time} )) &gt; 29)
)
&amp;&amp;
(
HOUR(TIMEVALUE( {!Preferred_Tour_Date_Time} )) &lt; 20
||
(HOUR(TIMEVALUE( {!Preferred_Tour_Date_Time} )) = 20 &amp;&amp; MINUTE(TIMEVALUE( {!Preferred_Tour_Date_Time} )) = 0)
)</expression>
    </formulas>
    <interviewLabel>Tours Case {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>Tours Case Submission Flow</label>
