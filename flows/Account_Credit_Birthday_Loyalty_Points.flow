            <value>
                <stringValue>Non Qualifying Currency</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>ProgramName</name>
            <value>
                <stringValue>Hsu&apos;s Loyalty Program v1</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Points</name>
            <value>
                <numberValue>1000.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>JournalId</name>
            <value>
                <elementReference>Create_Transaction_Journal</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>PointsExpirationDate</name>
            <value>
                <elementReference>fxYearFromToday</elementReference>
            </value>
        </inputParameters>
        <nameSegment>creditPoints</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>(JN)(6.16) - Updating Points from 100 to 1000</description>
    <environments>Default</environments>
    <formulas>
        <name>fxYearFromToday</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 365</expression>
    </formulas>
    <interviewLabel>Account - Credit Birthday Loyalty Points {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Credit Birthday Loyalty Points</label>
    <processMetadataValues>
