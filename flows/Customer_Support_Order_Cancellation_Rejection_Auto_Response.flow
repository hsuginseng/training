<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Cancellation_Request_Rejection_Email_Alert</name>
        <label>Cancellation Request Rejection Email Alert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Case.Alert_for_Order_Cancellation_Denial</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Case.Alert_for_Order_Cancellation_Denial</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <name>Order_Cancellation_Rejection_MSimplified</name>
        <label>Order Cancellation Rejection (MSimplified)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Case.Order_Cancellation_Rejection_MSimplified</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Case.Order_Cancellation_Rejection_MSimplified</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <name>Order_Cancellation_Rejection_MTraditional</name>
        <label>Order Cancellation Rejection (MTraditional)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Case.Order_Cancellation_Rejection_MTraditional</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Case.Order_Cancellation_Rejection_MTraditional</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Null_Check_for_Email</name>
        <label>Null Check for Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Contact_Email_Address</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SuppliedEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Preferred_Language</targetReference>
            </connector>
            <label>Check Contact Email Address</label>
        </rules>
    </decisions>
    <decisions>
        <name>Preferred_Language</name>
        <label>Preferred Language</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Cancellation_Request_Rejection_Email_Alert</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>English</defaultConnectorLabel>
        <rules>
            <name>Traditional_Mandarin</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Preferred_Language__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Traditional Mandarin</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Order_Cancellation_Rejection_MTraditional</targetReference>
            </connector>
            <label>Traditional Mandarin</label>
        </rules>
        <rules>
            <name>Simplified_Mandarin</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Preferred_Language__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Simplified Mandarin</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Order_Cancellation_Rejection_MSimplified</targetReference>
            </connector>
            <label>Simplified Mandarin</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Customer Support Order Cancellation Rejection Auto-Response {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Customer Support Order Cancellation Rejection Auto-Response</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Null_Check_for_Email</targetReference>
        </connector>
        <filterFormula>ISPICKVAL({!$Record.Cancellation_Status__c}, &apos;Rejected&apos;)</filterFormula>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
