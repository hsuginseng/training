<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>PrepareFulfillmentItemAdjustmentRecord</name>
        <label>Prepare Fulfillment Item Adjustment Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemAdjustmentRecord</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>blankFulfillmentItemAdjustmentRecord</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemAdjustmentRecord.FulfillmentOrderId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.FulfillmentOrderId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemAdjustmentRecord.FulfillmentOrderLineItemId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemAdjustmentRecord.OrderItemAdjustLineSummaryId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>OrderLineItemAdjustmentLoop.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemAdjustmentRecord.Amount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>OrderLineItemAdjustmentLoop.Amount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemAdjustmentRecord.TotalAmtWithTax</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>OrderLineItemAdjustmentLoop.TotalAmtWithTax</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemAdjustmentRecord.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>OrderLineItemAdjustmentLoop.Description</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createFulfillmentItemAdjustmentCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>bufferFulfillmentItemAdjustmentRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>OrderLineItemAdjustmentLoop</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>PrepareFulfillmentItemTaxRecord</name>
        <label>Prepare Fulfillment Item Tax Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemTaxRecord</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>blankFulfillmentItemTaxRecord</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemTaxRecord.FulfillmentOrderId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.FulfillmentOrderId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemTaxRecord.FulfillmentOrderLineItemId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemTaxRecord.FulfillmentOrderItemAdjustId</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemTaxRecord.OrderItemTaxLineItemSummaryId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>OrderLineItemTaxLoop.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemTaxRecord.Amount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>OrderLineItemTaxLoop.Amount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemTaxRecord.TaxEffectiveDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>OrderLineItemTaxLoop.TaxEffectiveDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemTaxRecord.Rate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>OrderLineItemTaxLoop.Rate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemTaxRecord.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>OrderLineItemTaxLoop.Type</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferFulfillmentItemTaxRecord.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>OrderLineItemTaxLoop.Description</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createFulfillmentItemTaxCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>bufferFulfillmentItemTaxRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>OrderLineItemTaxLoop</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <interviewLabel>One time Update Fulfillment Order Item {!$Flow.CurrentDateTime}</interviewLabel>
    <label>One time Update Fulfillment Order Item</label>
    <loops>
        <name>OrderLineItemAdjustmentLoop</name>
        <label>Order Line Item Adjustment Loop</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>RelatedOrderLineItemAdjustments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>PrepareFulfillmentItemAdjustmentRecord</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>CreateFulfillmentItemTaxRecords</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>OrderLineItemTaxLoop</name>
        <label>Order Line Item Tax Loop</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>RelatedOrderLineItemTaxRecords</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>PrepareFulfillmentItemTaxRecord</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>OrderLineItemAdjustmentLoop</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>CreateFulfillmentItemAdjustmentRecords</name>
        <label>Create Fulfillment Item Adjustment Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>createFulfillmentItemAdjustmentCollection</inputReference>
    </recordCreates>
    <recordCreates>
        <name>CreateFulfillmentItemTaxRecords</name>
        <label>Create Fulfillment Item Tax Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CreateFulfillmentItemAdjustmentRecords</targetReference>
        </connector>
        <inputReference>createFulfillmentItemTaxCollection</inputReference>
    </recordCreates>
    <recordLookups>
        <name>RelatedOrderLineItemAdjustments</name>
        <label>Related Order Line Item Adjustments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>RelatedOrderLineItemTaxRecords</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderItemSummaryId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OrderItemSummaryId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OrderItemAdjustmentLineSummary</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>RelatedOrderLineItemTaxRecords</name>
        <label>Related Order Line Item Tax Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>OrderLineItemTaxLoop</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderItemSummaryId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OrderItemSummaryId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OrderItemTaxLineItemSummary</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>RelatedOrderLineItemAdjustments</targetReference>
        </connector>
        <filterFormula>AND(
    NOT(ISBLANK({!$Record.CreatedDate})),
    {!$Record.CreatedDate} &gt;= DATETIMEVALUE(&quot;2026-08-24 00:00:00&quot;),
    {!$Record.CreatedDate} &lt;= DATETIMEVALUE(&quot;2026-09-24 20:30:00&quot;),
    {!$Record.CreatedBy.Email} != &quot;alaa.okby@bryantparkconsulting.com&quot;
)</filterFormula>
        <object>FulfillmentOrderLineItem</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>blankFulfillmentItemAdjustmentRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FulfillmentOrderItemAdjustment</objectType>
    </variables>
    <variables>
        <name>blankFulfillmentItemTaxRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FulfillmentOrderItemTax</objectType>
    </variables>
    <variables>
        <name>bufferFulfillmentItemAdjustmentRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FulfillmentOrderItemAdjustment</objectType>
    </variables>
    <variables>
        <name>bufferFulfillmentItemTaxRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FulfillmentOrderItemTax</objectType>
    </variables>
    <variables>
        <name>createFulfillmentItemAdjustmentCollection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FulfillmentOrderItemAdjustment</objectType>
    </variables>
    <variables>
        <name>createFulfillmentItemTaxCollection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FulfillmentOrderItemTax</objectType>
    </variables>
</Flow>
