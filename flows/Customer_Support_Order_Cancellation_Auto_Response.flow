    </actionCalls>
    <actionCalls>
        <name>Order_Cancellation_Confirmation_MSimplified</name>
        <label>Order Cancellation Confirmation (MSimplified)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Case.Order_Cancellation_Confirmation_MSimplified</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
