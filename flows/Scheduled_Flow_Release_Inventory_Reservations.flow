<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Has_Order_Summary_Id</name>
        <label>Has Order Summary Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Release_Inventory_for_Cart_No_Order_Reservation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No OS ID</defaultConnectorLabel>
        <rules>
            <name>Has_OS_ID</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Order_Summary.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Release_Inventory_for_Source_Reservation</targetReference>
            </connector>
            <label>Has OS ID</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Reservation_Source_ID</name>
        <label>Has Reservation Source ID</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Release_Inventory_for_No_Source_Reservation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Source</defaultConnectorLabel>
        <rules>
            <name>Has_Source_ID</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ReservationSourceId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Cart_Record</targetReference>
            </connector>
            <label>Has Source ID</label>
        </rules>
    </decisions>
    <description>This scheduled flow will check all inventory reservations created. If a reservation has no source (a cart ID), it will be automatically removed. If it contains a cart ID, the automation will attempt to find the created order summary from that Cart ID. It will then release the inventory reservation if the Order Summary found contains no order item summary in an unfulfilled state. In other words, if the order summary is completely fulfilled, the automation will release the reservation.</description>
    <environments>Default</environments>
    <interviewLabel>Scheduled Flow - Release Inventory Reservations {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Scheduled Flow - Release Inventory Reservations</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Cart_Record</name>
        <label>Get Cart Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Order_Record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ReservationSourceId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WebCart</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Order_Record</name>
        <label>Get Order Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Order_Summary</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderReferenceNumber</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Cart_Record.InitialOrderReferenceNumber</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Order</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Order_Summary</name>
        <label>Get Order Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Order_Summary_Id</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Cart_Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ReservationSourceId</elementReference>
            </value>
        </filters>
        <filters>
            <field>OriginalOrderId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Order_Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OrderSummary</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Reservation_Source_ID</targetReference>
        </connector>
        <object>InventoryReservation</object>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2026-04-02</startDate>
            <startTime>14:14:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Release_Inventory_for_Cart_No_Order_Reservation</name>
        <label>Release Inventory for Cart No Order Reservation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Release_Inventory_Reservation</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Release_Inventory_for_No_Source_Reservation</name>
        <label>Release Inventory for No Source Reservation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Release_Inventory_Reservation</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <subflows>
        <name>Release_Inventory_for_Source_Reservation</name>
        <label>Release Inventory for Source Reservation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Order_Summary_Release_Inventory_for_Fulfilled_Order</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>Get_Order_Summary.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
