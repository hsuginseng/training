<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_OOBO_Order</name>
        <label>Is OOBO Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Should_Hold_Order_Summary</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>All Others</defaultConnectorLabel>
        <rules>
            <name>OOBO</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OrderSummary.SourceProcess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OrderOnBehalf</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Order_Payment_Summary</targetReference>
            </connector>
            <label>OOBO</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Payment_Valid</name>
        <label>Is Payment Valid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_All_Payment_Gateway_Logs</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Valid Payment</defaultConnectorLabel>
        <rules>
            <name>Invalid_Payment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_All_Payment_Gateway_Logs.GatewayResultCodeDescription</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>requires_action</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_on_Order_Summary</targetReference>
            </connector>
            <label>Invalid Payment</label>
        </rules>
    </decisions>
    <decisions>
        <name>Should_Hold_Order_Summary</name>
        <label>Should Hold Order Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Status_to_Approved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Approve Order Summary</defaultConnectorLabel>
        <rules>
            <name>Hold_Order_Summary</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OrderSummary.SourceProcess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OrderOnBehalf</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OrderSummary.SalesStoreId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.D2C_StoreID</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OrderSummary.Payment_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Credit Card</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status_to_Hold</targetReference>
            </connector>
            <label>Hold Order Summary</label>
        </rules>
    </decisions>
    <description>This flow has two functions: calculating the initial order summary status and validating payment data.

The first function - calculating status on the order summary - will hold D2C orders if full payment isn&apos;t received at the time of order placement.

The second function will validate payment for any newly created order summary. The scope of this automation is to detect issues with 3D Secure authentication for payment cards and prevent order fulfillment if the payment isn&apos;t valid. The order summary&apos;s status will be updated to &quot;Hold&quot; if the payment is invalid.</description>
    <environments>Default</environments>
    <formulas>
        <name>Cancellation_Message</name>
        <dataType>String</dataType>
        <expression>&apos;Payment cancelled due to 3DS error in Salesforce. Refer to order summary ID: &apos; + {!$Record.OrderSummaryId}</expression>
    </formulas>
    <interviewLabel>Order Summary Created PE - Validate Payment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order Summary Created PE - Validate Payment Set Status</label>
    <loops>
        <description>Check every log for a status in &apos;requires_action&apos; and flag the order summary if one is found.</description>
        <name>Check_All_Payment_Gateway_Logs</name>
        <label>Check All Payment Gateway Logs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_All_Payment_Gateway_Logs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_Payment_Valid</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Should_Hold_Order_Summary</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Process_Exception</name>
        <label>Create Process Exception</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>AttachedToId</field>
            <value>
                <elementReference>Get_Order_Payment_Summary.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Category</field>
            <value>
                <stringValue>Payment</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Payment experienced a 3D Secure authentication error. Please resolve the payment issue with the customer.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Message</field>
            <value>
                <stringValue>Error: Payment Will Not Capture! Status of &quot;requires_action&quot; Detected.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OrderSummaryId</field>
            <value>
                <elementReference>$Record.OrderSummaryId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Severity</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <object>ProcessException</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_All_Payment_Gateway_Logs</name>
        <label>Get All Payment Gateway Logs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_All_Payment_Gateway_Logs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderPaymentSummaryId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Order_Payment_Summary.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PaymentGatewayLog</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Order_Payment_Summary</name>
        <label>Get Order Payment Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_All_Payment_Gateway_Logs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderSummaryId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OrderSummaryId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OrderPaymentSummary</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Status_on_Order_Summary</name>
        <label>Update Status on Order Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Process_Exception</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OrderSummaryId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Payment_Error__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Hold</stringValue>
            </value>
        </inputAssignments>
        <object>OrderSummary</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Status_to_Approved</name>
        <label>Update Status to Approved</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OrderSummaryId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </inputAssignments>
        <object>OrderSummary</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Status_to_Hold</name>
        <label>Update Status to Hold</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OrderSummaryId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Hold</stringValue>
            </value>
        </inputAssignments>
        <object>OrderSummary</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_OOBO_Order</targetReference>
        </connector>
        <flowRunAsUser>TriggeringUser</flowRunAsUser>
        <object>OrderSummaryCreatedEvent</object>
        <triggerType>PlatformEvent</triggerType>
    </start>
    <status>Active</status>
</Flow>
