    <decisions>
        <name>Calculate_Tax</name>
        <label>Calculate Tax</label>
        <locationX>182</locationX>
        <locationY>170</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Order_Summary_Tax_calc</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OrderSummary.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.OrderSummary.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Calculate_Tax_for_Approved_status</targetReference>
            </connector>
            <label>Order Summary Tax calc</label>
        </rules>
    </decisions>
    <description>5/13/26 AKW: Migrated status calculation logic to a single flow, Order Summary Created PE - Validate Payment Set Status. Improved status update logic surrounding payment errors and holding orders.</description>
    <environments>Default</environments>
    <interviewLabel>Order Summary Created - Send Initial Order Summary to AvaTax {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order Summary Created - Send Initial Order Summary to AvaTax</label>
