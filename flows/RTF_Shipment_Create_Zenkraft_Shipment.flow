<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Creates a shipment object in the zkmulti namespace, used for shipment tracking.</description>
        <name>Create_Track_Shipment_Multi_Carrier</name>
        <label>Create Track Shipment (Multi Carrier)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>zkmulti__InvocableTracking</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>createShipmentIfNotFound</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>customAddressId</name>
            <value>
                <stringValue>a11V50000040FMXIA2</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>forceShipmentCreation</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>preferenceId</name>
            <value>
                <stringValue>a1DV50000008ntBMAQ</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>shipDate</name>
            <value>
                <elementReference>$Record.CreatedDate</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>trackingNumber</name>
            <value>
                <elementReference>$Record.TrackingNumber</elementReference>
            </value>
        </inputParameters>
        <nameSegment>zkmulti__InvocableTracking</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This flow will create a Zenkraft Shipment record (ZKMulti Shipment [zkmulti__MCShipment__c]) whenever a salesforce Shipment record is created or updated and has the tracking field number populated. This is used for order tracking purposes.</description>
    <environments>Default</environments>
    <interviewLabel>RTF Shipment - Create Zenkraft Shipment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTF Shipment - Create Zenkraft Shipment</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Track_Shipment_Multi_Carrier</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>TrackingNumber</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Shipment</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
