<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Gift_Message_to_Variable</name>
        <label>Set Gift Message to Variable</label>
        <locationX>270</locationX>
        <locationY>494</locationY>
        <assignmentItems>
            <assignToReference>GiftMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Thru_Order_Delivery_Groups.GiftMessage</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>HasGift</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Thru_Order_Delivery_Groups</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_If_Gift</name>
        <label>Check If Gift</label>
        <locationX>402</locationX>
        <locationY>386</locationY>
        <defaultConnector>
            <targetReference>Loop_Thru_Order_Delivery_Groups</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Gift</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Thru_Order_Delivery_Groups.IsGift</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Gift_Message_to_Variable</targetReference>
            </connector>
            <label>Is Gift</label>
        </rules>
    </decisions>
    <decisions>
        <name>Should_Set_Gift_Fields_On_Order_Summary</name>
        <label>Should Set Gift Fields On Order Summary</label>
        <locationX>182</locationX>
        <locationY>770</locationY>
        <defaultConnectorLabel>Finish Flow</defaultConnectorLabel>
        <rules>
            <name>Set_Gift_Fields</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HasGift</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Order_Summary</targetReference>
            </connector>
            <label>Set Gift Fields</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Order Summary Creation Event - Set Gift Fields {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order Summary Creation Event - Set Gift Fields</label>
    <loops>
        <name>Loop_Thru_Order_Delivery_Groups</name>
        <label>Loop Thru Order Delivery Groups</label>
        <locationX>182</locationX>
        <locationY>278</locationY>
        <collectionReference>Get_Order_Delivery_Groups</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_If_Gift</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Should_Set_Gift_Fields_On_Order_Summary</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Order_Delivery_Groups</name>
        <label>Get Order Delivery Groups</label>
        <locationX>182</locationX>
        <locationY>170</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Thru_Order_Delivery_Groups</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OrderSummary.OriginalOrderId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OrderDeliveryGroup</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Order_Summary</name>
        <label>Update Order Summary</label>
        <locationX>50</locationX>
        <locationY>878</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OrderSummaryId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Gift_Message__c</field>
            <value>
                <elementReference>GiftMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Gift_Order__c</field>
            <value>
                <elementReference>HasGift</elementReference>
            </value>
        </inputAssignments>
        <object>OrderSummary</object>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Order_Delivery_Groups</targetReference>
        </connector>
        <flowRunAsUser>TriggeringUser</flowRunAsUser>
        <object>OrderSummaryCreatedEvent</object>
        <triggerType>PlatformEvent</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>GiftMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>HasGift</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
