            <targetReference>Get_Location_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Location Type</defaultConnectorLabel>
        <rules>
            <name>Location_Group_Type</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
