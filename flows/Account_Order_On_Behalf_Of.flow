    <decisions>
        <name>Account_Exists</name>
        <label>Account Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Use_Location_Groups</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>No_Account_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invalid_Account_ID_Error_Message</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <decisions>
        <name>Cart_Exists</name>
        <label>Cart Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Initialize_Cart_Input_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Does not exist</defaultConnectorLabel>
        <rules>
            <name>Exist_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>cartId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>cartId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_WebStore_Inventory_Configured</targetReference>
            </connector>
            <label>Exist</label>
        </rules>
    </decisions>
    <decisions>
        <name>Copy_1_of_Should_Create_CIPA</name>
        <label>Copy 1 of Should Create CIPA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Delete_CIPA_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxCurrentCartItemModifiedPriceTimesQuantity</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Copy_1_of_Get_CIPA.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Copy_1_of_Get_CIPA.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer Satisfaction - Cart Item Discount</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_CIPA</targetReference>
            </connector>
            <label>Delete CIPA Record</label>
        </rules>
        <rules>
            <name>Copy_1_of_Create_CIPA</name>
            <conditionLogic>(1 OR 3) AND 2</conditionLogic>
            <conditions>
                <leftValueReference>Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.SalesPrice</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Copy_1_of_Get_CIPA.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CartDiscountPercentage</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Assign_Cart_Item_Values</targetReference>
            </connector>
            <label>Copy 1 of Create CIPA</label>
        </rules>
        <rules>
            <name>Copy_1_of_Update_CIPA</name>
            <conditionLogic>(1 OR 3) AND 2</conditionLogic>
            <conditions>
                <leftValueReference>Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.SalesPrice</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Copy_1_of_Get_CIPA.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CartDiscountPercentage</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_2_of_Assign_Cart_Item_Values</targetReference>
            </connector>
            <label>Copy 1 of Update CIPA</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Approval_Needed</name>
        <label>Decision - Approval Needed</label>
