    <decisions>
        <name>Reservation_Success</name>
        <label>Reservation Success?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Current_Stage_Select_Product_and_Quantity_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Failure</defaultConnectorLabel>
        <rules>
            <name>Success_Reservation</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>OCI_CreateReservationOutputRepresentation.success</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Create_Inventory_Reservation_From_Cart.cartInventoryReservationOutputRepresentation.success</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Current_Stage_Order_Preview_Stage</targetReference>
            </connector>
            <label>Success Reservation</label>
        </rules>
    </decisions>
    <decisions>
        <name>Should_Create_CIPA</name>
        <label>Should Create CIPA</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Pricing_And_Quantity_On_Cart_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Create_CIPA</name>
            <conditionLogic>(1 OR 3) AND 2</conditionLogic>
            <conditions>
                <leftValueReference>Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Update_Pricing_And_Quantity_On_Cart_Items.SalesPrice</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_CIPA.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CartDiscountPercentage</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Cart_Item_Values</targetReference>
            </connector>
            <label>Create CIPA</label>
        </rules>
        <rules>
            <name>Update_CIPA_2</name>
            <conditionLogic>(1 OR 3) AND 2</conditionLogic>
            <conditions>
                <leftValueReference>Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Update_Pricing_And_Quantity_On_Cart_Items.SalesPrice</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_CIPA.Id</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CartDiscountPercentage</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_3_of_Assign_Cart_Item_Values</targetReference>
            </connector>
            <label>Update CIPA</label>
        </rules>
    </decisions>
    <decisions>
        <name>should_reverse_authorization</name>
        <label>should reverse authorization</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Current_Stage_Confirmation_Stage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Reverse_Auth</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PaymentValidation.paymentResult</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Failure</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Order_Payment_Summary</targetReference>
            </connector>
            <label>Reverse Auth</label>
        </rules>
    </decisions>
