            <name>OCI_Product_Added_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OCI_Product_Items_Loop.isAdded</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Build_OCI_Reservation_Item</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
