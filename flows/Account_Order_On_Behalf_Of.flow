    <decisions>
        <name>Is_WebStore_Inventory_Configured</name>
        <label>Is WebStore Inventory Configured?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Delete_Existing_Cart_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Configured</defaultConnectorLabel>
        <rules>
            <name>WebStore_Inventory_Configured</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isWebStoreInventoryConfigured</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Inventory_Reservation_From_Cart</targetReference>
            </connector>
            <label>WebStore Inventory Configured</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_WebStoreInventory_Enabled</name>
        <label>Is WebStoreInventory Enabled?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Current_Stage_Order_Preview_Stage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>WebStoreInventory Not Enabled</defaultConnectorLabel>
        <rules>
            <name>WebStoreInventory_Enabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>isWebStoreInventoryConfigured</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Initialize_Cart_Inventory_Reservation_Input_Representation</targetReference>
            </connector>
            <label>WebStoreInventory Enabled</label>
        </rules>
    </decisions>
    <decisions>
        <description>If the web store type is B2C or the select user isn’t empty, don’t call the Register Guest Buyer invocable action.</description>
        <name>NeedsGuestAccess</name>
        <label>Needs Guest Access?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Web_Store_Inventory_Configured</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YesNeedsGuestAccess</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>selectedWebstore.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>B2B</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>selectedWebstore.Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>B2C</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>selectedUserId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>selectedUserId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>RegisterGuestBuyer</targetReference>
            </connector>
            <label>Yes Needs Guest Access</label>
        </rules>
    </decisions>
    <decisions>
        <name>OCI_Product_Added</name>
