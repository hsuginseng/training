    <description>5/31/26 AKW - Payment Auth Reversal logic added when 3DS payment is detected.
5/13/26 AKW - Payment validation component added for 3D Secure authentication error detection.
Jack Huffman - 4/3/26 - Fetching Canada storefront in list of LocationGroups
Jack Huffman - 4/1/26 - Updated error message on not finding Location
Jack Huffman - 4/1/26 - Added back Location__c setter to Update Cart node
Jack Huffman - 3/30/26 - Reverted back to older version (pre OCI actions) for testing
Jack Huffman - 3/26/26 - Added back Location specific changes after flow was refreshed from prod
Jack Huffman - 3/23/26 - Removed location group from product selection screen and passed in location ID instead
Jack Huffman - 3/18/26 - Added GET node for fetching LocationGroup and passed it into the Select_Webstore_and_Location_Group screen
Added a checkbox field on Cart, Is_OOBO_Cart__c, that flags orders created in the flow as OOBO carts. This version of the flow assumes D2C should have more than CC options at the payment screen.</description>
    <environments>Default</environments>
    <formulas>
        <name>AllAdjustmentsTotal</name>
        <dataType>Currency</dataType>
        <expression>{!CartItemAdjustmentFormula_old} * {!Update_Pricing_And_Quantity_On_Cart_Items.Quantity}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CartDiscountPercentage</name>
        <dataType>Number</dataType>
        <expression>{!Cart_Discount} / 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>This formula calculates the price for a single quantity of a cart item, after all discounts are applied, and before taxes are applied. This is a positive value.</description>
        <name>CartItemAdjFormula</name>
        <dataType>Currency</dataType>
        <expression>{!Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c}*(1 -  {!CartDiscountPercentage})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CartItemAdjustmentFormula_old</name>
        <dataType>Number</dataType>
        <expression>{!Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c}*(1 -  {!CartDiscountPercentage})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>This creates a helpful description for the Cart Item Adjustment Record. The string calculated here appears on the order review screen.</description>
        <name>CartItemPriceAdjustmentDescription</name>
        <dataType>String</dataType>
        <expression>{!Update_Pricing_And_Quantity_On_Cart_Items.Product2.StockKeepingUnit}+&apos; - Cart Item Discount &apos; + &apos;($&apos; +TEXT(ROUND({!CurrentCartItemModifiedPriceTimesQuantity}, 2)) + &apos;)&apos;</expression>
    </formulas>
    <formulas>
        <name>CartItemTotAdjFormula</name>
        <dataType>Currency</dataType>
        <expression>{!Update_Pricing_And_Quantity_On_Cart_Items.Quantity}*{!Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c}*(1 -  {!CartDiscountPercentage})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>This value is calculated by multiplying the quantity with the modified price for the current cart item.</description>
        <name>CurrentCartItemModifiedPriceTimesQuantity</name>
        <dataType>Currency</dataType>
        <expression>{!Update_Pricing_And_Quantity_On_Cart_Items.Quantity}*-1*({!Update_Pricing_And_Quantity_On_Cart_Items.SalesPrice} - {!Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c}*(1 -  {!CartDiscountPercentage}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>This is used to calculate fields such as Total Adjusted Price and Total Price on cart item records.</description>
        <name>CurrentCartItemTotalAmount</name>
        <dataType>Currency</dataType>
        <expression>{!Update_Pricing_And_Quantity_On_Cart_Items.Quantity}*{!Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c}*(1 -  {!CartDiscountPercentage})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>This is used to calculate fields such as Total Adjusted Price and Total Price on cart item records.</description>
        <name>CurrentCartItemTotalAmount_old</name>
        <dataType>Number</dataType>
        <expression>{!Update_Pricing_And_Quantity_On_Cart_Items.Quantity}*{!Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c}*(1 -  {!CartDiscountPercentage})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Populates the adjustment for a cart item at an individual unit level. This value calculates a negative value.</description>
        <name>CurrentCartItemUnitAdjustmentAmount</name>
        <dataType>Currency</dataType>
        <expression>-1*({!Update_Pricing_And_Quantity_On_Cart_Items.SalesPrice} - {!Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c}*(1 -  {!CartDiscountPercentage}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxAllAdjustmentsTotal</name>
        <dataType>Currency</dataType>
        <expression>{!fxCartItemAdjFormula_old} * {!Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.Quantity}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>This formula calculates the price for a single quantity of a cart item, after all discounts are applied, and before taxes are applied. This is a positive value.</description>
        <name>fxCartItemAdjFormula</name>
        <dataType>Currency</dataType>
        <expression>{!Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c}*(1 -  {!CartDiscountPercentage})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxCartItemAdjFormula_old</name>
        <dataType>Number</dataType>
        <expression>{!Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c}*(1 -  {!CartDiscountPercentage})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>This creates a helpful description for the Cart Item Adjustment Record. The string calculated here appears on the order review screen.</description>
        <name>fxCartItemPriceAdjustmentDescription</name>
        <dataType>String</dataType>
        <expression>{!Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.Product2.StockKeepingUnit}+&apos; - Cart Item Discount &apos; + &apos;($&apos; +TEXT(ROUND({!fxCurrentCartItemModifiedPriceTimesQuantity}, 2)) + &apos;)&apos;</expression>
    </formulas>
    <formulas>
        <name>fxCartItemTotAdjFormula</name>
        <dataType>Number</dataType>
        <expression>{!Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.Quantity}*{!Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c}*(1 -  {!CartDiscountPercentage})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>This value is calculated by multiplying the quantity with the modified price for the current cart item.</description>
        <name>fxCurrentCartItemModifiedPriceTimesQuantity</name>
        <dataType>Currency</dataType>
        <expression>{!Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.Quantity}*-1*({!Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.SalesPrice} - {!Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c}*(1 -  {!CartDiscountPercentage}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>This is used to calculate fields such as Total Adjusted Price and Total Price on cart item records.</description>
        <name>fxCurrentCartItemTotalAmount</name>
        <dataType>Currency</dataType>
        <expression>{!Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.Quantity} * {!Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c} * (1 -  {!CartDiscountPercentage})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Populates the adjustment for a cart item at an individual unit level. This value calculates a negative value.</description>
        <name>fxCurrentCartItemUnitAdjustmentAmount</name>
        <dataType>Currency</dataType>
        <expression>-1*({!Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.SalesPrice} - {!Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c}*(1 -  {!CartDiscountPercentage}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NegativeCartDiscountPercentage</name>
        <dataType>Number</dataType>
        <expression>-1*{!Cart_Discount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>UnitAdjustmentAmount</name>
        <dataType>Currency</dataType>
        <expression>{!Update_Pricing_And_Quantity_On_Cart_Items.SalesPrice} - {!Update_Pricing_And_Quantity_On_Cart_Items.Cart_Unit_Discounted_Price_Formula__c}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Account - Order On Behalf Of {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Order On Behalf Of</label>
    <loops>
        <description>This loop is responsible for looping through all cart items so the pricing can be adjusted based on quantity and pricing changes from the &quot;Modify Pricing In Cart Screen.&quot;</description>
        <name>Copy_1_of_Update_Pricing_And_Quantity_On_Cart_Items</name>
        <label>Copy 1 of Update Pricing And Quantity On Cart Items</label>
        <locationX>0</locationX>
