<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>AccumulateOpenBalances</name>
        <label>Accumulate Open Balances</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>totalOpenBalance</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>LoopOrderSummariesInitial.Balance_Due__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LoopOrderSummariesInitial</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>PrepCashEntryRecord</name>
        <label>Prep Cash Entry Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>bufferCashEntry.Amount_Paid__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>currPaymentEntryAmount</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferCashEntry.Date_Paid__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>mainCashEntryRecord.Date_Paid__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferCashEntry.Payment_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>mainCashEntryRecord.Payment_Type__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferCashEntry.CurrencyIsoCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>mainCashEntryRecord.CurrencyIsoCode</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferCashEntry.Check_Number__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>mainCashEntryRecord.Check_Number__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>bufferCashEntry.Order_Summary__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoopOrderSummaries.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>createCashEntryCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>bufferCashEntry</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LoopOrderSummaries</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>SetCreditBalance</name>
        <label>Set Credit Balance</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>remainingCredit</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Amount_Paid</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LoopOrderSummaries</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>SetDefaultValues</name>
        <label>Set Default Values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>mainCashEntryRecord.Date_Paid__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Today</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>mainCashEntryRecord.CurrencyIsoCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Account_Currency.CurrencyIsoCode</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>EnterPaymentDetails</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>SetPaymentAmountInsufficient</name>
        <label>Set Payment Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>currPaymentEntryAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>remainingCredit</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>remainingCredit</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>PrepCashEntryRecord</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>SetPaymentAmountSufficient</name>
        <label>Set Payment Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>remainingCredit</assignToReference>
            <operator>Subtract</operator>
            <value>
                <elementReference>LoopOrderSummaries.Balance_Due__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>currPaymentEntryAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LoopOrderSummaries.Balance_Due__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>PrepCashEntryRecord</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>CAD</name>
        <choiceText>CAD</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>CAD</stringValue>
        </value>
    </choices>
    <choices>
        <name>USD</name>
        <choiceText>USD</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>USD</stringValue>
        </value>
    </choices>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>RemainingBalanceRouting</name>
        <label>Remaining Balance Routing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>CreateCashEntryRecords</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>N/A</defaultConnectorLabel>
        <rules>
            <name>NoBalanaceRemaining</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>remainingCredit</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>CreateCashEntryRecords</targetReference>
            </connector>
            <label>No Bal. Remaining</label>
        </rules>
        <rules>
            <name>SufficientBalanceRemaining</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LoopOrderSummaries.Balance_Due__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>remainingCredit</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetPaymentAmountSufficient</targetReference>
            </connector>
            <label>Suff. Bal. Remaining</label>
        </rules>
        <rules>
            <name>InsufficientBalanceRemaining</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LoopOrderSummaries.Balance_Due__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>remainingCredit</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetPaymentAmountInsufficient</targetReference>
            </connector>
            <label>Insuff. Bal. Remaining</label>
        </rules>
    </decisions>
    <description>AKW 4/1/26 - Adding multi-currency support and fixing the maximum amount bug for cash entry input amount.</description>
    <environments>Default</environments>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Account - Screen Flow - Enter Offline Payment for Order Balances {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Screen Flow - Enter Offline Payment for Order Balances</label>
    <loops>
        <name>LoopOrderSummaries</name>
        <label>Order Summaries</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>OpenBalanceOrders</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>RemainingBalanceRouting</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>ReviewCashEntryCreationScreen</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>LoopOrderSummariesInitial</name>
        <label>Order Summaries</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>OpenBalanceOrders</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>AccumulateOpenBalances</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Account_Currency</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>CreateCashEntryRecords</name>
        <label>Create Cash Entry Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>createCashEntryCollection</inputReference>
    </recordCreates>
    <recordLookups>
        <description>Get the account currency to set the currency for the Cash Entry records.</description>
        <name>Get_Account_Currency</name>
        <label>Get Account Currency</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>SetDefaultValues</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>OpenBalanceOrders</name>
        <label>Open-Balance Orders</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LoopOrderSummariesInitial</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Balance_Due__c</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OrderSummary</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>EnterPaymentDetails</name>
        <label>Enter Payment Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>SetCreditBalance</targetReference>
        </connector>
        <fields>
            <name>PaymentEntry</name>
            <fieldText>Payment Entry</fieldText>
            <fieldType>RegionContainer</fieldType>
            <fields>
                <name>PaymentEntry_Column1</name>
                <fieldType>Region</fieldType>
                <fields>
                    <fieldType>ObjectProvided</fieldType>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>false</isRequired>
                    <objectFieldReference>mainCashEntryRecord.Payment_Type__c</objectFieldReference>
                    <styleProperties>
                        <verticalAlignment>
                            <stringValue>top</stringValue>
                        </verticalAlignment>
                        <width>
                            <stringValue>12</stringValue>
                        </width>
                    </styleProperties>
                </fields>
                <fields>
                    <name>CurrencyIsoCode</name>
                    <choiceReferences>USD</choiceReferences>
                    <choiceReferences>CAD</choiceReferences>
                    <dataType>String</dataType>
                    <defaultValue>
                        <elementReference>Get_Account_Currency.CurrencyIsoCode</elementReference>
                    </defaultValue>
                    <fieldText>Currency</fieldText>
                    <fieldType>DropdownBox</fieldType>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isDisabled>
                        <booleanValue>true</booleanValue>
                    </isDisabled>
                    <isRequired>true</isRequired>
                    <styleProperties>
                        <verticalAlignment>
                            <stringValue>top</stringValue>
                        </verticalAlignment>
                        <width>
                            <stringValue>12</stringValue>
                        </width>
                    </styleProperties>
                </fields>
                <inputParameters>
                    <name>width</name>
                    <value>
                        <stringValue>6</stringValue>
                    </value>
                </inputParameters>
                <isRequired>false</isRequired>
            </fields>
            <fields>
                <name>PaymentEntry_Column2</name>
                <fieldType>Region</fieldType>
                <fields>
                    <fieldType>ObjectProvided</fieldType>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>false</isRequired>
                    <objectFieldReference>mainCashEntryRecord.Date_Paid__c</objectFieldReference>
                    <styleProperties>
                        <verticalAlignment>
                            <stringValue>top</stringValue>
                        </verticalAlignment>
                        <width>
                            <stringValue>12</stringValue>
                        </width>
                    </styleProperties>
                </fields>
                <fields>
                    <name>Amount_Paid</name>
                    <dataType>Currency</dataType>
                    <fieldText>Amount Paid</fieldText>
                    <fieldType>InputField</fieldType>
                    <helpText>&lt;p&gt;Current Open Balance: {!totalOpenBalance}&lt;/p&gt;</helpText>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>true</isRequired>
                    <scale>0</scale>
                    <styleProperties>
                        <verticalAlignment>
                            <stringValue>top</stringValue>
                        </verticalAlignment>
                        <width>
                            <stringValue>12</stringValue>
                        </width>
                    </styleProperties>
                    <validationRule>
                        <errorMessage>&lt;p&gt;Please enter a value that is equal to or lower than the Account&apos;s remaining balance. &lt;/p&gt;</errorMessage>
                        <formulaExpression>{!totalOpenBalance} &gt;= {!Amount_Paid}</formulaExpression>
                    </validationRule>
                </fields>
                <fields>
                    <fieldType>ObjectProvided</fieldType>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>false</isRequired>
                    <objectFieldReference>mainCashEntryRecord.Check_Number__c</objectFieldReference>
                    <styleProperties>
                        <verticalAlignment>
                            <stringValue>top</stringValue>
                        </verticalAlignment>
                        <width>
                            <stringValue>12</stringValue>
                        </width>
                    </styleProperties>
                    <visibilityRule>
                        <conditionLogic>and</conditionLogic>
                        <conditions>
                            <leftValueReference>mainCashEntryRecord.Payment_Type__c</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <stringValue>Check</stringValue>
                            </rightValue>
                        </conditions>
                    </visibilityRule>
                </fields>
                <inputParameters>
                    <name>width</name>
                    <value>
                        <stringValue>6</stringValue>
                    </value>
                </inputParameters>
                <isRequired>false</isRequired>
            </fields>
            <isRequired>false</isRequired>
            <regionContainerType>SectionWithHeader</regionContainerType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>OpenBalanceOrdersHeader</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;The Orders below have an Open Balance. Cash Entry will be applied to the earliest balance. Amount will be applied to subsequent Orders until exhausted.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>OpenBalanceOrderTable</name>
            <dataTypeMappings>
                <typeName>T</typeName>
                <typeValue>OrderSummary</typeValue>
            </dataTypeMappings>
            <extensionName>flowruntime:datatable</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>label</name>
