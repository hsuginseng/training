                <name>keyField</name>
                <value>
                    <complexValue>{&quot;dataType&quot;:&quot;SObject&quot;,&quot;objectType&quot;:&quot;OrderSummary&quot;,&quot;fieldReferences&quot;:[&quot;Id&quot;],&quot;elementReference&quot;:&quot;OpenBalanceOrders&quot;}</complexValue>
                    <complexValueType>ComplexObjectFieldDetails</complexValueType>
