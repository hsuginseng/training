<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Credit_Points</name>
        <label>Credit Points</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>creditPoints</actionName>
        <actionType>creditPoints</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>LoyaltyProgramMemberId</name>
            <value>
                <elementReference>Create_Loyalty_Program_Member_for_Person_Account</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>ProgramCurrencyName</name>
            <value>
                <stringValue>Non Qualifying Currency</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>ProgramName</name>
            <value>
                <stringValue>Hsu&apos;s Loyalty Program v1</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Points</name>
            <value>
                <numberValue>1000.0</numberValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>CorrelationId</name>
        </inputParameters>
        <inputParameters>
            <name>JournalId</name>
            <value>
                <elementReference>Create_Transaction_Journal</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>PointsExpirationDate</name>
            <value>
                <elementReference>fxYearFromTodayString</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>PromotionId</name>
        </inputParameters>
        <nameSegment>creditPoints</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Should_Enroll_in_Loyalty_Program</name>
        <label>Should Enroll in Loyalty Program</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Enroll</name>
            <conditionLogic>(1 OR (2 AND 3)) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Enroll_in_Loyalty_Program__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Enroll_in_Loyalty_Program__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IsPersonAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Loyalty_Program_1</targetReference>
            </connector>
            <label>Yes Enroll</label>
        </rules>
    </decisions>
    <description>Updated to set any date fields in created records to use TODAY() in formulas.
(JN)(6.16) - Deleting path for Referral Code - Covered in Fulfillment Order Flow
08-28-2026 - Added IsPersonAccount check to prevent Business account creation issue</description>
    <environments>Default</environments>
    <formulas>
        <name>fxYearFromToday</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!$Flow.CurrentDate} + 365), MONTH({!$Flow.CurrentDate} + 365), DAY({!$Flow.CurrentDate} + 365))</expression>
    </formulas>
    <formulas>
        <description>Formatted string representation of the year from today formula. This is used to work around locale date formatting in different locales.</description>
        <name>fxYearFromTodayString</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR({!fxYearFromToday})) +
&apos;-&apos; +
IF(MONTH({!fxYearFromToday}) &lt; 10, &apos;0&apos; + TEXT(MONTH({!fxYearFromToday})), TEXT(MONTH({!fxYearFromToday}))) +
&apos;-&apos; +
IF(DAY({!fxYearFromToday}) &lt; 10, &apos;0&apos; + TEXT(DAY({!fxYearFromToday})), TEXT(DAY({!fxYearFromToday})))</expression>
    </formulas>
    <formulas>
        <name>IsNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <description>Checks if the code is an update and the update is from a null value.</description>
        <name>isReferralCodeUpdated</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISCHANGED({!$Record.Referred_By_Code_Loyalty_Member__c}), ISBLANK({!$Record__Prior.Referred_By_Code_Loyalty_Member__c}))</expression>
    </formulas>
    <interviewLabel>Account Created - Enroll in Loyalty Program {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Created Updated - Enroll in Loyalty Program</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Loyalty_Program_Member_for_Person_Account</name>
        <label>Create Loyalty Program Member for Person Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Journal_Type_1</targetReference>
        </connector>
        <inputAssignments>
            <field>CanReceivePromotions</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>$Record.PersonContact.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EnrollmentDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MemberStatus</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MemberType</field>
            <value>
                <stringValue>Individual</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MembershipNumber</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ProgramId</field>
