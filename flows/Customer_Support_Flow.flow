    <decisions>
        <name>Are_documents_uploaded</name>
        <label>Are documents uploaded</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Documents_uploaded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ContentDocumentUploadIds</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_on_uploaded_documents</targetReference>
            </connector>
            <label>Documents uploaded</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Preferred_Language</name>
        <label>Check Preferred Language</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Send_Customer_Support_Email_Alert</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Traditional_Mandarin_Preferred</name>
            <conditionLogic>1</conditionLogic>
            <conditions>
                <leftValueReference>PreferredLanguage</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Traditional Mandarin</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Traditional_Email</targetReference>
            </connector>
            <label>Traditional Mandarin Preferred</label>
        </rules>
        <rules>
            <name>Simplified_Mandarin_Preferred</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PreferredLanguage</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Simplified Mandarin</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Simplified_Email</targetReference>
            </connector>
            <label>Simplified Mandarin Preferred</label>
        </rules>
    </decisions>
    <decisions>
        <name>Confirm_Record_Type_Found</name>
        <label>Confirm Record Type Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RecordTypeNotNull</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record_Type</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Matching_Person_Accounts</targetReference>
            </connector>
            <label>RecordTypeNotNull</label>
        </rules>
    </decisions>
    <decisions>
        <name>PersonAccountFound</name>
        <label>PersonAccountFound</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>GetMatchingPersonAccountsNotNull</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Matching_Person_Accounts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AssignPersonAccountIdValue</targetReference>
            </connector>
            <label>GetMatchingPersonAccountsNotNull</label>
        </rules>
    </decisions>
