                <elementReference>Create_Transaction_Journal_Actual_Amount.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>PromotionId</name>
            <value>
                <elementReference>Get_Promotion.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>debitPoints</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>Debit_Points_Zero_Balance</name>
        <label>Debit Points Zero Balance</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>debitPoints</actionName>
        <actionType>debitPoints</actionType>
        <connector>
            <targetReference>Update_Return_Line_Item_Record</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>LoyaltyProgramMemberId</name>
            <value>
                <elementReference>Get_Loyalty_Member.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>ProgramCurrencyName</name>
            <value>
                <stringValue>Non Qualifying Currency</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>ProgramName</name>
            <value>
                <stringValue>Hsu&apos;s Loyalty Program v1</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Points</name>
            <value>
                <elementReference>Get_Loyalty_Member_Currency.PointsBalance</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>CorrelationId</name>
            <value>
                <elementReference>$Record.ReturnOrder.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>JournalId</name>
            <value>
                <elementReference>Create_Transaction_Journal_Zero_Balance.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>PromotionId</name>
            <value>
                <elementReference>Get_Promotion.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>debitPoints</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Compare the points to debit with the loyalty member&apos;s point balance. If the balance is less than the points to debit, modify the points to debit so the balance doesn&apos;t drop below zero.</description>
        <name>Check_Loyalty_Member_Balance</name>
        <label>Check Loyalty Member Balance</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Transaction_Journal_Actual_Amount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Continue</defaultConnectorLabel>
        <rules>
            <name>Insufficient_Balance</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Loyalty_Member_Currency.PointsBalance</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>fxTotalPoints</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Transaction_Journal_Zero_Balance</targetReference>
            </connector>
            <label>Insufficient Balance</label>
        </rules>
    </decisions>
    <decisions>
        <name>Null_Checks</name>
        <label>Null Checks</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Found_Loyalty_Member</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Loyalty_Member</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Loyalty_Program</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Promotion</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Transaction_Journal_Type</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Loyalty_Member_Currency</targetReference>
            </connector>
            <label>Found Loyalty Member</label>
        </rules>
    </decisions>
    <description>AKW - Changed the points calculation to a multiplier of 100 instead of 1.
JN - Inital Flow Creation to debit loyalty points when a product is returned
JN - Updating Flow to change the calulcation multiplier back to 10</description>
    <environments>Default</environments>
    <formulas>
        <name>fxQualifyingTotal</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.OrderItemSummary.UnitPrice} + ({!$Record.OrderItemSummary.TotalAdjustmentAmount} / {!$Record.OrderItemSummary.Quantity})) * {!$Record.QuantityReturned}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxTotalPoints</name>
        <dataType>Number</dataType>
        <expression>{!fxQualifyingTotal} * 10</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxTotalPointsZeroBalance</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Loyalty_Member_Currency.PointsBalance}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Return Order Line Item - Debit Loyalty Points {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Return Order Line Item - Debit Loyalty Points</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
