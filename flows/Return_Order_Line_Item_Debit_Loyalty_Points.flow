<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Debit_Points_Actual_Amount</name>
        <label>Debit Points Actual Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>debitPoints</actionName>
        <actionType>debitPoints</actionType>
        <connector>
            <targetReference>Update_Return_Line_Item_Record</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>LoyaltyProgramMemberId</name>
            <value>
                <elementReference>Get_Loyalty_Member.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>ProgramCurrencyName</name>
            <value>
                <stringValue>Non Qualifying Currency</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>ProgramName</name>
            <value>
                <stringValue>Hsu&apos;s Loyalty Program v1</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Points</name>
            <value>
                <elementReference>fxTotalPoints</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>CorrelationId</name>
            <value>
                <elementReference>$Record.ReturnOrder.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>JournalId</name>
