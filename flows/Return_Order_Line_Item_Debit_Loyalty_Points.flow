            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Loyalty_Program.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>DisplayName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Loyalty Points</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
