<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Credit_Points_Action_1</name>
        <label>Credit Points Action 1</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>creditPoints</actionName>
        <actionType>creditPoints</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>LoyaltyProgramMemberId</name>
            <value>
                <elementReference>Get_Loyalty_Program_Member.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>ProgramCurrencyName</name>
            <value>
                <stringValue>Non Qualifying Currency</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>ProgramName</name>
            <value>
                <stringValue>Hsu&apos;s Loyalty Program v1</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Points</name>
            <value>
                <elementReference>fxTotalPoints</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>JournalId</name>
            <value>
                <elementReference>Create_Transaction_Journal</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>PointsExpirationDate</name>
            <value>
                <elementReference>fxYearFromToday</elementReference>
            </value>
        </inputParameters>
        <nameSegment>creditPoints</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_to_Qualifying_Total</name>
        <label>Add to Qualifying Total</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varQualifyingTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Thru_Order_Items.TotalPrice</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Thru_Order_Items</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Product_Eligibility</name>
        <label>Check Product Eligibility</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Thru_Order_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Product_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Thru_Order_Items.Product2.Loyalty_Eligible__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_to_Qualifying_Total</targetReference>
            </connector>
            <label>Product Eligible</label>
        </rules>
    </decisions>
    <decisions>
        <name>Loyalty_Program_Member_Null_Check</name>
        <label>Loyalty Program Member Null Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Found_Member</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Loyalty_Program_Member</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Loyalty_Program</targetReference>
            </connector>
            <label>Found Member</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fxTotalPoints</name>
        <dataType>Number</dataType>
        <expression>{!varQualifyingTotal} * 100</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fxYearFromToday</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 365</expression>
    </formulas>
    <interviewLabel>Shipment Delivered - Credit Loyalty Points {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Shipment Delivered - Credit Loyalty Points</label>
    <loops>
        <name>Loop_Thru_Order_Items</name>
        <label>Loop Thru Order Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Fulfillment_Order_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
