<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Create_and_Commit_Transactions</name>
        <label>Create and Commit Transactions</label>
        <locationX>50</locationX>
        <locationY>278</locationY>
        <actionName>avaoms__AvaTaxFulfillmentOrderTaxCalculator</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>foDocId</name>
            <value>
                <elementReference>$Record.FulfillmentOrder.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>isMultiCommit</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.OrderSummary.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>salesChannelId</name>
            <value>
                <elementReference>$Record.FulfillmentOrder.OrderSummary.SalesChannelId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>statusToCommit</name>
            <value>
                <stringValue>Committed</stringValue>
            </value>
        </inputParameters>
        <nameSegment>avaoms__AvaTaxFulfillmentOrderTaxCalculator</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Fullfilment_Order_Update</name>
        <label>Fullfilment Order Update</label>
        <locationX>182</locationX>
        <locationY>170</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Fullfillment_status_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.FulfillmentOrder.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.FulfillmentOrder.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.NewStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Fulfilled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_and_Commit_Transactions</targetReference>
            </connector>
            <label>Fullfillment status Update</label>
        </rules>
    </decisions>
    <description>This flow sends data to Avalara AvaTax whenever a fulfillment order&apos;s status is updated to fulfilled. Transactions are then created in Avalara to represent these fulfillments from a tax perspective.</description>
    <environments>Default</environments>
    <interviewLabel>Fulfillment Order - Send Details to AvaTax {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fulfillment Order - Send Details to AvaTax</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <sourceTemplate>avaoms__Fulfillment_Order_5_08</sourceTemplate>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Fullfilment_Order_Update</targetReference>
        </connector>
        <flowRunAsUser>TriggeringUser</flowRunAsUser>
        <object>FOStatusChangedEvent</object>
        <triggerType>PlatformEvent</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
