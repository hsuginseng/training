        <rules>
            <name>Simplified_Mandarin</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <aggregationOperator>Count</aggregationOperator>
                <conditionLogic>and</conditionLogic>
                <conditionType>Container</conditionType>
                <conditions>
                    <leftValueReference>Preferred_Language__c</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Chinese (Simplified)</stringValue>
                    </rightValue>
                </conditions>
                <leftValueReference>$Record.IndividualIdentityLink__dlm.ssot__Individual__dlm.ssot__Account__dlm</leftValueReference>
