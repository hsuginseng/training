<?xml version="1.0" encoding="UTF-8"?>
<ReportType xmlns="http://soap.sforce.com/2006/04/metadata">
    <baseObject>MarketSegment</baseObject>
    <category>data_cloud</category>
    <deployed>true</deployed>
