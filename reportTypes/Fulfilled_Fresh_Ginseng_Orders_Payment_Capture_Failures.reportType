        <join>
            <outerJoin>false</outerJoin>
            <relationship>FulfillmentOrderLineItems</relationship>
        </join>
        <outerJoin>false</outerJoin>
        <relationship>FulfillmentOrders</relationship>
    </join>
    <label>Fulfilled Fresh Ginseng Orders: Payment Capture Failures</label>
