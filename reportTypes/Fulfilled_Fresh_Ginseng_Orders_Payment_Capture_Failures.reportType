<?xml version="1.0" encoding="UTF-8"?>
<ReportType xmlns="http://soap.sforce.com/2006/04/metadata">
    <baseObject>OrderSummary</baseObject>
    <category>commerce</category>
    <deployed>true</deployed>
    <description>A report type for order summaries containing fresh ginseng and non-fresh product(s). These order summaries have multiple fulfillment orders, with at least one in a fulfilled status.</description>
