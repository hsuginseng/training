                          <td style="border-bottom:1px solid #000000; vertical-align:top; padding:0px 7px 0px 7px; border-top:1px solid #000000; border-right:1px solid #000000; border-left:1px solid #000000; width:623px"><p style="line-height:1.2; text-align:center"><span style="overflow:hidden"><span style="overflow-wrap:break-word"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">Case #: {{{Case.CaseNumber}}}</span></span></span></span></span></span></span></span></p><p style="line-height:1.2; text-align:center"><span style="overflow:hidden"><span style="overflow-wrap:break-word"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">Subject: {{{Case.Subject}}}</span></span></span></span></span></span></span></span></p><p style="line-height:1.2; text-align:center"><span style="overflow:hidden"><span style="overflow-wrap:break-word"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">Issue Description: {{{Case.Issue_Description__c}}}</span></span></span></span></span></span></span></span></p><p style="line-height:1.2; text-align:center"><span style="overflow:hidden"><span style="overflow-wrap:break-word"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">-----------------------------------------------------</span></span></span></span></span></span></span></span></p><p style="line-height:1.2"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Arial,sans-serif"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">{{{Case.First_Name__c}}}, 感謝您的詢問！</span></span></span></span></span></span><br /><br /><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Arial,sans-serif"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">我們的客服團隊正在處理您的問題，預計將於1–2 個工作日內回覆您，謝謝您的耐心等待。</span></span></span></span></span></span><br /><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Arial,sans-serif"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">若您的詢問較為緊急，歡迎於我們的客服時間內來電洽詢。</span></span></span></span></span></span></p><p style="line-height:1.2; text-align:center">&nbsp;</p> &nbsp; <p style="line-height:1.2; text-align:center"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Arial,sans-serif"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">此致,</span></span></span></span></span></span><br /><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Arial,sans-serif"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">許氏客服部</span></span></span></span></span></span></p></td>
