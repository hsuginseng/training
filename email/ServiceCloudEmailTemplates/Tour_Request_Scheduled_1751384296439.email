                    <tr>
                     <td style="font-family: Arial, Helvetica, sans-serif;"><p style="line-height:1.2; text-align:center"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">Case #: {{{Case.CaseNumber}}}</span></span></span></span></span></span></p><p style="line-height:1.2; text-align:center"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">-----------------------------------------------------</span></span></span></span></span></span></p><p style="line-height:1.2; text-align:center"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Dear {{{Case.First_Name__c}}},</span></span></span></span></span></span></p> &nbsp; <p style="line-height:1.2; text-align:center"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">Thank you for choosing to visit Hsu’s Ginseng Farm!</span></span></span></span></span></span></p><p style="line-height:1.2; text-align:center"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">We are pleased to confirm that your tour has been scheduled as follows:</span></span></span></span></span></span></p> &nbsp; <p style="line-height:1.2; text-align:center"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">• Phone Number: {{{Case.Phone_Number__c}}}</span></span></span></span></span></span></p><p style="line-height:1.2; text-align:center"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">• Scheduled Tour Date/Time: {{{Case.Scheduled_Tour_Date_Time__c}}}</span></span></span></span></span></span></p><p style="line-height:1.2; text-align:center"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">• Language: {{{Case.Preferred_Language__c}}}</span></span></span></span></span></span></p> &nbsp; <p style="line-height:1.2; text-align:center"><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">Tour Information:</span></span></span></span></span></span><br /><br /><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">• </span></span></span><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">Tour Guide:</span></span></span><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none"> {{{Case.Case_Owner_Name__c}}}</span></span></span></span></span></span><br /><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">• </span></span></span></span></span></span><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">Contact Number:</span></span></span><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none"> {{{Case.Tour_Guide_Phone__c}}}</span></span></span></span></span></span><br /><span style="font-size:12pt; font-variant:normal; white-space:pre-wrap"><span style="font-family:Aptos"><span style="color:#000000"><span style="font-weight:400"><span style="font-style:normal"><span style="text-decoration:none">• </span></span></span><span style="font-weight:700"><span style="font-style:normal"><span style="text-decoration:none">Location:</span></span></span></span></span></span>T6500 County Rd W, Wausau, WI 54403<br /><a href="https://www.google.com/maps/place/237895+County+Rd+W,+Wausau,+WI+54403/@45.0261194,-89.6193939,17z/data=!4m6!3m5!1s0x4d55336497c84c05:0x568cc817418300c3!8m2!3d45.0261194!4d-89.6193939!16s%2Fg%2F11h_k7t39c?entry=ttu&amp;g_ep=EgoyMDI1MDYzMC4wIKXMDSoASAFQAw%3D%3D">Google Maps</a></p></td>
