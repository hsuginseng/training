<?xml version="1.0" encoding="UTF-8"?>
<OrderManagementSettings xmlns="http://soap.sforce.com/2006/04/metadata">
    <deliveryEstimationEnabled>false</deliveryEstimationEnabled>
    <enableActivityFeedPerChangeOrder>false</enableActivityFeedPerChangeOrder>
    <enableB2CHighScaleOrders>true</enableB2CHighScaleOrders>
    <enableB2CIntegration>false</enableB2CIntegration>
    <enableBillingTypeOrdSummCreation>false</enableBillingTypeOrdSummCreation>
    <enableDuplicateManagement>false</enableDuplicateManagement>
    <enableHighScaleOrders>true</enableHighScaleOrders>
    <enableMRURecordCaching>false</enableMRURecordCaching>
    <enableNoAdjustmentConsideredForFeeTaxCalc>false</enableNoAdjustmentConsideredForFeeTaxCalc>
    <enableOMAutomation>false</enableOMAutomation>
    <enableOrderManagement>true</enableOrderManagement>
    <enablePersonAccountsForShoppers>false</enablePersonAccountsForShoppers>
    <initOMAutomation>false</initOMAutomation>
</OrderManagementSettings>
